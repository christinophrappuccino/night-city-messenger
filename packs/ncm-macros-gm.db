{"_id":"ncmGmSend0000000","name":"Send NPC Message","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-send-message.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nnew Dialog({ title: \"Send NPC Message\",\n  content: \"<div style=\\\"display:grid;gap:6px\\\">\"\n    + \"<label>From (actor name or id)<input name=\\\"from\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>To (actor name or id)<input name=\\\"to\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Subject<input name=\\\"subject\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Body<textarea name=\\\"body\\\" rows=\\\"5\\\"></textarea></label></div>\",\n  buttons: { send: { label: \"Send\", callback: async h => {\n    const r = (h[0] || h); const g = s => r.querySelector(\"[name=\\\"\" + s + \"\\\"]\").value.trim();\n    const res = await M.sendMessage({ fromActorId: g(\"from\"), toActorId: g(\"to\"), subject: g(\"subject\"), body: g(\"body\") });\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? \"Message sent.\" : ((res && res.error) || \"Send failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"send\" }).render(true);\n","folder":null,"sort":100,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmSend0000000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmSched000000","name":"Schedule Message","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-schedule-message.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nnew Dialog({ title: \"Schedule Message\",\n  content: \"<div style=\\\"display:grid;gap:6px\\\">\"\n    + \"<label>From (actor name or id)<input name=\\\"from\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>To (actor name or id)<input name=\\\"to\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Subject<input name=\\\"subject\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Body<textarea name=\\\"body\\\" rows=\\\"4\\\"></textarea></label>\"\n    + \"<label>Deliver at<input name=\\\"when\\\" type=\\\"datetime-local\\\"/></label></div>\",\n  buttons: { sched: { label: \"Schedule\", callback: async h => {\n    const r = (h[0] || h); const g = s => r.querySelector(\"[name=\\\"\" + s + \"\\\"]\").value.trim();\n    const w = g(\"when\"); if (!w) return ui.notifications.warn(\"Pick a delivery time.\");\n    const res = await M.scheduleMessage({ fromActorId: g(\"from\"), toActorId: g(\"to\"), subject: g(\"subject\"), body: g(\"body\") }, new Date(w).toISOString());\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? \"Message scheduled.\" : ((res && res.error) || \"Schedule failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"sched\" }).render(true);\n","folder":null,"sort":200,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmSched000000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmConv0000000","name":"Convert Selected Item To Shard","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-convert-shard.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _ds = game.nightcity.dataShardService;\nconst _ctrl = ((canvas.tokens && canvas.tokens.controlled) || []).flatMap(t => t.actor ? [...t.actor.items] : []);\nconst _all = [...game.items, ..._ctrl];\nconst pool = _all.filter(i => !(_ds && _ds.isDataShard && _ds.isDataShard(i)));\nif (!pool.length) return ui.notifications.warn(\"No convertible items. Select a token or add a world item.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(pool, \"Convert Item To Data Shard\");\nif (!_chosen) return;\nconst _r = await M.convertToDataShard(_chosen);\nui.notifications[_r && _r.success ? \"info\" : \"error\"](_r && _r.success ? (\"\\\"\" + _chosen.name + \"\\\" is now a data shard.\") : ((_r && _r.error) || \"Convert failed.\"));\n","folder":null,"sort":300,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmConv0000000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmDecrypt0000","name":"Force-Decrypt Selected Shard","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-force-decrypt.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _ds = game.nightcity.dataShardService;\nconst _ctrl = ((canvas.tokens && canvas.tokens.controlled) || []).flatMap(t => t.actor ? [...t.actor.items] : []);\nconst _all = [...game.items, ..._ctrl];\nconst pool = _all.filter(i => _ds && _ds.isDataShard && _ds.isDataShard(i));\nif (!pool.length) return ui.notifications.warn(\"No data shards found. Select the carrier token.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(pool, \"Force-Decrypt Shard\");\nif (!_chosen) return;\nconst _r = await M.forceDecryptShard(_chosen);\nif (_r && _r.success === false) ui.notifications.warn(_r.error || \"Action failed.\");\nelse ui.notifications.info(\"Done.\");\n","folder":null,"sort":400,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmDecrypt0000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmRelock00000","name":"Relock Selected Shard","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-relock-shard.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _ds = game.nightcity.dataShardService;\nconst _ctrl = ((canvas.tokens && canvas.tokens.controlled) || []).flatMap(t => t.actor ? [...t.actor.items] : []);\nconst _all = [...game.items, ..._ctrl];\nconst pool = _all.filter(i => _ds && _ds.isDataShard && _ds.isDataShard(i));\nif (!pool.length) return ui.notifications.warn(\"No data shards found. Select the carrier token.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(pool, \"Relock Shard\");\nif (!_chosen) return;\nconst _r = await M.relockShard(_chosen);\nif (_r && _r.success === false) ui.notifications.warn(_r.error || \"Action failed.\");\nelse ui.notifications.info(\"Done.\");\n","folder":null,"sort":500,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmRelock00000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmDmgShard000","name":"Damage Selected Shard","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-damage-shard.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _ds = game.nightcity.dataShardService;\nconst _ctrl = ((canvas.tokens && canvas.tokens.controlled) || []).flatMap(t => t.actor ? [...t.actor.items] : []);\nconst _all = [...game.items, ..._ctrl];\nconst pool = _all.filter(i => _ds && _ds.isDataShard && _ds.isDataShard(i) && _ds.checkIntegrity(i).enabled);\nif (!pool.length) return ui.notifications.warn(\"No shards with integrity switched on. Select the carrier token, or enable Integrity in Configure Shard.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(pool, \"Damage Shard\");\nif (!_chosen) return;\nconst _per = _ds.getIntegrityConfig(_chosen).degradePerFailure;\nnew Dialog({ title: \"Damage Shard\",\n  content: \"<div style=\\\"display:grid;gap:6px\\\"><label>Points <input name=\\\"amt\\\" type=\\\"number\\\" min=\\\"1\\\" value=\\\"\" + _per + \"\\\"/></label><label><input name=\\\"roll\\\" type=\\\"checkbox\\\" checked/> Roll data loss (like a failed breach)</label></div>\",\n  buttons: { hit: { label: \"Damage\", callback: async h => {\n    const r = (h[0] || h); const amt = parseInt(r.querySelector(\"[name=\\\"amt\\\"]\").value) || _per;\n    const res = await M.damageShard(_chosen, amt, { rollLoss: r.querySelector(\"[name=\\\"roll\\\"]\").checked });\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? (\"\\\"\" + _chosen.name + \"\\\" integrity now \" + res.newIntegrity + \".\") : ((res && res.error) || \"Failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"hit\" }).render(true);\n","folder":null,"sort":600,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmDmgShard000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmShardMsg000","name":"Add Message To Selected Shard","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-add-shard-message.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _ds = game.nightcity.dataShardService;\nconst _ctrl = ((canvas.tokens && canvas.tokens.controlled) || []).flatMap(t => t.actor ? [...t.actor.items] : []);\nconst _all = [...game.items, ..._ctrl];\nconst pool = _all.filter(i => _ds && _ds.isDataShard && _ds.isDataShard(i));\nif (!pool.length) return ui.notifications.warn(\"No data shards found. Select the carrier token.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(pool, \"Add Message To Shard\");\nif (!_chosen) return;\nnew Dialog({ title: \"Shard Message\",\n  content: \"<div style=\\\"display:grid;gap:6px\\\"><label>Subject<input name=\\\"subject\\\" type=\\\"text\\\"/></label><label>Body<textarea name=\\\"body\\\" rows=\\\"5\\\"></textarea></label></div>\",\n  buttons: { add: { label: \"Add\", callback: async h => {\n    const r = (h[0] || h); const g = s => r.querySelector(\"[name=\\\"\" + s + \"\\\"]\").value.trim();\n    const res = await M.addShardMessage(_chosen, { subject: g(\"subject\"), body: g(\"body\") });\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? \"Message added to shard.\" : ((res && res.error) || \"Failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"add\" }).render(true);\n","folder":null,"sort":700,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmShardMsg000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmPushCt00000","name":"Push Contact To Player","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-push-contact.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst cts = M.getMasterContacts() || [];\nif (!cts.length) return ui.notifications.warn(\"No master contacts defined.\");\nconst pcs = game.actors.filter(a => a.type === \"character\");\nif (!pcs.length) return ui.notifications.warn(\"No character actors found.\");\nconst cOpts = cts.map((c, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(c.name || c.handle || c.id) + \"</option>\").join(\"\");\nconst aOpts = pcs.map((a, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(a.name) + \"</option>\").join(\"\");\nnew Dialog({ title: \"Push Contact To Player\",\n  content: \"<div style=\\\"display:grid;gap:6px\\\"><label>Contact<select id=\\\"ncm-c\\\">\" + cOpts + \"</select></label><label>Player character<select id=\\\"ncm-a\\\">\" + aOpts + \"</select></label></div>\",\n  buttons: { push: { label: \"Push\", callback: async h => {\n    const r = (h[0] || h);\n    const c = cts[Number(r.querySelector(\"#ncm-c\").value)];\n    const a = pcs[Number(r.querySelector(\"#ncm-a\").value)];\n    const res = await M.pushContactToPlayer(c.id, a.id);\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? (\"Pushed to \" + a.name + \".\") : ((res && res.error) || \"Failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"push\" }).render(true);\n","folder":null,"sort":800,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmPushCt00000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmAddCt000000","name":"Add Master Contact","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-add-master-contact.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nnew Dialog({ title: \"Add Master Contact\",\n  content: \"<div style=\\\"display:grid;gap:6px\\\">\"\n    + \"<label>Name<input name=\\\"name\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Handle<input name=\\\"handle\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Role<input name=\\\"role\\\" type=\\\"text\\\"/></label>\"\n    + \"<label>Notes<textarea name=\\\"notes\\\" rows=\\\"3\\\"></textarea></label></div>\",\n  buttons: { add: { label: \"Add\", callback: async h => {\n    const r = (h[0] || h); const g = s => r.querySelector(\"[name=\\\"\" + s + \"\\\"]\").value.trim();\n    const res = await M.addMasterContact({ name: g(\"name\"), handle: g(\"handle\"), role: g(\"role\"), notes: g(\"notes\") });\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? \"Master contact added.\" : ((res && res.error) || \"Failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"add\" }).render(true);\n","folder":null,"sort":900,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmAddCt000000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmSetNet00000","name":"Set Active Network","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-set-network.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst nets = M.getAvailableNetworks() || [];\nif (!nets.length) return ui.notifications.warn(\"No networks available on this scene.\");\nconst opts = nets.map((n, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(n.name || n.id) + \"</option>\").join(\"\");\nnew Dialog({ title: \"Set Active Network\",\n  content: \"<label>Network<select id=\\\"ncm-n\\\" style=\\\"width:100%\\\">\" + opts + \"</select></label>\",\n  buttons: { set: { label: \"Set\", callback: async h => {\n    const r = (h[0] || h); const n = nets[Number(r.querySelector(\"#ncm-n\").value)];\n    const res = await M.setNetwork(n.id);\n    ui.notifications[res && res.success ? \"info\" : \"error\"](res && res.success ? (\"Active network: \" + (n.name || n.id)) : ((res && res.error) || \"Failed.\"));\n  } }, cancel: { label: \"Cancel\" } }, default: \"set\" }).render(true);\n","folder":null,"sort":1000,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmSetNet00000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmDeadZone000","name":"Toggle Dead Zone (This Scene)","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-toggle-deadzone.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst sid = canvas.scene && canvas.scene.id;\nif (!sid) return ui.notifications.warn(\"No active scene.\");\nnew Dialog({ title: \"Dead Zone — current scene\",\n  content: \"<p>Set the network dead zone for this scene.</p>\",\n  buttons: {\n    on: { label: \"Enable\", callback: async () => { const r = await M.toggleDeadZone(sid, true); ui.notifications[r && r.success ? \"info\" : \"error\"](r && r.success ? \"Dead zone ENABLED.\" : ((r && r.error) || \"Failed.\")); } },\n    off: { label: \"Disable\", callback: async () => { const r = await M.toggleDeadZone(sid, false); ui.notifications[r && r.success ? \"info\" : \"error\"](r && r.success ? \"Dead zone DISABLED.\" : ((r && r.error) || \"Failed.\")); } },\n    cancel: { label: \"Cancel\" }\n  }, default: \"cancel\" }).render(true);\n","folder":null,"sort":1100,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmDeadZone000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmAdmin000000","name":"Open Admin Panel","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-open-admin.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nM.openAdmin();\n","folder":null,"sort":1200,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmAdmin000000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmNetMgmt0000","name":"Open Network Management","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-open-network-mgmt.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nM.openNetworkManagement();\n","folder":null,"sort":1300,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmNetMgmt0000","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmGmGmContacts0","name":"Open GM Contacts","type":"script","img":"modules/night-city-messenger/assets/icons/macros/gm-open-gm-contacts.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nM.openGMContacts();\n","folder":null,"sort":1400,"ownership":{"default":0},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmGmGmContacts0","pack":"gm"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
