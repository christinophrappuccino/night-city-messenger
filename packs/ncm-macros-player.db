{"_id":"ncmPlrUnread0000","name":"Check Unread","type":"script","img":"modules/night-city-messenger/assets/icons/macros/player-check-unread.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _mine = game.user.character || game.actors.find(a => a.isOwner && a.type === \"character\");\nif (!_mine) return ui.notifications.warn(\"No character assigned to you.\");\nconst _n = await M.getUnreadCount(_mine.id);\nui.notifications.info(_n > 0 ? (_mine.name + \": \" + _n + \" unread message(s).\") : (_mine.name + \": inbox clear.\"));\n","folder":null,"sort":400,"ownership":{"default":2},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmPlrUnread0000","pack":"player"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmPlrHack000000","name":"Hack Selected Shard","type":"script","img":"modules/night-city-messenger/assets/icons/macros/player-hack-shard.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _tok = (canvas.tokens && canvas.tokens.controlled) || [];\nconst _mine = game.user.character || game.actors.find(a => a.isOwner && a.type === \"character\");\nconst _who = _tok.length === 1 ? _tok[0].actor : _mine;\nif (!_who) return ui.notifications.warn(\"Select exactly one token, or assign your character.\");\nconst _ds = game.nightcity.dataShardService;\nconst shards = _who.items.filter(i => _ds && _ds.isDataShard && _ds.isDataShard(i));\nif (!shards.length) return ui.notifications.warn(_who.name + \" is carrying no data shards.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(shards, \"Hack Data Shard\");\nif (!_chosen) return;\nconst _r = await M.hackShard(_chosen, _who);\nif (_r && _r.success === false) ui.notifications.warn(_r.error || \"Hack failed.\");\n","folder":null,"sort":500,"ownership":{"default":2},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmPlrHack000000","pack":"player"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
{"_id":"ncmPlrKey0000000","name":"Present Key Item","type":"script","img":"modules/night-city-messenger/assets/icons/macros/player-present-key.svg","scope":"global","command":"const M = game.nightcity && game.nightcity.messenger;\nif (!M) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\nconst _tok = (canvas.tokens && canvas.tokens.controlled) || [];\nconst _mine = game.user.character || game.actors.find(a => a.isOwner && a.type === \"character\");\nconst _who = _tok.length === 1 ? _tok[0].actor : _mine;\nif (!_who) return ui.notifications.warn(\"Select exactly one token, or assign your character.\");\nconst _ds = game.nightcity.dataShardService;\nconst shards = _who.items.filter(i => _ds && _ds.isDataShard && _ds.isDataShard(i));\nif (!shards.length) return ui.notifications.warn(_who.name + \" is carrying no data shards.\");\nconst _pick = async (list, title) => new Promise(res => {\n  if (!list.length) return res(null);\n  const opts = list.map((d, i) => \"<option value=\\\"\" + i + \"\\\">\" + foundry.utils.escapeHTML(d.name) + \"</option>\").join(\"\");\n  new Dialog({ title: title,\n    content: \"<p style=\\\"margin:4px 0\\\">Choose:</p><select id=\\\"ncm-pick\\\" style=\\\"width:100%\\\">\" + opts + \"</select>\",\n    buttons: {\n      ok: { label: \"OK\", callback: h => { const r = (h[0] || h); res(list[Number(r.querySelector(\"#ncm-pick\").value)]); } },\n      cancel: { label: \"Cancel\", callback: () => res(null) }\n    }, default: \"ok\", close: () => res(null) }).render(true);\n});\nconst _chosen = await _pick(shards, \"Present Key Item To Shard\");\nif (!_chosen) return;\nconst _r = await M.presentKeyItem(_chosen, _who);\nif (_r && _r.success === false) ui.notifications.warn(_r.error || \"No matching key item.\");\n","folder":null,"sort":600,"ownership":{"default":2},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmPlrKey0000000","pack":"player"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
