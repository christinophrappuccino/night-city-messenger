{"_id":"ncmPlrOpen000000","name":"Open My Messenger","type":"script","img":"modules/night-city-messenger/assets/icons/macros/player-open-messenger.svg","scope":"global","command":"if (!game.nightcity || !game.nightcity.openNCM) return ui.notifications.error(\"Night City Messenger isn't ready yet.\");\ngame.nightcity.openNCM();\n","folder":null,"sort":100,"ownership":{"default":2},"flags":{"night-city-messenger":{"managed":true,"sourceId":"ncmPlrOpen000000","pack":"player"}},"_stats":{"systemId":null,"systemVersion":null,"coreVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null}}
