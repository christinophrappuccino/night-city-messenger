{{!--
  Data Shard Composer — Sprint 4.6 Content Type System
  File: templates/item-inbox/data-shard-composer.hbs
  Module: cyberpunkred-messenger
  Mockup: ncm-shard-composer-config-v2.html (Composer view)

  Content type selector at top swaps form fields below.
  6 types: Message, Eddies, Dossier, Payload, AV Log, Location.
  Shared sections: Entry Identity, Per-Entry Encryption, Network Visibility.
--}}

{{#if hasItem}}
<div class="ncm-composer-shell">
<form class="ncm-shard-composer" autocomplete="off">

  {{!-- ═══ CONTENT TYPE SELECTOR ═══ --}}
  <fieldset class="ncm-config-section">
    <legend class="ncm-config-legend"><i class="fas fa-layer-group"></i> Content Type</legend>
    <div class="ncm-composer-type-pills">
      {{#each typePills}}
        <div class="ncm-composer-type-pill {{#if isActive}}ncm-composer-type-pill--active{{/if}}"
             data-action="selectContentType" data-type="{{key}}">
          <i class="{{icon}}"></i> {{label}}
        </div>
      {{/each}}
    </div>
    {{#if typeIntro}}
      <div class="ncm-composer-intro">
        <i class="fas fa-circle-info ncm-composer-intro__icon"></i>
        <div class="ncm-composer-intro__text">
          <div class="ncm-composer-intro__what">{{typeIntro.what}}</div>
          <div class="ncm-composer-intro__how"><b>How:</b> {{typeIntro.how}}</div>
        </div>
      </div>
    {{/if}}
  </fieldset>

  {{!-- ═══ ENTRY IDENTITY (icon + accent color) ═══ --}}
  <fieldset class="ncm-config-section">
    <legend class="ncm-config-legend"><i class="fas fa-paintbrush"></i> Entry Identity</legend>
    <div class="ncm-config-row ncm-config-row--col">
      <label class="ncm-config-label" style="margin-bottom:4px;">Icon</label>
      <div class="ncm-icon-grid" data-target="entryIcon">
        {{#each iconOptions}}
          <div class="ncm-icon-grid__item {{#if selected}}ncm-icon-grid__item--active{{/if}}"
               data-action="selectIcon" data-icon="{{value}}" data-target="entryIcon" title="{{label}}">
            <i class="{{value}}"></i>
          </div>
        {{/each}}
      </div>
      <input type="hidden" name="entryIcon" value="" />
    </div>
    <div class="ncm-config-row">
      <label class="ncm-config-label">Accent</label>
      <div class="ncm-composer-color-row">
        {{#each accentColors}}
          <div class="ncm-composer-color-dot {{#if isActive}}ncm-composer-color-dot--active{{/if}}"
               style="background:{{hex}};"
               data-action="selectAccent" data-accent="{{key}}"></div>
        {{/each}}
      </div>
    </div>
  </fieldset>

  {{!-- ═══════════════════════════════════════════
       TYPE-SPECIFIC FORM FIELDS
       ═══════════════════════════════════════════ --}}

  {{!-- ─── MESSAGE ─── --}}
  {{#if isMessage}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-envelope"></i> Message Content</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">From</label>
        <input type="text" name="from" class="ncm-config-input ncm-config-flex" value="{{editFrom}}" placeholder="sender@corp.net" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Subject</label>
        <input type="text" name="subject" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Message subject" />
      </div>
      <div class="ncm-config-row ncm-config-row--col">
        <label class="ncm-config-label" style="margin-bottom:4px;">Body</label>
        <textarea name="body" class="ncm-config-input ncm-config-textarea" rows="6" placeholder="Message content...">{{editBody}}</textarea>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── EDDIES ─── --}}
  {{#if isEddies}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-coins"></i> Eddies Dead Drop</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Amount (eb)</label>
        <input type="number" name="eddiesAmount" class="ncm-config-input ncm-config-flex" value="{{#if editContentData.amount}}{{editContentData.amount}}{{else}}1000{{/if}}" min="1" placeholder="Eddies amount" style="font-weight:700;" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Title</label>
        <input type="text" name="eddiesTitle" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Payment — Job Name" />
      </div>
      <div class="ncm-config-row ncm-config-row--col">
        <label class="ncm-config-label" style="margin-bottom:4px;">Note (optional)</label>
        <textarea name="eddiesNote" class="ncm-config-input ncm-config-textarea" rows="2" placeholder="Half now, half when it's done...">{{editContentData.note}}</textarea>
      </div>
      <div class="ncm-config-hint">Eddies are wired to the CPR wealth ledger when claimed by a player.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── DOSSIER ─── --}}
  {{#if isDossier}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-user-secret"></i> Dossier Subject</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Target Name</label>
        <input type="text" name="dossierTargetName" class="ncm-config-input ncm-config-flex" value="{{editContentData.targetName}}" placeholder="Full name" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Alias</label>
        <input type="text" name="dossierAlias" class="ncm-config-input ncm-config-flex" value="{{editContentData.targetAlias}}" placeholder="Known alias" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Classification</label>
        <select name="dossierClassification" class="ncm-config-select ncm-config-flex" data-edit-select="dossierClassification">
          <option value="">Unclassified</option>
          <option value="CONFIDENTIAL">Confidential</option>
          <option value="SECRET">Secret</option>
          <option value="TOP SECRET">Top Secret</option>
        </select>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Link Actor</label>
        <select name="dossierLinkedActor" class="ncm-config-select ncm-config-flex" data-edit-select="dossierLinkedActor">
          <option value="">— None (manual data) —</option>
          {{#each actorOptions}}
            <option value="{{id}}">{{name}}</option>
          {{/each}}
        </select>
      </div>
      <div class="ncm-config-hint">Linking an actor auto-pulls their portrait. Leave unlinked for a silhouette.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Portrait</label>
        <input type="text" name="dossierPortrait" class="ncm-config-input ncm-config-flex" value="{{editContentData.targetImage}}" placeholder="Path to custom portrait (overrides actor)" />
        <button type="button" data-action="browseImage" data-target="dossierPortrait" class="ncm-shard-hdr-btn" title="Browse"><i class="fas fa-folder-open"></i></button>
      </div>
    </fieldset>

    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-chart-bar"></i> Stat Block</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Threat</label>
        <select name="dossierThreat" class="ncm-config-select ncm-config-flex" data-edit-select="dossierThreat">
          <option value="">Unknown</option>
          <option value="LOW">Low</option>
          <option value="MEDIUM">Medium</option>
          <option value="HIGH">High</option>
          <option value="EXTREME">Extreme</option>
        </select>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Affiliation</label>
        <input type="text" name="dossierAffiliation" class="ncm-config-input ncm-config-flex" value="{{editContentData.stats.affiliation}}" placeholder="Organization" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Last Known</label>
        <input type="text" name="dossierLastKnown" class="ncm-config-input ncm-config-flex" value="{{editContentData.stats.lastKnownLocation}}" placeholder="Location" />
      </div>
    </fieldset>

    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-file-lines"></i> Sections</legend>
      <div class="ncm-dossier-sections-list">
        {{#if hasDossierSections}}
          {{#each editDossierSections}}
            <div class="ncm-dossier-section-entry">
              <div class="ncm-config-row">
                <label class="ncm-config-label">Heading</label>
                <input type="text" name="dossierSectionHeading-{{index}}" class="ncm-config-input ncm-config-flex" value="{{heading}}" placeholder="Section heading" />
              </div>
              <div class="ncm-config-row ncm-config-row--col">
                <textarea name="dossierSectionBody-{{index}}" class="ncm-config-input ncm-config-textarea" rows="3" placeholder="Section content...">{{body}}</textarea>
              </div>
              <div class="ncm-config-row">
                <label class="ncm-config-check"><input type="checkbox" name="dossierSectionRedacted-{{index}}" {{#if redacted}}checked{{/if}} /> Redacted</label>
                <button type="button" data-action="removeDossierSection" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--danger" title="Remove section"><i class="fas fa-times"></i></button>
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="ncm-dossier-section-entry">
            <div class="ncm-config-row">
              <label class="ncm-config-label">Heading</label>
              <input type="text" name="dossierSectionHeading-0" class="ncm-config-input ncm-config-flex" placeholder="Section heading" />
            </div>
            <div class="ncm-config-row ncm-config-row--col">
              <textarea name="dossierSectionBody-0" class="ncm-config-input ncm-config-textarea" rows="3" placeholder="Section content..."></textarea>
            </div>
            <div class="ncm-config-row">
              <label class="ncm-config-check"><input type="checkbox" name="dossierSectionRedacted-0" /> Redacted</label>
              <button type="button" data-action="removeDossierSection" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--danger" title="Remove"><i class="fas fa-times"></i></button>
            </div>
          </div>
        {{/if}}
      </div>
      <button type="button" data-action="addDossierSection" class="ncm-shard-btn ncm-shard-btn--secondary" style="margin-top:4px;padding:3px 10px;">
        <i class="fas fa-plus"></i> Add Section
      </button>
      <div class="ncm-config-row" style="margin-top:8px;">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── PAYLOAD ─── --}}
  {{#if isPayload}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-bug"></i> Payload Configuration</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Payload Type</label>
        <select name="payloadType" class="ncm-config-select ncm-config-flex" data-edit-select="payloadType">
          <option value="tracker">Tracker</option>
          <option value="malware">Malware</option>
          <option value="worm">Worm</option>
          <option value="beneficial">Beneficial Program</option>
          <option value="custom">Custom</option>
        </select>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Program Name</label>
        <input type="text" name="payloadName" class="ncm-config-input ncm-config-flex" value="{{editContentData.name}}" placeholder="GHOST.exe" />
      </div>
      <div class="ncm-config-row ncm-config-row--col">
        <label class="ncm-config-label" style="margin-bottom:4px;">Description</label>
        <textarea name="payloadDescription" class="ncm-config-input ncm-config-textarea" rows="3" placeholder="What this program does when executed...">{{editContentData.description}}</textarea>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Effect Type</label>
        <select name="payloadEffectType" class="ncm-config-select ncm-config-flex" data-edit-select="payloadEffectType">
          <option value="tracker">Tracker — reports location</option>
          <option value="damage">Damage — deals HP damage</option>
          <option value="lockout">Lockout — locks agent</option>
          <option value="message">Message — sends auto message</option>
          <option value="custom">Custom (flavor only)</option>
        </select>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Duration (hrs)</label>
        <input type="number" name="payloadDuration" class="ncm-config-input ncm-config-short" value="{{#if editPayloadDurationHrs}}{{editPayloadDurationHrs}}{{else}}24{{/if}}" min="1" />
      </div>
      <div class="ncm-config-hint">When executed, the effect triggers. Actual mechanical effects are GM-adjudicated.</div>
    </fieldset>

    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-mask"></i> Disguise</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-check"><input type="checkbox" name="payloadDisguised" {{#if editContentData.disguised}}checked{{/if}} /> Disguise as different content type</label>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Appears As</label>
        <select name="payloadDisguiseType" class="ncm-config-select ncm-config-flex" data-edit-select="payloadDisguiseType">
          <option value="message">Message</option>
          <option value="eddies">Eddies Dead Drop</option>
          <option value="dossier">Dossier</option>
        </select>
      </div>
      <div class="ncm-config-hint">When disguised, the entry renders as the fake type until the player interacts.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── AV LOG ─── --}}
  {{#if isAvlog}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-microphone"></i> Recording Details</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Media Type</label>
        <select name="avlogMediaType" class="ncm-config-select ncm-config-flex" data-edit-select="avlogMediaType">
          <option value="audio">Audio</option>
          <option value="video">Video</option>
        </select>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Title</label>
        <input type="text" name="avlogTitle" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Recording title" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Duration</label>
        <input type="text" name="avlogDuration" class="ncm-config-input ncm-config-short" value="{{editContentData.duration}}" placeholder="03:47" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Source</label>
        <input type="text" name="avlogSource" class="ncm-config-input ncm-config-flex" value="{{editContentData.source}}" placeholder="Where/how recorded" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Media File</label>
        <input type="text" name="avlogMediaUrl" class="ncm-config-input ncm-config-flex" value="{{editContentData.mediaUrl}}" placeholder="File, direct .mp4/.mp3 URL, or YouTube/Vimeo link" />
        <button type="button" data-action="browseMedia" data-target="avlogMediaUrl" class="ncm-shard-hdr-btn" title="Browse files"><i class="fas fa-folder-open"></i></button>
      </div>
      <div class="ncm-config-hint">Plays in the viewer. Leave blank for a transcript-only log.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>

    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-closed-captioning"></i> Transcript</legend>
      <div class="ncm-transcript-list">
        {{#if hasTranscriptLines}}
          {{#each editTranscriptLines}}
            <div class="ncm-transcript-entry">
              <input type="text" name="transcriptSpeaker-{{index}}" class="ncm-config-input" style="max-width:100px;" value="{{speaker}}" placeholder="SPEAKER" />
              <input type="text" name="transcriptText-{{index}}" class="ncm-config-input ncm-config-flex" value="{{text}}" placeholder="Dialogue line..." />
              <button type="button" data-action="removeTranscriptLine" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--danger" title="Remove"><i class="fas fa-times"></i></button>
            </div>
          {{/each}}
        {{else}}
          <div class="ncm-transcript-entry">
            <input type="text" name="transcriptSpeaker-0" class="ncm-config-input" style="max-width:100px;" placeholder="SPEAKER" />
            <input type="text" name="transcriptText-0" class="ncm-config-input ncm-config-flex" placeholder="Dialogue line..." />
            <button type="button" data-action="removeTranscriptLine" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--danger" title="Remove"><i class="fas fa-times"></i></button>
          </div>
        {{/if}}
      </div>
      <button type="button" data-action="addTranscriptLine" class="ncm-shard-btn ncm-shard-btn--secondary" style="margin-top:4px;padding:3px 10px;">
        <i class="fas fa-plus"></i> Add Line
      </button>
    </fieldset>
  {{/if}}

  {{!-- ─── LOCATION ─── --}}
  {{#if isLocation}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-map-pin"></i> Location Details</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Location Name</label>
        <input type="text" name="locationName" class="ncm-config-input ncm-config-flex" value="{{editContentData.locationName}}" placeholder="Kabuki Market, Back Alley" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Image</label>
        <input type="text" name="locationImage" class="ncm-config-input ncm-config-flex" value="{{editContentData.locationImage}}" placeholder="Path to location image (optional)" />
        <button type="button" data-action="browseImage" data-target="locationImage" class="ncm-shard-hdr-btn" title="Browse"><i class="fas fa-folder-open"></i></button>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Coordinates</label>
        <input type="text" name="locationCoords" class="ncm-config-input ncm-config-flex" value="{{editContentData.coordinates}}" placeholder="N 33.7490° W 84.3880° (flavor text)" />
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">District</label>
        <input type="text" name="locationDistrict" class="ncm-config-input ncm-config-flex" value="{{editContentData.district}}" placeholder="Watson, Westbrook, etc." />
      </div>
      <div class="ncm-config-row ncm-config-row--col">
        <label class="ncm-config-label" style="margin-bottom:4px;">Description</label>
        <textarea name="locationDescription" class="ncm-config-input ncm-config-textarea" rows="3" placeholder="South entrance. Look for the red neon dragon sign.">{{editContentData.description}}</textarea>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Link Scene</label>
        <input type="text" name="locationSceneId" class="ncm-config-input ncm-config-flex" value="{{editContentData.linkedSceneId}}" placeholder="Foundry Scene ID (optional)" />
      </div>
      <div class="ncm-config-hint">If a scene is linked, GM sees a "Go to Scene" button in the viewer.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{#if isBanking}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-building-columns"></i> Bank (lore)</legend>
      <div class="ncm-config-row"><label class="ncm-config-label">Bank Name</label><input type="text" name="bankName" class="ncm-config-input ncm-config-flex" value="{{bank.bankName}}" placeholder="Night City Trust" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Logo</label><input type="text" name="bankLogo" class="ncm-config-input ncm-config-flex" value="{{bank.bankLogo}}" placeholder="Path to logo image (optional)" /><button type="button" data-action="browseImage" data-target="bankLogo" class="ncm-shard-hdr-btn" title="Browse"><i class="fas fa-folder-open"></i></button></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Location</label><input type="text" name="bankLocation" class="ncm-config-input ncm-config-flex" value="{{bank.bankLocation}}" placeholder="City Center · Corpo Plaza" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Code</label><input type="text" name="bankCode" class="ncm-config-input ncm-config-flex" value="{{bank.bankCode}}" placeholder="SWIFT / routing (optional)" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Tagline</label><input type="text" name="bankTagline" class="ncm-config-input ncm-config-flex" value="{{bank.bankTagline}}" placeholder="Your eddies. Our silence." /></div>
    </fieldset>
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-id-card"></i> Account</legend>
      <div class="ncm-config-row"><label class="ncm-config-label">Owner</label><input type="text" name="bankOwner" class="ncm-config-input ncm-config-flex" value="{{bank.owner}}" placeholder="V. Arasaka" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Account</label><input type="text" name="bankAccountName" class="ncm-config-input ncm-config-flex" value="{{bank.accountName}}" placeholder="Arasaka Holdings — Ops" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Number</label><input type="text" name="bankAccountNumber" class="ncm-config-input ncm-config-flex" value="{{bank.accountNumber}}" placeholder="NC-8841-A-0007" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Type</label><input type="text" name="bankAccountType" class="ncm-config-input" value="{{bank.accountType}}" placeholder="checking" style="max-width:130px" /><label class="ncm-config-label" style="margin-left:8px;width:auto;">Currency</label><input type="text" name="bankCurrency" class="ncm-config-input" list="ncm-cur-list" value="{{bank.currency}}" style="max-width:80px" /><datalist id="ncm-cur-list"><option value="€$"></option><option value="$"></option><option value="¥"></option><option value="£"></option><option value="€"></option><option value="₿"></option><option value="credits"></option></datalist></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Balance</label><input type="number" name="bankBalance" class="ncm-config-input" value="{{bank.balance}}" style="max-width:120px" /><label class="ncm-config-label" style="margin-left:8px;width:auto;">Cleared</label><input type="number" name="bankCleared" class="ncm-config-input" value="{{bank.cleared}}" style="max-width:110px" /><label class="ncm-config-label" style="margin-left:8px;width:auto;">Held</label><input type="number" name="bankHeld" class="ncm-config-input" value="{{bank.held}}" style="max-width:100px" /></div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-list"></i> Transactions</legend>
      <div class="ncm-cl-list" data-list="bankTxns"></div>
      <button type="button" data-action="addListRow" data-list="bankTxns" class="ncm-cl-add"><i class="fas fa-plus"></i> Add transaction</button>
      <div class="ncm-config-hint">Newest first. Category sets the colored icon (transfer / services / wire / payroll / flagged / deposit…). Running balance auto-computes.</div>
    </fieldset>
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-hand-holding-dollar"></i> Siphon</legend>
      <div class="ncm-config-row"><label class="ncm-config-check"><input type="checkbox" name="bankAllowSiphon" {{#if bank.allowSiphon}}checked{{/if}} /> Allow players to siphon funds</label></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Skill</label><input type="text" name="bankSiphonSkill" class="ncm-config-input" value="{{bank.siphonSkill}}" placeholder="Interface" style="max-width:150px" /><label class="ncm-config-label" style="margin-left:8px;width:auto;">DV</label><input type="number" name="bankSiphonDV" class="ncm-config-input ncm-config-short" value="{{bank.siphonDV}}" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Amount</label><select name="bankSiphonMode" class="ncm-config-input ncm-config-select" data-edit-select="bankSiphonMode" style="max-width:130px"><option value="cap">cap</option><option value="full">full balance</option><option value="percent">percent</option></select><label class="ncm-config-label" style="margin-left:8px;width:auto;">Cap</label><input type="number" name="bankSiphonCap" class="ncm-config-input" value="{{bank.siphonCap}}" style="max-width:100px" /><label class="ncm-config-label" style="margin-left:8px;width:auto;">%</label><input type="number" name="bankSiphonPercent" class="ncm-config-input ncm-config-short" value="{{bank.siphonPercent}}" /></div>
      <div class="ncm-config-hint">On a failed roll: trace + GM alert. cap = take up to Cap · percent = up to % of balance · full = whole balance.</div>
    </fieldset>
  {{/if}}

  {{!-- ─── CALENDAR ─── --}}
  {{#if isCalendar}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-calendar-days"></i> Schedule</legend>
      <div class="ncm-config-row"><label class="ncm-config-label">Title</label><input type="text" name="calTitle" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Ops Schedule — June" /></div>
      <div class="ncm-cl-list" data-list="calEvents"></div>
      <button type="button" data-action="addListRow" data-list="calEvents" class="ncm-cl-add"><i class="fas fa-plus"></i> Add event</button>
      <div class="ncm-config-hint">Line 1: date · title · time. Line 2: place · people · category. Events sharing a category share a legend color — colors assign themselves at save.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── SYSTEM LOG ─── --}}
  {{#if isSyslog}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-terminal"></i> Console</legend>
      <div class="ncm-config-row"><label class="ncm-config-label">Title</label><input type="text" name="syslogTitle" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Blank = auto from host" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Host</label><input type="text" name="syslogHost" class="ncm-config-input" value="{{syslog.host}}" placeholder="arasaka-db-04" style="max-width:170px" /><label class="ncm-config-label" style="margin-left:8px;width:auto;">Path</label><input type="text" name="syslogPath" class="ncm-config-input ncm-config-flex" value="{{syslog.path}}" placeholder="/var/log/access.log" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">Prompt</label><input type="text" name="syslogPrompt" class="ncm-config-input ncm-config-flex" value="{{syslog.prompt}}" placeholder="Blank = auto (root@host:~#)" /></div>
      <div class="ncm-config-row">
        <label class="ncm-config-check"><input type="checkbox" name="syslogShowLineNumbers" {{#if syslog.showLineNumbers}}checked{{/if}} /> Line numbers</label>
        <label class="ncm-config-check"><input type="checkbox" name="syslogShowFilter" {{#if syslog.showFilter}}checked{{/if}} /> Filter bar</label>
        <label class="ncm-config-check"><input type="checkbox" name="syslogScanlines" {{#if syslog.scanlines}}checked{{/if}} /> Scanlines</label>
        <label class="ncm-config-check"><input type="checkbox" name="syslogShowPrompt" {{#if syslog.showPrompt}}checked{{/if}} /> Prompt line</label>
      </div>
    </fieldset>
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-list"></i> Log Lines</legend>
      <div class="ncm-cl-list" data-list="syslogLines"></div>
      <button type="button" data-action="addListRow" data-list="syslogLines" class="ncm-cl-add"><i class="fas fa-plus"></i> Add line</button>
      <div class="ncm-config-hint">Severity colors the line (info / ok / warn / err / debug). Tick “mark” to spotlight the key line in a callout.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── CREDENTIALS ─── --}}
  {{#if isCredentials}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-key"></i> Credential Vault</legend>
      <div class="ncm-config-row"><label class="ncm-config-label">Title</label><input type="text" name="credTitle" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Harvested logins — Biotechnica" /></div>
      <div class="ncm-config-row"><label class="ncm-config-check"><input type="checkbox" name="credAutoReuse" {{#if creds.autoReuse}}checked{{/if}} /> Auto-flag reused passwords</label></div>
      <div class="ncm-cl-list" data-list="credEntries"></div>
      <button type="button" data-action="addListRow" data-list="credEntries" class="ncm-cl-add"><i class="fas fa-plus"></i> Add credential</button>
      <div class="ncm-config-hint">Line 1: host · username · password. Line 2: note · strength (1–4 draws the meter) · locked (masked until cracked in the viewer). The same password on two hosts auto-flags REUSED — the pivot signal.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ─── SPREADSHEET (grid editor: click a cell, format it) ─── --}}
  {{#if isSpreadsheet}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-table-cells"></i> Spreadsheet</legend>
      <div class="ncm-config-row"><label class="ncm-config-label">Title</label><input type="text" name="ssTitle" class="ncm-config-input ncm-config-flex" value="{{editSubject}}" placeholder="Q3 Off-Book Disbursements" /></div>
      <div class="ncm-config-row"><label class="ncm-config-label">File name</label><input type="text" name="ssFormat" class="ncm-config-input ncm-config-flex" value="{{ss.format}}" placeholder="disbursements.csv (shown in the toolbar)" /></div>

      <div class="ncm-config-row" style="gap:10px;">
        <button type="button" data-action="ssImportCsv" class="ncm-shard-btn ncm-shard-btn--secondary" style="padding:3px 10px;"><i class="fas fa-file-import"></i> Import CSV</button>
        <label class="ncm-config-check"><input type="checkbox" name="ssCsvHeader" checked /> first row = column labels</label>
      </div>
      <div class="ncm-config-hint">Loads a .csv / .tsv (delimiter auto-detected) into the grid, replacing what's there. Column types are auto-guessed (number / currency / status) — adjust them in the headers, then format cells as usual.</div>

      <div class="ncm-ss-toolbar">
        <button type="button" data-action="ssFormat" data-fmt="bold" class="ncm-ss-tb" data-tooltip="Bold"><i class="fas fa-bold"></i></button>
        <span class="ncm-ss-tsep"></span>
        <span class="ncm-ss-tlbl">text</span>
        <span class="ncm-ss-dots">
          {{#each ssColors}}<button type="button" data-action="ssColor" data-kind="color" data-c="{{this}}" class="ncm-ss-dot ncm-ct-c--{{this}}" data-tooltip="{{this}}"><i class="fas fa-font"></i></button>{{/each}}
          <button type="button" data-action="ssColor" data-kind="color" data-c="" class="ncm-ss-dot" data-tooltip="no color"><i class="fas fa-ban"></i></button>
        </span>
        <span class="ncm-ss-tsep"></span>
        <span class="ncm-ss-tlbl">fill</span>
        <span class="ncm-ss-dots">
          {{#each ssColors}}<button type="button" data-action="ssColor" data-kind="bg" data-c="{{this}}" class="ncm-ss-dot ncm-ct-bg--{{this}}" data-tooltip="{{this}}"></button>{{/each}}
          <button type="button" data-action="ssColor" data-kind="bg" data-c="" class="ncm-ss-dot" data-tooltip="no fill"><i class="fas fa-ban"></i></button>
        </span>
        <span class="ncm-ss-tsep"></span>
        <button type="button" data-action="ssFormat" data-fmt="flag" class="ncm-ss-tb" data-tooltip="Flag cell (⚠)"><i class="fas fa-flag"></i></button>
        <input type="text" class="ncm-ss-reason ncm-config-input" placeholder="flag reason (tooltip on the cell)" />
        <button type="button" data-action="ssFormat" data-fmt="redact" class="ncm-ss-tb" data-tooltip="Redact cell (blacked out)"><i class="fas fa-eye-slash"></i></button>
        <button type="button" data-action="ssFormat" data-fmt="clear" class="ncm-ss-tb" data-tooltip="Clear formatting"><i class="fas fa-eraser"></i></button>
      </div>

      <div class="ncm-ss-gridwrap" data-ss></div>
      <button type="button" data-action="ssAddRow" class="ncm-cl-add"><i class="fas fa-plus"></i> Add row</button>

      <div class="ncm-config-row" style="margin-top:6px;">
        <label class="ncm-config-check"><input type="checkbox" name="ssTotals" {{#if ss.totals}}checked{{/if}} /> Σ total the number/currency columns</label>
      </div>
      <div class="ncm-config-row"><label class="ncm-config-label">Note</label><input type="text" name="ssNote" class="ncm-config-input ncm-config-flex" value="{{ss.note}}" placeholder="Footnote under the table (optional)" /></div>
      <div class="ncm-config-hint">Click a cell, then use the toolbar: bold · text color · fill · flag (amber ⚠, with tooltip reason) · redact (blacked out). Column type drives alignment — number/currency right-align and can Σ total; status renders value pills (CLEARED / HELD / DENIED…). The viewer’s cell-reference bar spotlights the first flagged cell.</div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">Timestamp</label>
        <div class="ncm-ctp-trigger" data-action="openTimePicker" data-target="timestamp">
          <i class="fas fa-clock ncm-ctp-trigger__icon"></i>
          <span class="ncm-ctp-trigger__value">{{#if editTimestampFormatted}}{{editTimestampFormatted}}{{else}}{{defaultTimestampFormatted}}{{/if}}</span>
          <i class="fas fa-chevron-down ncm-ctp-trigger__chevron"></i>
        </div>
        <input type="hidden" name="timestamp" value="{{#if editTimestamp}}{{editTimestamp}}{{else}}{{defaultTimestamp}}{{/if}}" />
      </div>
    </fieldset>
  {{/if}}

  {{!-- ═══ PER-ENTRY ENCRYPTION ═══ --}}
  {{#if isPerMessageEncryption}}
    <fieldset class="ncm-config-section">
      <legend class="ncm-config-legend"><i class="fas fa-lock"></i> Per-Entry Encryption</legend>
      <div class="ncm-config-row">
        <label class="ncm-config-check"><input type="checkbox" name="encrypted" {{#if editEncrypted}}checked{{/if}} /> Individually Encrypted</label>
      </div>
      <div class="ncm-config-row">
        <label class="ncm-config-label">DV Override</label>
        <input type="number" name="encryptionDC" class="ncm-config-input ncm-config-short" value="{{defaultDC}}" min="1" max="30" />
      </div>
      <div class="ncm-config-hint">Only applies when shard encryption mode is set to "Per-entry"</div>
    </fieldset>
  {{/if}}

  {{!-- ═══ NETWORK VISIBILITY (shard-only — terminal messages live behind the account login) ═══ --}}
  {{#unless isTerminalTarget}}
  <fieldset class="ncm-config-section">
    <legend class="ncm-config-legend"><i class="fas fa-eye-slash"></i> Network Visibility</legend>
    <div class="ncm-config-row">
      <label class="ncm-config-check"><input type="checkbox" name="networkRestricted" {{#if editNetworkRestricted}}checked{{/if}} /> Restrict to specific networks</label>
    </div>
    <div class="ncm-config-row ncm-config-row--col">
      <div class="ncm-tag-list" id="ncm-entry-network-tags"></div>
      <div class="ncm-config-row" style="margin-top:4px;">
        <select class="ncm-config-select ncm-config-flex" id="ncm-add-entry-network-select">
          <option value="">— Add Network —</option>
          {{#each networkOptions}}
            <option value="{{value}}">{{label}}</option>
          {{/each}}
        </select>
        <button type="button" data-action="addEntryNetworkTag" class="ncm-shard-hdr-btn" title="Add network"><i class="fas fa-plus"></i></button>
      </div>
    </div>
    <div class="ncm-config-hint">When restricted, this entry only appears on selected networks.</div>
  </fieldset>
  {{/unless}}

  {{!-- ═══ ACTIONS ═══ --}}
  <div class="ncm-config-actions">
    <button type="button" data-action="cancel" class="ncm-shard-btn ncm-shard-btn--secondary"><i class="fas fa-times"></i> Cancel</button>
    {{#if isEditing}}
      <button type="button" data-action="saveEntry" class="ncm-shard-btn ncm-shard-btn--primary"><i class="fas fa-save"></i> Update Entry</button>
    {{else}}
      <button type="button" data-action="saveEntry" class="ncm-shard-btn ncm-shard-btn--primary"><i class="fas fa-plus"></i> Add Entry</button>
    {{/if}}
  </div>
</form>
  <aside class="ncm-composer-preview">
    <div class="ncm-composer-preview-label"><i class="fas fa-eye"></i> Live preview</div>
    <div class="ncm-composer-preview-body"></div>
  </aside>
</div>
{{else}}
  <p style="padding:20px;text-align:center;color:var(--ncm-text-muted);">No shard selected.</p>
{{/if}}
