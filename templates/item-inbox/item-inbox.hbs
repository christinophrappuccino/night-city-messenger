{{!--
  Item Inbox / Data Shard Viewer — Sprint 4.6 Redesign
  File: templates/item-inbox/item-inbox.hbs
  Module: night-city-messenger
  Mockup: ncm-shard-viewer-mockup-v2.html

  Chip-reader aesthetic. NOT a mail client.
  Structure: Identity Header → Integrity Bar → Signal Row → Index Strip → Content/Overlay → Footer
--}}

<div class="ncm-item-inbox ncm-shard-preset-{{presetKey}}" data-item-id="{{item.id}}"{{#if igOn}} data-integrity-tier="{{integrityTier}}" data-integrity-legibility="{{igLegibility}}" data-ig-scan="{{igScan}}" data-ig-tear="{{igTear}}" data-ig-steady="{{igSteady}}"{{/if}} style="{{#if presetAccent}}--shard-accent: {{presetAccent}};{{/if}}--ncm-shard-text-scale: {{shardTextScale}};">

  {{!-- ═══ BOOT SEQUENCE CONTAINER (filled by JS, hidden after boot completes) ═══ --}}
  {{#if showBoot}}
    <div class="ncm-shard-boot" data-boot-style="{{bootAnimationStyle}}" data-boot-speed="{{bootSpeed}}">
      {{!-- Boot content injected by _playBootSequence() in ItemInboxApp.js --}}
    </div>
  {{/if}}

  {{!-- ═══ SHARD IDENTITY HEADER ═══ --}}
  <div class="ncm-shard-identity">
    <div class="ncm-shard-icon-block ncm-ice-{{iceClass}}">
      {{#if bootIconIsImage}}
        <img src="{{bootImageUrl}}" alt="" class="ncm-shard-icon-img" style="width:{{bootImageSize}}px;height:{{bootImageSize}}px;">
      {{else}}
        <i class="{{presetFaIcon}}"></i>
      {{/if}}
    </div>
    <div class="ncm-shard-meta">
      <div class="ncm-shard-name">{{shardDisplayName}}</div>
      <div class="ncm-shard-type-line">
        {{#if typeLineIsCustom}}
          {{typeLineCustomText}}
        {{else if typeLineIsStatusOnly}}
          {{#if isDecrypted}}DECRYPTED{{else if isEncrypted}}{{encryptionType}}{{else}}OPEN{{/if}}
          {{#if isTethered}}<span class="ncm-shard-sep">·</span>TETHERED{{/if}}
        {{else}}
          {{presetLabel}}
          {{#if isDecrypted}}
            <span class="ncm-shard-sep">·</span>DECRYPTED
          {{else if isEncrypted}}
            <span class="ncm-shard-sep">·</span>{{encryptionType}}
          {{/if}}
          {{#if isTethered}}
            <span class="ncm-shard-sep">·</span>TETHERED
          {{/if}}
        {{/if}}
      </div>
      {{#if hasMetadata}}
        <div class="ncm-shard-provenance">
          {{#if metadataTimestamp}}Created: {{metadataTimestamp}}{{/if}}
          {{#if metadataLocation}} // {{metadataLocation}}{{/if}}
          {{#if metadataNetwork}} // {{metadataNetwork}}{{/if}}
        </div>
      {{/if}}
      <div class="ncm-shard-badges">
        {{#if isDecrypted}}
          <span class="ncm-shard-badge ncm-shard-badge--decrypted"><i class="fas fa-unlock"></i> Decrypted</span>
        {{else if isEncrypted}}
          <span class="ncm-shard-badge ncm-shard-badge--ice"><i class="fas fa-shield-halved"></i> {{encryptionType}}</span>
        {{/if}}
        {{#if networkRequired}}
          <span class="ncm-shard-badge ncm-shard-badge--net"><i class="fas fa-network-wired"></i> {{networkDisplayName}}</span>
        {{/if}}
        {{#if isBlocked}}
          <span class="ncm-shard-badge ncm-shard-badge--lock"><i class="fas fa-lock"></i> Encrypted</span>
        {{/if}}
        <span class="ncm-shard-badge ncm-shard-badge--entries">
          <i class="fas fa-layer-group"></i>
          {{#if hasHiddenEntries}}{{visibleCount}} of {{totalEntryCount}} visible{{else}}{{totalEntryCount}} {{#if singleEntry}}Entry{{else}}Entries{{/if}}{{/if}}
        </span>
        {{#if isTethered}}
          <span class="ncm-shard-badge ncm-shard-badge--tethered"><i class="fas fa-link"></i> Tethered</span>
        {{/if}}
        {{#if metadataClassification}}
          <span class="ncm-shard-badge ncm-shard-badge--classification">{{metadataClassification}}</span>
        {{/if}}
      </div>
    </div>
    {{#if isGM}}
      <div class="ncm-shard-gm-header-actions">
        <button type="button" data-action="toggleChipInfo" title="Chip Specs" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--chip {{#if chipDrawerOpen}}ncm-shard-hdr-btn--active{{/if}}"><i class="fas fa-microchip"></i></button>
        <button type="button" data-action="openDeck" title="Program Deck" class="ncm-shard-hdr-btn"><i class="fas fa-layer-group"></i></button>
        <button type="button" data-action="openConfig" title="Configure" class="ncm-shard-hdr-btn"><i class="fas fa-cog"></i></button>
        <button type="button" data-action="addEntry" title="Add Entry" class="ncm-shard-hdr-btn"><i class="fas fa-plus"></i></button>
        <button type="button" data-action="viewOriginalItem" title="View Original Item Sheet" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--original"><i class="fas fa-file-alt"></i></button>
      </div>
    {{else}}
      <div class="ncm-shard-gm-header-actions">
        <button type="button" data-action="toggleChipInfo" title="Chip Specs" class="ncm-shard-hdr-btn ncm-shard-hdr-btn--chip {{#if chipDrawerOpen}}ncm-shard-hdr-btn--active{{/if}}"><i class="fas fa-microchip"></i></button>
        {{#if canPlayerEdit}}<button type="button" data-action="addEntry" title="Encode more onto this shard" class="ncm-shard-hdr-btn"><i class="fas fa-plus"></i></button>{{/if}}
        <button type="button" data-action="openDeck" title="Program Deck" class="ncm-shard-hdr-btn"><i class="fas fa-layer-group"></i></button>
      </div>
    {{/if}}
  </div>

  {{!-- ═══ CHIP INFO DRAWER (toggle via header button) ═══ --}}
  <div class="ncm-shard-chip-drawer {{#if chipDrawerOpen}}ncm-shard-chip-drawer--open{{/if}}">
    <div class="ncm-shard-chip-drawer__accent"></div>
    <div class="ncm-shard-chip-drawer__inner">
      <div class="ncm-shard-chip-drawer__header">
        <i class="fas fa-microchip"></i>
        <span class="ncm-shard-chip-drawer__title">Physical Chip</span>
        <button type="button" data-action="toggleChipInfo" class="ncm-shard-chip-drawer__close"><i class="fas fa-times"></i></button>
      </div>
      <div class="ncm-shard-chip-drawer__grid">
        {{!-- Description FIRST (tester, 2026-10-21): below the spec grid it sat
              under the fold of the drawer and was easy to never scroll to. --}}
        {{#if chipInfo.description}}
        <div class="ncm-shard-chip-spec ncm-shard-chip-spec--full ncm-shard-chip-spec--desc">
          <span class="ncm-shard-chip-spec__label">Description</span>
          <span class="ncm-shard-chip-spec__desc-text">{{{chipInfo.description}}}</span>
        </div>
        {{/if}}
        <div class="ncm-shard-chip-spec">
          <i class="fas fa-tag ncm-shard-chip-spec__icon"></i>
          <span class="ncm-shard-chip-spec__label">Price</span>
          <span class="ncm-shard-chip-spec__value"><span class="ncm-shard-chip-spec__eddies">{{chipInfo.price}} eb</span></span>
        </div>
        <div class="ncm-shard-chip-spec">
          <i class="fas fa-layer-group ncm-shard-chip-spec__icon"></i>
          <span class="ncm-shard-chip-spec__label">Qty</span>
          <span class="ncm-shard-chip-spec__value">{{chipInfo.amount}}</span>
        </div>
        <div class="ncm-shard-chip-spec">
          <i class="fas fa-building ncm-shard-chip-spec__icon"></i>
          <span class="ncm-shard-chip-spec__label">Brand</span>
          <span class="ncm-shard-chip-spec__value">{{#if chipInfo.brand}}{{chipInfo.brand}}{{else}}—{{/if}}</span>
        </div>
        <div class="ncm-shard-chip-spec">
          <i class="fas fa-box ncm-shard-chip-spec__icon"></i>
          <span class="ncm-shard-chip-spec__label">Status</span>
          <span class="ncm-shard-chip-spec__tag ncm-shard-chip-spec__tag--muted">{{chipInfo.equippedLabel}}</span>
        </div>
        <div class="ncm-shard-chip-spec">
          <i class="fas fa-bolt ncm-shard-chip-spec__icon"></i>
          <span class="ncm-shard-chip-spec__label">Electronic</span>
          <span class="ncm-shard-chip-spec__tag {{#if chipInfo.isElectronic}}ncm-shard-chip-spec__tag--cyan{{else}}ncm-shard-chip-spec__tag--muted{{/if}}">{{#if chipInfo.isElectronic}}YES{{else}}NO{{/if}}</span>
        </div>
        <div class="ncm-shard-chip-spec">
          <i class="fas fa-eye-slash ncm-shard-chip-spec__icon"></i>
          <span class="ncm-shard-chip-spec__label">Conceal</span>
          <span class="ncm-shard-chip-spec__tag {{#if chipInfo.concealable}}ncm-shard-chip-spec__tag--green{{else}}ncm-shard-chip-spec__tag--muted{{/if}}">{{#if chipInfo.concealable}}YES{{else}}NO{{/if}}</span>
        </div>
      </div>
    </div>
  </div>

  {{!-- ═══ INTEGRITY BAR (if enabled) ═══ --}}
  {{#if integrityEnabled}}
    <div class="ncm-shard-integrity-row">
      <span class="ncm-shard-integrity-label">Integrity</span>
      <div class="ncm-shard-integrity-track">
        <div class="ncm-shard-integrity-fill ncm-integrity-{{integrityTier}}" style="width: {{integrityPercent}}%;"></div>
      </div>
      <span class="ncm-shard-integrity-value">{{integrityPercent}}%</span>
      {{#if igStateWord}}<span class="ncm-ig-state ncm-ig-state--{{integrityTier}}">{{igStateWord}}</span>{{/if}}
      {{#if igRepair}}
        <button type="button" class="ncm-ig-btn" data-action="igRepair" data-tooltip="Roll to patch the damaged sectors (+{{igRepair.pts}} integrity)"><i class="fas fa-screwdriver-wrench"></i>Repair · DV {{igRepair.dv}}</button>
      {{/if}}
    </div>
  {{/if}}

  {{!-- ═══ SIGNAL ROW (if network-required + tethered) ═══ --}}
  {{#if showSignalRow}}
    <div class="ncm-shard-signal-row">
      <span class="ncm-shard-signal-label">Signal</span>
      <div class="ncm-shard-signal-bars">
        {{#each signalBars}}
          <div class="ncm-shard-signal-bar ncm-signal-{{this}}"></div>
        {{/each}}
      </div>
      <span class="ncm-shard-signal-value ncm-signal-text-{{signalTier}}">{{signalStrength}}%</span>
      <span class="ncm-shard-signal-network"><i class="fas fa-wifi"></i> {{currentNetworkName}}</span>
    </div>
  {{/if}}

  {{!-- ═══ INDEX STRIP ═══ --}}
  {{#if showIndexStrip}}
    <div class="ncm-shard-index-strip {{#if isBlocked}}ncm-shard-index-strip--locked{{/if}}">
      <div class="ncm-shard-index-toggle" data-action="toggleIndexStrip">
        <i class="fas fa-chevron-down"></i> Index
      </div>
      {{#if isBlocked}}
        {{#each indexChips}}
          <div class="ncm-shard-index-chip ncm-shard-index-chip--muted ncm-shard-index-chip--hidden" style="--ncm-chip-i:{{@index}};">
            <i class="fas fa-lock ncm-shard-index-chip-icon" style="color:#555570;"></i>
            <span class="ncm-shard-index-chip-title">?????</span>
          </div>
        {{/each}}
      {{else}}
        {{#each indexChips}}
          <div class="ncm-shard-index-chip {{accentClass}} {{#if isActive}}ncm-shard-index-chip--active{{/if}} {{#if isHidden}}ncm-shard-index-chip--hidden{{/if}}{{#if ig.damaged}} ncm-ig-chip{{/if}}{{#if ig.gone}} ncm-ig-chip--lost{{/if}}{{#if ig.glitchy}} ncm-ig-chip--glitchy{{/if}}" style="--ncm-chip-i:{{@index}};"
               data-action="scrollToEntry" data-entry-id="{{id}}"{{#if ig.tooltip}} data-tooltip="{{ig.tooltip}}"{{/if}}>
            <i class="{{iconClass}} ncm-shard-index-chip-icon" style="color:{{iconColor}};"></i>
            <span class="ncm-shard-index-chip-title">{{#if isHidden}}Hidden{{else}}{{title}}{{/if}}</span>
            {{#if ig.damaged}}<span class="ncm-ig-chipbar" aria-hidden="true">{{#each ig.meter}}<b class="{{#if this}}on{{/if}}"></b>{{/each}}</span>{{/if}}
          </div>
        {{/each}}
      {{/if}}
    </div>
  {{/if}}

  {{!-- ═══ CONTENT AREA ═══ --}}
  <div class="ncm-shard-content">

    {{!-- DESTROYED STATE --}}
    {{#if igDead}}
      {{!-- BRICKED by integrity — a dead chip, how it died, and what was on it.
            (Self-destruct / expiry keep the plain destroyed panel below.) --}}
      <div class="ncm-ig-dead{{#if igDead.fresh}} is-fresh{{/if}}">
        <i class="ncm-ig-dead__brk ncm-ig-dead__brk--tl"></i><i class="ncm-ig-dead__brk ncm-ig-dead__brk--tr"></i><i class="ncm-ig-dead__brk ncm-ig-dead__brk--bl"></i><i class="ncm-ig-dead__brk ncm-ig-dead__brk--br"></i>
        <div class="ncm-ig-dead__top"><i class="fas fa-circle"></i><span>Shard bricked // {{shardDisplayName}}</span><span>no carrier</span></div>
        <div class="ncm-ig-dead__hero">
          <div class="ncm-ig-dead__chip">
            <svg viewBox="0 0 132 150" aria-hidden="true">
              <path d="M18 4 H128 V128 L114 146 H4 V22 Z" class="ncm-ig-dead__body"/>
              <path d="M28 18 H116 V60 H28 Z" class="ncm-ig-dead__die"/>
              <g class="ncm-ig-dead__pins"><rect x="22" y="128" width="6" height="16"/><rect x="35" y="128" width="6" height="16"/><rect x="48" y="128" width="6" height="16" class="dead"/><rect x="61" y="128" width="6" height="16"/><rect x="74" y="128" width="6" height="16"/><rect x="87" y="128" width="6" height="16" class="dead"/><rect x="100" y="128" width="6" height="16"/></g>
              <g class="ncm-ig-dead__traces"><path d="M40 78 h30 v18 h22"/><path d="M40 100 h14 v12 h44"/></g>
              <path class="ncm-ig-dead__crack" d="M70 4 L62 34 L78 52 L58 80 L74 98 L52 146"/>
              <path class="ncm-ig-dead__crack ncm-ig-dead__crack--b" d="M78 52 L104 64 L118 58"/>
              <circle class="ncm-ig-dead__spark" cx="62" cy="34" r="5"/>
            </svg>
          </div>
          <div class="ncm-ig-dead__main">
            <p class="ncm-ig-dead__title">Data unrecoverable</p>
            <p class="ncm-ig-dead__sub">Integrity hit zero and the storage cells burned out. The chip still reads as a shard, but nothing on it will open.</p>
            <div class="ncm-ig-dead__stats">
              <div class="ncm-ig-dead__stat"><b>Integrity</b><span class="is-bad">0 / {{igDead.max}}</span></div>
              {{#if igDead.showCount}}<div class="ncm-ig-dead__stat"><b>Entries lost</b><span class="is-bad">{{igDead.lost}}</span></div>{{/if}}
              <div class="ncm-ig-dead__stat"><b>Failed breaches</b><span>{{igDead.breaches}}</span></div>
              <div class="ncm-ig-dead__stat"><b>Last breach</b><span>{{igDead.lastBy}}{{#if igDead.lastAt}} · {{igDead.lastAt}}{{/if}}</span></div>
            </div>
          </div>
        </div>
        <div class="ncm-ig-dead__trace">
          <div class="ncm-ig-dead__trace-h"><span>Integrity trace</span><span>{{igDead.traceLabel}}</span></div>
          <svg viewBox="0 0 {{igDead.trace.W}} {{igDead.trace.H}}" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="{{igDead.trace.baseY}}" x2="{{igDead.trace.W}}" y2="{{igDead.trace.baseY}}" class="ncm-ig-dead__base"/>
            <path class="ncm-ig-dead__line" d="{{igDead.trace.d}}"/>
            <line class="ncm-ig-dead__flat" x1="{{igDead.trace.flatX}}" y1="{{igDead.trace.baseY}}" x2="{{igDead.trace.W}}" y2="{{igDead.trace.baseY}}"/>
          </svg>
        </div>
        {{#if igDead.showList}}
          <div class="ncm-ig-dead__lost">
            <div class="ncm-ig-dead__lost-h">What was on it{{#if igDead.listGmOnly}} · GM only{{/if}}</div>
            {{#each igDead.rows}}
              <div class="ncm-ig-dead__row" style="--i:{{@index}}"><i class="{{icon}}"></i><span class="nm">{{name}}</span><span class="tg">{{label}} · lost</span></div>
            {{/each}}
          </div>
        {{/if}}
        <div class="ncm-ig-dead__act">
          {{#if igDead.isGM}}
            <button type="button" class="ncm-ig-btn ncm-ig-btn--gm" data-action="igRestore"><i class="fas fa-heart-pulse"></i>Restore shard</button>
            <small>Brings it back to full and repairs every entry.</small>
          {{else if igDead.salvage}}
            {{#if igDead.salvage.spent}}
              <small><i class="fas fa-ban"></i> Your salvage attempt failed — there is nothing left on this chip you can recover.</small>
            {{else if igDead.salvage.noActor}}
              <small>Pick an operator to attempt a salvage.</small>
            {{else}}
              <button type="button" class="ncm-ig-btn ncm-ig-btn--dead" data-action="igSalvage"><i class="fas fa-microchip"></i>Attempt salvage · DV {{igDead.salvage.dv}}</button>
              <small>One try. Pulls what's left off the cells — it comes back at {{igDead.salvage.pct}}%, badly damaged.</small>
            {{/if}}
          {{/if}}
        </div>
      </div>

    {{else if isDestroyed}}
      <div class="ncm-shard-destroyed">
        <i class="fas fa-skull-crossbones"></i>
        <p class="ncm-shard-destroyed-title">DATA UNRECOVERABLE</p>
        <p class="ncm-shard-destroyed-sub">Shard integrity has reached zero. All data is lost.</p>
      </div>

    {{!-- DISCONNECTED STATE (tethered + no connection) --}}
    {{else if showDisconnected}}
      <div class="ncm-shard-overlay ncm-shard-overlay--disconnected">
        <div class="ncm-shard-disconnect-panel">
          <i class="fas fa-plug-circle-xmark ncm-shard-disconnect-icon"></i>
          <div class="ncm-shard-disconnect-title">Connection Lost</div>
          <p class="ncm-shard-disconnect-info">
            This shard requires an active network connection. Tethered data stream interrupted.
          </p>
          <div class="ncm-shard-disconnect-detail">
            <span class="ncm-shard-detail-label">Required</span>
            <span class="ncm-shard-detail-value">{{networkDisplayName}}</span>
            <span class="ncm-shard-detail-label">Status</span>
            <span class="ncm-shard-detail-value ncm-text-danger">DISCONNECTED</span>
            <span class="ncm-shard-detail-label">Session</span>
            <span class="ncm-shard-detail-value ncm-text-success">Preserved</span>
          </div>
        </div>
      </div>

    {{!-- SECURITY OVERLAYS --}}
    {{else if showNetworkOverlay}}
      {{> "modules/night-city-messenger/templates/item-inbox/security-overlay-network.hbs"}}

    {{else if showKeyitemOverlay}}
      {{> "modules/night-city-messenger/templates/item-inbox/security-overlay-keyitem.hbs"}}

    {{else if showLoginOverlay}}
      {{> "modules/night-city-messenger/templates/item-inbox/security-overlay-login.hbs"}}

    {{else if hackingActive}}
      {{> "modules/night-city-messenger/templates/item-inbox/hacking-sequence.hbs"}}

    {{else if showEncryptionOverlay}}
      {{> "modules/night-city-messenger/templates/item-inbox/security-overlay-encryption.hbs"}}

    {{!-- UNLOCKED CONTENT --}}
    {{else}}
      {{!-- Opaque cover prevents content flash before unlock splash plays --}}
      {{#if pendingUnlockSplash}}
        <div class="ncm-sec-unlock-cover" style="position:absolute;inset:0;background:var(--ncm-background, #0a0a0a);z-index:100;"></div>
      {{/if}}
      <div class="ncm-shard-entries">
        {{#if hasEntries}}
          {{#each visibleEntries}}
            <div class="ncm-entry-card ncm-entry-accent-{{accentColor}}{{#if ig.damaged}} ncm-entry--corrupted{{/if}}{{#if ig.hiddenFromPlayers}} ncm-ig-ghost{{/if}}"
                 data-entry-id="{{id}}" id="shard-entry-{{id}}"{{#if ig}} style="--ig-delay:{{ig.delay}}s"{{/if}}>
              {{#if ig.hiddenFromPlayers}}<span class="ncm-ig-ghost-tag">Hidden from players</span>{{/if}}

              {{!-- Entry Header (shared across all types) --}}
              <div class="ncm-entry-header">
                <div class="ncm-entry-custom-icon ncm-ci-{{accentColor}}">
                  <i class="{{entryIcon}}"></i>
                </div>
                <div class="ncm-entry-title-area">
                  <div class="ncm-entry-type-label">{{contentTypeLabel}}</div>
                  {{#if isFile}}
                    {{!-- FILE (#37) — a machine artifact: filename + path, no
                          sender row (its owner is a node, not an Agent). --}}
                    <div class="ncm-entry-title ncm-entry-title--file">{{file.filename}}</div>
                    <div class="ncm-entry-file">
                      {{#if file.path}}<span class="ncm-entry-file__path">{{file.fullPath}}</span>{{/if}}
                      {{#if file.owner}}<span class="ncm-entry-file__f"><b>owner</b> {{file.owner}}</span>{{/if}}
                      <span class="ncm-entry-file__f"><b>size</b> {{file.size}}</span>
                      {{#if file.hasCount}}<span class="ncm-entry-file__f"><b>{{file.countLabel}}</b> {{file.countValue}}</span>{{/if}}
                    </div>
                  {{else}}
                    <div class="ncm-entry-title">{{subject}}</div>
                    {{#if sender}}
                      <div class="ncm-entry-sender">
                        <span class="ncm-entry-sender__ava">{{#if sender.portrait}}<img src="{{sender.portrait}}" alt="">{{else}}{{sender.initials}}{{/if}}</span>
                        <span class="ncm-entry-sender__nm">{{sender.name}}</span>
                        {{#if sender.isDirectory}}<span class="ncm-entry-sender__em">{{sender.email}}</span>{{/if}}
                        {{#if sender.canAdd}}
                          <button type="button" class="ncm-entry-sender__act" data-action="addSenderContact" data-entry-id="{{id}}" data-tooltip="Add {{sender.name}} to my contacts"><i class="fas fa-user-plus"></i></button>
                        {{/if}}
                        {{#if sender.canReply}}
                          <button type="button" class="ncm-entry-sender__act" data-action="composeToSender" data-entry-id="{{id}}" data-tooltip="Message {{sender.name}} from my Agent"><i class="fas fa-reply"></i></button>
                        {{/if}}
                      </div>
                    {{/if}}
                  {{/if}}
                </div>
                <div class="ncm-entry-timestamp">{{#if isFile}}{{file.modifiedLabel}}{{else}}{{formattedDate}}{{/if}}</div>
                {{!-- ANALYZE — on every typed file (its presence must not tell
                      the player which one is a trojan). Rolls vs the file's
                      sniff DV: unmasks a disguised payload, else "no anomalies". --}}
                {{#unless isMessage}}
                  <button type="button" data-action="analyzeFile" data-entry-id="{{id}}"
                          class="ncm-shard-hdr-btn" data-tooltip="Analyze this file — see what it really is. Not every file has something to find.">
                    <i class="fas fa-magnifying-glass"></i>
                  </button>
                {{/unless}}
                {{#if ../isGM}}
                  <button type="button" data-action="editEntry" data-entry-id="{{id}}"
                          class="ncm-shard-hdr-btn" title="Edit entry">
                    <i class="fas fa-pen"></i>
                  </button>
                  <button type="button" data-action="removeEntry" data-entry-id="{{id}}"
                          class="ncm-shard-hdr-btn ncm-shard-hdr-btn--danger" title="Delete entry">
                    <i class="fas fa-trash-can"></i>
                  </button>
                {{/if}}
              </div>

              {{!-- Integrity: the whole entry is lost (dev/design/SHARD-INTEGRITY.md) --}}
              {{#if ig.gone}}
                <div class="ncm-ig-gone">
                  <i class="fas fa-file-circle-xmark"></i>
                  <p>Sector lost · entry unreadable</p>
                  {{#if ig.recon}}<button type="button" class="ncm-ig-btn" data-action="igReconstruct" data-entry-id="{{id}}"><i class="fas fa-screwdriver-wrench"></i>Reconstruct · DV {{ig.recon.dv}}</button>{{/if}}
                  {{#if ig.canPeek}}<button type="button" class="ncm-ig-btn ncm-ig-btn--gm" data-action="igPeek" data-entry-id="{{id}}"><i class="fas fa-eye"></i>Show original</button>{{/if}}
                </div>

              {{!-- Per-message encrypted --}}
              {{else if isLocked}}
                <div class="ncm-entry-body ncm-entry-encrypted-msg">
                  <i class="fas fa-lock"></i>
                  <p>Entry Encrypted</p>
                  <button type="button" data-action="decryptMessage" data-entry-id="{{id}}"
                          class="ncm-shard-btn ncm-shard-btn--primary">
                    <i class="fas fa-terminal"></i> Decrypt
                  </button>
                </div>

              {{!-- ═══ SHARED CONTENT-TYPE RENDERER (design doc §8c) ═══ --}}
              {{else}}
                {{#if ig.showBar}}
                  {{#if ig.peek}}
                    <div class="ncm-ig-dmgbar ncm-ig-dmgbar--glitchy"><i class="fas fa-eye"></i><div class="ncm-ig-dmgbar__txt">GM — original data<small>Players see this entry {{ig.pct}}% damaged</small></div>
                      <button type="button" class="ncm-ig-btn ncm-ig-btn--gm" data-action="igPeek" data-entry-id="{{id}}"><i class="fas fa-eye-slash"></i>Show damage</button></div>
                  {{else if ig.isSafe}}
                    <div class="ncm-ig-dmgbar ncm-ig-dmgbar--safe"><i class="fas fa-shield-halved"></i><div class="ncm-ig-dmgbar__txt">Funds intact<small>{{ig.summary}}</small></div>
                      {{#if ig.canPeek}}<button type="button" class="ncm-ig-btn ncm-ig-btn--gm" data-action="igPeek" data-entry-id="{{id}}"><i class="fas fa-eye"></i>Show original</button>{{/if}}</div>
                  {{else}}
                    <div class="ncm-ig-dmgbar{{#if ig.isGlitchy}} ncm-ig-dmgbar--glitchy{{/if}}">
                      <i class="fas {{#if ig.isGlitchy}}fa-bug{{else}}fa-file-circle-exclamation{{/if}}"></i>
                      <div class="ncm-ig-dmgbar__txt">{{#if ig.isGlitchy}}Unstable program<small>Run DV +{{ig.glitchDV}} · {{ig.misfire}}% chance it misfires</small>{{else}}Data damage{{#if @root.isGM}} · {{ig.pct}}%{{/if}}<small>{{ig.summary}}</small>{{/if}}</div>
                      <span class="ncm-ig-meter">{{#each ig.meter}}<b class="{{#if this}}on{{/if}}"></b>{{/each}}</span>
                      {{#if ig.recon}}<button type="button" class="ncm-ig-btn" data-action="igReconstruct" data-entry-id="{{id}}"><i class="fas fa-screwdriver-wrench"></i>Reconstruct · DV {{ig.recon.dv}}</button>{{/if}}
                      {{#if ig.canPeek}}<button type="button" class="ncm-ig-btn ncm-ig-btn--gm" data-action="igPeek" data-entry-id="{{id}}"><i class="fas fa-eye"></i>Show original</button>{{/if}}
                    </div>
                  {{/if}}
                {{/if}}
                <div class="ncm-ig-body">{{> "modules/night-city-messenger/templates/content/content-body.hbs"}}</div>
              {{/if}}
            </div>
          {{/each}}

          {{!-- Hidden entries block --}}
          {{#if hasHiddenEntries}}
            <div class="ncm-shard-hidden-block">
              <i class="fas fa-eye-slash"></i>
              <div class="ncm-shard-hidden-count">{{hiddenCount}} Additional {{#if singleHidden}}Entry{{else}}Entries{{/if}}</div>
              <div class="ncm-shard-hidden-hint">These entries require a different network connection.</div>
              {{#if currentNetworkName}}
                <div class="ncm-shard-hidden-hint">Current network: {{currentNetworkName}}</div>
              {{/if}}
            </div>
          {{/if}}

        {{else}}
          {{!-- Empty shard --}}
          <div class="ncm-shard-empty">
            <i class="fas fa-database"></i>
            <p>SHARD EMPTY</p>
            <p class="ncm-shard-empty-sub">No data fragments stored.</p>
            {{#if isGM}}
              <button type="button" data-action="addEntry" class="ncm-shard-btn ncm-shard-btn--primary">
                <i class="fas fa-plus"></i> Add Data Fragment
              </button>
            {{else if canPlayerEdit}}
              <button type="button" data-action="addEntry" class="ncm-shard-btn ncm-shard-btn--primary">
                <i class="fas fa-plus"></i> Encode something onto it
              </button>
            {{/if}}
          </div>
        {{/if}}
      </div>
    {{/if}}
  </div>

  {{!-- ═══ FOOTER BAR ═══ --}}
  <div class="ncm-shard-footer">
    <span class="ncm-shard-footer-text">
      ░░ SHARD READER v2.1
      <span class="ncm-shard-footer-sep">░░</span>
      {{totalEntryCount}} {{#if singleEntry}}ENTRY{{else}}ENTRIES{{/if}}
      <span class="ncm-shard-footer-sep">░░</span>
      {{#if isDecrypted}}DECRYPTED{{else if isBlocked}}ENCRYPTED{{else}}OPEN{{/if}}
      {{#if isTethered}}<span class="ncm-shard-footer-sep">░░</span> TETHERED{{/if}}
      {{#if totalEddies}}<span class="ncm-shard-footer-sep">░░</span> {{totalEddies}} eb{{#if claimedEddies}} ({{claimedEddies}} claimed){{/if}}{{/if}}
    </span>
    <span class="ncm-shard-footer-spacer"></span>
    {{#if showTraceWarning}}
      <span class="ncm-shard-trace-warning">
        <i class="fas fa-triangle-exclamation"></i>
        {{#if traceVisible}}TRACE ALERT: Location data transmitted to UNKNOWN CONTACT{{else}}CAUTION: EXTERNAL HANDSHAKE DETECTED{{/if}}
      </span>
    {{/if}}
    {{#if presetFooterText}}
      <span class="ncm-shard-footer-brand">{{presetFooterText}}</span>
    {{/if}}
  </div>
</div>
