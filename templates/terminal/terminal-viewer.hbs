{{!-- TerminalViewerApp root. Single root element (ApplicationV2 requirement).
      State machine: boot | gate | login | manual | mailbox. The app sets
      data-terminal-state and animates transitions. Narrow windows reflow to a
      single column via the container query in terminal.css. (Agent/phone form
      factor → Phase 3.) --}}
<div class="ncm-terminal-viewer ncm-app"
     data-terminal-preset="{{preset}}"
     data-form-factor="{{formFactor}}"
     data-terminal-state="{{state}}"
     data-mailbox-style="{{mailboxStyle}}">

  {{#if (eq state "boot")}}
    {{> "modules/night-city-messenger/templates/terminal/terminal-boot.hbs"}}

  {{else if (eq state "gate")}}
    {{> "modules/night-city-messenger/templates/terminal/terminal-network-gate.hbs"}}

  {{else if (eq state "login")}}
    {{> "modules/night-city-messenger/templates/terminal/terminal-login.hbs"}}

  {{else if (eq state "manual")}}
    {{> "modules/night-city-messenger/templates/terminal/terminal-manual-login.hbs"}}

  {{else if (eq state "granted")}}
    {{!-- ACCESS GRANTED — the operator's keycard MATERIALISES, a reader line
          sweeps it once (fields type in, a hairline fills cyan→green), then it
          verifies (green pulse + badge on the portrait) and ACCESS GRANTED
          resolves. Slicker 3-beat sequence (~2.3s). --}}
    <div class="ncm-term__granted">
      <div class="ncm-term__badge">
        <span class="ncm-term__badge-brk ncm-term__badge-brk--tl"></span>
        <span class="ncm-term__badge-brk ncm-term__badge-brk--tr"></span>
        <span class="ncm-term__badge-brk ncm-term__badge-brk--bl"></span>
        <span class="ncm-term__badge-brk ncm-term__badge-brk--br"></span>
        <div class="ncm-term__badge-top">
          <span class="ncm-term__badge-org"><i class="fas fa-id-card"></i> {{badge.org}}</span>
          <span class="ncm-term__badge-cls">{{badge.classification}}</span>
        </div>
        <div class="ncm-term__badge-body">
          <div class="ncm-term__badge-photo">{{#if account.portrait}}<img src="{{account.portrait}}" alt="">{{else}}{{account.initials}}{{/if}}<i class="fas fa-circle-check ncm-term__badge-chk"></i></div>
          <div class="ncm-term__badge-fields">
            <div class="ncm-term__badge-nm">{{account.displayName}}</div>
            <div class="ncm-term__badge-role">{{account.role}}</div>
            <div class="ncm-term__badge-row" style="--r:0"><span class="ncm-term__badge-lbl">ID</span><b class="ncm-term__badge-val">{{badge.idLabel}}</b></div>
            <div class="ncm-term__badge-row" style="--r:1"><span class="ncm-term__badge-lbl">CLEARANCE</span><b class="ncm-term__badge-val">{{badge.clearance}}</b></div>
            {{#if badge.location}}<div class="ncm-term__badge-row" style="--r:2"><span class="ncm-term__badge-lbl">LOCATION</span><b class="ncm-term__badge-val">{{badge.location}}</b></div>{{/if}}
            <div class="ncm-term__badge-row" style="--r:{{#if badge.location}}3{{else}}2{{/if}}"><span class="ncm-term__badge-lbl">SESSION</span><b class="ncm-term__badge-val">ENCRYPTED</b></div>
          </div>
        </div>
        <div class="ncm-term__badge-last"><i class="fas fa-clock-rotate-left"></i> LAST ACCESS · {{badge.lastLogin}}</div>
        <div class="ncm-term__badge-reader"></div>
        <div class="ncm-term__badge-prog"><span class="ncm-term__badge-prog-fill"></span></div>
        <div class="ncm-term__badge-granted">ACCESS GRANTED</div>
        {{#if welcomeText}}<div class="ncm-term__badge-welcome">{{welcomeText}}</div>{{/if}}
        {{#if newSince}}<div class="ncm-term__badge-newsince"><i class="fas fa-envelope"></i> {{newSince}} new message{{#if (neq newSince 1)}}s{{/if}} since last login</div>{{/if}}
      </div>
    </div>

  {{else}}
    {{!-- ── MAILBOX ── --}}
    <div class="ncm-term__hud">
      <span class="ncm-term__hud-seg"><i class="fas fa-plug-circle-check ncm-term__hud-on"></i> <span class="ncm-term__hud-on">logged in</span></span>
      <span class="ncm-term__hud-sep">·</span>
      {{#if uplink.show}}
        {{> "modules/night-city-messenger/templates/terminal/partials/uplink.hbs" uplink}}
      {{else}}
        <span class="ncm-term__hud-seg ncm-term__hud-net"><i class="fas fa-network-wired"></i> {{uplink.name}}</span>
      {{/if}}
      {{#if uplink.wired}}
        <span class="ncm-term__hud-seg ncm-term__hud-wired" data-tooltip="Hardline — wired connection"><i class="fas fa-network-wired"></i></span>
      {{else}}
        <span class="ncm-term__hud-seg ncm-term__bars{{#if uplink.offline}} ncm-term__bars--off{{/if}}" data-tooltip="Uplink signal: {{uplink.sigLabel}}"><b class="{{#if (gt uplink.signal 0)}}on{{/if}}"></b><b class="{{#if (gte uplink.signal 25)}}on{{/if}}"></b><b class="{{#if (gte uplink.signal 50)}}on{{/if}}"></b><b class="{{#if (gte uplink.signal 80)}}on{{/if}}"></b></span>
      {{/if}}
      {{#if hud.isAdmin}}<span class="ncm-term__hud-sep">·</span><span class="ncm-term__hud-seg ncm-term__hud-admin"><i class="fas fa-user-shield"></i> ADMIN</span>{{/if}}
      <span class="ncm-term__hud-spacer"></span>
      {{!-- OPERATOR — WHO you're acting as. Every roll, siphon, claim and skill
            read uses this character; it was invisible before (silently the
            user's assigned actor), which paid siphoned eddies to the wrong PC. --}}
      {{#if hud.operator}}
        <span class="ncm-term__hud-seg ncm-term__hud-op{{#if hud.canSwitchOperator}} is-switchable{{/if}}"
              {{#if hud.canSwitchOperator}}data-action="terminalSwitchOperator"{{/if}}
              data-tooltip="Operating as {{hud.operator}} — rolls, eddies and skill checks use this character.{{#if hud.canSwitchOperator}} Click to switch.{{/if}}">
          <i class="fas fa-user-gear"></i> {{hud.operator}}{{#if hud.canSwitchOperator}} <i class="fas fa-chevron-down ncm-term__hud-opcv"></i>{{/if}}
        </span>
      {{else}}
        <span class="ncm-term__hud-seg ncm-term__hud-op ncm-term__hud-op--none" data-tooltip="No character assigned — rolls, eddies claims and skill checks can't run.">
          <i class="fas fa-user-slash"></i> NO OPERATOR
        </span>
      {{/if}}
      {{!-- OPERATOR TOOLS — host-level offensive menu (UPLOAD now, SYSTEM SWEEP
            later). Gated by canOperate: not-capable operators see it locked with
            the requirement as a tooltip. --}}
      {{#if hud.tools}}
        <span class="ncm-term__hud-seg ncm-term__hud-tools{{#if hud.tools.open}} is-open{{/if}}{{#unless hud.tools.canOperate}} is-locked{{/unless}}"
              data-action="terminalOperatorTools"
              data-tooltip="{{#if hud.tools.canOperate}}Operator tools — upload, hacking{{else}}{{hud.tools.reason}}{{/if}}">
          <i class="fas fa-user-secret"></i> OPS <i class="fas fa-chevron-down ncm-term__hud-opcv"></i>
          {{#if hud.tools.open}}
            <div class="ncm-term__opsmenu">
              <div class="ncm-term__opsmenu-hd">OPERATOR TOOLS</div>
              {{#each hud.tools.items}}
                <div class="ncm-term__opsitem{{#if this.disabled}} is-disabled{{/if}}{{#if this.soon}} is-soon{{/if}}"
                     {{#unless this.disabled}}data-action="{{this.action}}"{{/unless}}
                     {{#if this.reason}}data-tooltip="{{this.reason}}"{{/if}}>
                  <span class="ncm-term__opsico"><i class="{{this.icon}}"></i></span>
                  <span class="ncm-term__opsnm">
                    <span class="ncm-term__opst">{{this.label}}{{#if this.soon}} <span class="ncm-term__opssoon">SOON</span>{{/if}}</span>
                    <span class="ncm-term__opsd">{{this.desc}}</span>
                  </span>
                </div>
              {{/each}}
              {{#if hud.tools.active.length}}
                <div class="ncm-term__opsmenu-hd ncm-term__opsmenu-hd--active">{{#if hud.tools.activeMine}}YOUR PROGRAMS{{else}}ACTIVE PROGRAMS{{/if}} · {{hud.tools.activeCount}}</div>
                {{#each hud.tools.active}}
                  <div class="ncm-term__opsactive{{#if this.fired}} is-fired{{/if}}{{#if this.expanded}} is-open{{/if}}"
                       data-action="terminalProgramInfo" data-resident-id="{{this.id}}"
                       data-tooltip="{{#if this.hasFile}}Open the planted file{{else}}{{#unless this.expanded}}What it does{{/unless}}{{/if}}">
                    <span class="ncm-term__opsico"><i class="{{this.icon}}"></i></span>
                    <span class="ncm-term__opsnm">
                      <span class="ncm-term__opst">{{this.label}} <i class="fas {{#if this.hasFile}}fa-arrow-up-right-from-square{{else if this.expanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}} ncm-term__opscv"></i></span>
                      {{#if this.expanded}}<span class="ncm-term__opsd">{{this.desc}}{{#if this.by}} · planted by {{this.by}}{{/if}}</span>{{/if}}
                    </span>
                    <span class="ncm-term__opsstate"><span class="ncm-term__opsdot"></span>{{this.state}}</span>
                  </div>
                {{/each}}
              {{/if}}
            </div>
          {{/if}}
        </span>
      {{/if}}
      {{#if isGM}}<span class="ncm-term__hud-seg ncm-term__hud-gm" data-action="terminalConfigure" data-tooltip="Configure terminal (GM)"><i class="fas fa-sliders"></i> EDIT</span>{{/if}}
      {{#if hud.trace}}<span class="ncm-term__hud-seg ncm-term__hud-trace"><i class="fa-regular fa-clock"></i> TRACE {{hud.trace}}</span>{{/if}}
    </div>

    {{!-- MAILBOX STYLE (2026-10-25, config.mailboxStyle — TERMINAL_MAILBOX_STYLES):
          tabs / tty / desktop are partials over the SAME context and actions;
          classic is the layout below. --}}
    {{#if msTabs}}
      {{> "modules/night-city-messenger/templates/terminal/mailbox/tabs.hbs"}}
    {{else if msTty}}
      {{> "modules/night-city-messenger/templates/terminal/mailbox/tty.hbs"}}
    {{else if msDesktop}}
      {{> "modules/night-city-messenger/templates/terminal/mailbox/desktop.hbs"}}
    {{else}}
    {{!-- Sidebar collapse (the message viewer's --list-collapsed precedent):
          the mailbox list folds to a thin rail so a spreadsheet / camera feed /
          schematic gets the full width of the machine. --}}
    <div class="ncm-term__panes{{#if sideCollapsed}} ncm-term__panes--collapsed{{/if}}">
      <button type="button" class="ncm-term__side-toggle" data-action="terminalToggleSide"
              data-tooltip="{{#if sideCollapsed}}Show the mailbox{{else}}Hide the mailbox — full-width view{{/if}}">
        <i class="fas fa-chevron-{{#if sideCollapsed}}right{{else}}left{{/if}}"></i>
      </button>
      <div class="ncm-term__side">
        <div class="ncm-term__acsw{{#if switcherOpen}} is-open{{/if}}" data-action="terminalToggleSwitcher">
          <span class="ncm-term__avatar">{{#if account.portrait}}<img src="{{account.portrait}}" alt="">{{else}}{{account.initials}}{{/if}}</span>
          <span class="ncm-term__acsw-nm">{{account.displayName}}<small>{{account.username}}</small></span>
          <span class="ncm-term__acsw-caret"><i class="fas fa-chevron-down"></i></span>
          {{#if switcherOpen}}
            <div class="ncm-term__acdrop">
              <div class="ncm-term__acdrop-hd">SWITCH ACCOUNT</div>
              {{#each switchAccounts}}
                <div class="ncm-term__acdrop-it{{#if isCurrent}} is-current{{/if}}" data-action="terminalSwitchAccount" data-account-id="{{id}}">
                  <span class="ncm-term__avatar">{{#if portrait}}<img src="{{portrait}}" alt="">{{else}}{{initials}}{{/if}}</span>
                  <span class="ncm-term__acdrop-nm">{{displayName}}</span>
                  <span class="ncm-term__acdrop-lk{{#if isOpen}} is-open{{/if}}">{{{statusLabel}}}</span>
                </div>
              {{/each}}
              <div class="ncm-term__acdrop-ft" data-action="terminalLogout"><i class="fas fa-right-from-bracket"></i> Log out → login screen</div>
            </div>
          {{/if}}
        </div>
        {{!-- MAIL | FILES view switch (2026-10-25, terminalFiles.js). FILES
              swaps the mail folder strip for the directory tree: this account's
              HOME and the machine's SHARED volume as roots, folders from every
              file's path, a locked folder shown with its reason. --}}
        <div class="ncm-term__fs-view">
          <button type="button" class="{{#unless isFilesView}}is-on{{/unless}}" data-action="terminalView" data-view="mail"><i class="fas fa-envelope"></i> MAIL <b>{{view.mail}}</b></button>
          <button type="button" class="{{#if isFilesView}}is-on{{/if}}" data-action="terminalView" data-view="files"><i class="fas fa-folder-tree"></i> FILES <b>{{view.files}}</b></button>
        </div>
        {{#if isFilesView}}
        {{> "modules/night-city-messenger/templates/terminal/mailbox/tree.hbs"}}
        {{else}}
        {{!-- Pinned zone: folders + list label never scroll away; only the
             message list below scrolls (.ncm-term__list). --}}
        <div class="ncm-term__folds">
          {{#each folders}}
            <div class="ncm-term__fold{{#if active}} is-active{{/if}}" data-action="terminalFolder" data-folder="{{key}}">
              <i class="{{icon}}"></i> {{label}} <span class="ncm-term__fold-ct">{{count}}</span>
            </div>
          {{/each}}
        </div>
        <div class="ncm-term__lsep"></div>
        <div class="ncm-term__slabel">{{listLabel}}</div>
        <div class="ncm-term__list">
          {{> "modules/night-city-messenger/templates/terminal/mailbox/rows.hbs"}}
          {{#if syncHint}}
            <div class="ncm-term__synchint"><i class="fas fa-triangle-exclamation"></i> {{syncHint.count}} object{{#unless (eq syncHint.count 1)}}s{{/unless}} failed to sync — uplink required</div>
          {{/if}}
          {{#if pagination}}
            <div class="ncm-term__pager">
              <button type="button" class="ncm-term__pager-btn" data-action="terminalPage" data-dir="prev" {{#unless pagination.hasPrev}}disabled{{/unless}}><i class="fas fa-chevron-left"></i></button>
              <span class="ncm-term__pager-lbl">{{pagination.page}} / {{pagination.maxPage}}</span>
              <button type="button" class="ncm-term__pager-btn" data-action="terminalPage" data-dir="next" {{#unless pagination.hasNext}}disabled{{/unless}}><i class="fas fa-chevron-right"></i></button>
            </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if isGM}}
          <button type="button" class="ncm-term__gm-add" data-action="terminalNewMessage"><i class="fas fa-plus"></i> {{#if isFilesView}}Add a file here (GM){{else}}Add message or file (GM){{/if}}</button>
        {{/if}}
      </div>

      <div class="ncm-term__detail{{#if fs.showListing}} is-listing{{/if}}">
        {{> "modules/night-city-messenger/templates/terminal/mailbox/detail.hbs"}}
      </div>
    </div>
    {{/if}}

    {{!-- Idle screensaver (config.screensaver) — dim overlay + drifting logo/
          marquee; _resetScreensaver toggles --on after idleSeconds, any
          activity inside the window wakes it. --}}
    {{#if screensaver}}
      <div class="ncm-term__saver" data-ss-motion="{{screensaver.motion}}">
        <div class="ncm-term__saver-inner">
          {{#if screensaver.logo}}
            <div class="ncm-term__saver-logo">{{#if screensaver.logo.imageUrl}}<img src="{{screensaver.logo.imageUrl}}" alt="">{{else}}<i class="{{screensaver.logo.icon}}"></i>{{/if}}</div>
          {{/if}}
          <div class="ncm-term__saver-text">{{screensaver.text}}</div>
          <div class="ncm-term__saver-hint">— click anywhere to resume —</div>
        </div>
      </div>
    {{/if}}
  {{/if}}

  {{!-- ── Machine-uplink join challenge (secured interface) — full-viewer
        overlay over the login or mailbox state; the network's own security
        block, rolled by the logged-in operator. --}}
  {{#if netAuth}}
    <div class="ncm-term__netauth">
      <div class="ncm-term__console" data-auth-state="login" style="--net-c: {{netAuth.color}};">
        <div class="ncm-term__console-hd">
          <i class="fas fa-tower-broadcast"></i>
          <span class="ncm-term__console-ttl">JOIN NETWORK // {{netAuth.networkName}}</span>
          <span class="ncm-term__console-dot"></span>
        </div>
        <div class="ncm-term__console-body">
          <div class="ncm-term__console-pline">{{netAuth.shellHost}}:~$ join {{netAuth.joinCmd}}<span class="ncm-term__cursor"></span></div>
          {{#if netAuth.allowPassword}}
            <div class="ncm-term__tfield">
              <span class="ncm-term__tfield-pf">&gt;</span><span class="ncm-term__tfield-l">PASSKEY</span>
              <input type="text" data-ncm-secret="1" name="ncm-term-netkey" autocomplete="new-password" data-lpignore="true" data-1p-ignore data-bwignore data-form-type="other" placeholder="••••••••">
            </div>
          {{/if}}
          {{#if netAuth.error}}<div class="ncm-term__danger" style="border-radius:8px;margin:4px 0 10px;border:1px solid color-mix(in srgb,var(--ncm-danger) 45%,transparent)"><i class="fas fa-triangle-exclamation"></i> {{netAuth.error}}</div>{{/if}}
          {{#unless netAuth.lockout}}
            {{#if netAuth.allowPassword}}
              <div class="ncm-term__auth" data-action="terminalNetAuth"><i class="fas fa-right-to-bracket"></i> AUTHENTICATE</div>
            {{/if}}
            {{#if netAuth.skillBypass}}
              <div class="ncm-term__spoof" style="width:100%;justify-content:center;margin-top:10px" data-action="terminalNetSkillBypass">
                <i class="fas fa-dice-d20"></i> Bypass with {{netAuth.skillBypass.skill}} — DV {{netAuth.skillBypass.dv}}
              </div>
            {{/if}}
            {{#if netAuth.isGM}}
              <div class="ncm-term__spoof" style="width:100%;justify-content:center;margin-top:10px" data-action="terminalNetGmJoin">
                <i class="fas fa-user-shield"></i> GM — join without credentials
              </div>
            {{/if}}
          {{/unless}}
          <div class="ncm-term__netauth-cancel" data-action="terminalNetCancel"><i class="fas fa-xmark"></i> cancel</div>
        </div>
      </div>
    </div>
  {{/if}}
</div>
