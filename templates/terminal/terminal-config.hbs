{{!-- TerminalConfigApp sheet. Single root. Reuses ncm-cfg-* (shard config) styling.
     The root MUST carry .ncm-cfg and the panel wrapper MUST be .ncm-cfg-content —
     they are the flex-column + scroll pair (window-content is overflow:hidden,
     so without them the sheet can't scroll and Save is unreachable). --}}
<div class="ncm-item-inbox-config ncm-term-config ncm-cfg">

  <div class="ncm-cfg-topbar">
    <button type="button" class="ncm-cfg-btn-sm" data-action="saveConfig"><i class="fas fa-floppy-disk"></i> Save</button>
    <button type="button" class="ncm-cfg-btn-sm" data-action="importConfig"><i class="fas fa-file-import"></i> Import</button>
    <button type="button" class="ncm-cfg-btn-sm" data-action="exportConfig"><i class="fas fa-file-export"></i> Export</button>
    {{#if isGM}}
      <span style="flex:1"></span>
      {{#if gmBypassed}}
        <button type="button" class="ncm-cfg-btn-sm" data-action="relock"><i class="fas fa-lock"></i> Relock</button>
      {{else}}
        <button type="button" class="ncm-cfg-btn-sm" data-action="forceUnlock"><i class="fas fa-unlock-keyhole"></i> Force-unlock</button>
      {{/if}}
    {{/if}}
  </div>

  <div class="ncm-cfg-tabs">
    <button type="button" class="ncm-cfg-tab {{#if tabs.identity}}ncm-cfg-tab--active{{/if}}" data-action="switchTab" data-tab="identity"><i class="fas fa-id-badge"></i> Identity</button>
    <button type="button" class="ncm-cfg-tab {{#if tabs.accounts}}ncm-cfg-tab--active{{/if}}" data-action="switchTab" data-tab="accounts"><i class="fas fa-users"></i> Accounts <span class="ncm-cfg-badge {{#if accountCount}}ncm-cfg-badge--on{{/if}}">{{accountCount}}</span></button>
    <button type="button" class="ncm-cfg-tab {{#if tabs.theme}}ncm-cfg-tab--active{{/if}}" data-action="switchTab" data-tab="theme"><i class="fas fa-palette"></i> Theme</button>
    <button type="button" class="ncm-cfg-tab {{#if tabs.boot}}ncm-cfg-tab--active{{/if}}" data-action="switchTab" data-tab="boot"><i class="fas fa-power-off"></i> Boot &amp; Login</button>
    <button type="button" class="ncm-cfg-tab {{#if tabs.network}}ncm-cfg-tab--active{{/if}}" data-action="switchTab" data-tab="network"><i class="fas fa-network-wired"></i> Network {{#if networkRequired}}<span class="ncm-cfg-badge ncm-cfg-badge--on">ON</span>{{/if}}</button>
    <button type="button" class="ncm-cfg-tab {{#if tabs.exfil}}ncm-cfg-tab--active{{/if}}" data-action="switchTab" data-tab="exfil"><i class="fas fa-download"></i> Exfil</button>
  </div>

  <div class="ncm-cfg-content">

    {{!-- IDENTITY --}}
    <div class="ncm-cfg-panel {{#if tabs.identity}}ncm-cfg-panel--active{{/if}}" data-panel="identity">
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-fingerprint ncm-cfg-section-icon" style="color:#19f3f7"></i><div class="ncm-cfg-section-title">Terminal Identity</div></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Name</span><input type="text" name="terminalName" class="ncm-cfg-input ncm-cfg-flex" value="{{terminalName}}" placeholder="{{itemName}}"></div>
        <div class="ncm-cfg-hint">Blank uses the item name ({{itemName}}). Shown in the window title.</div>
      </div>
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-tags ncm-cfg-section-icon" style="color:#f7c948"></i><div class="ncm-cfg-section-title">Metadata <span class="ncm-cfg-hint" style="font-weight:400">— boot/HUD flavor</span></div></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Owner</span><input type="text" name="owner" class="ncm-cfg-input ncm-cfg-flex" value="{{owner}}"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Org</span><input type="text" name="org" class="ncm-cfg-input ncm-cfg-flex" value="{{org}}"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Location</span><input type="text" name="location" class="ncm-cfg-input ncm-cfg-flex" value="{{location}}"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Classification</span><input type="text" name="classification" class="ncm-cfg-input ncm-cfg-flex" value="{{classification}}"></div>
      </div>
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-folder-tree ncm-cfg-section-icon" style="color:#00ff41"></i><div class="ncm-cfg-section-title">Mailbox Folders <span class="ncm-cfg-hint" style="font-weight:400">— modular</span></div></div>
        <div class="ncm-cfg-desc">The mailbox sidebar's folder set. Rename the system folders (blank = default), pick icons, hide Saved/Trash, or add custom folders. Custom folders appear in the composer's Entry Header so files can be filed into them; removing one sends its mail back to the Inbox.</div>
        <div class="ncm-cfg-folder-rows" data-folder-rows>
          {{#each folderRows}}
            <div class="ncm-cfg-folder-row" data-folder-row data-folder-kind="{{kind}}" data-folder-id="{{id}}">
              <select class="ncm-cfg-select ncm-cfg-folder-icon" data-f-icon>{{#each icons}}<option value="{{c}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              <input type="text" class="ncm-cfg-input ncm-cfg-flex" data-f-name value="{{name}}" placeholder="{{placeholder}}">
              {{#if isSystem}}
                {{#if canHide}}
                  <label class="ncm-cfg-folder-show" data-tooltip="Untick to hide this folder from the sidebar"><input type="checkbox" data-f-on {{#if enabled}}checked{{/if}}> show</label>
                {{else}}
                  <span class="ncm-cfg-folder-tag">SYSTEM</span>
                {{/if}}
              {{else}}
                <button type="button" class="ncm-cfg-btn-icon" data-action="folderRemove" data-tooltip="Remove folder (its mail returns to the Inbox)"><i class="fas fa-xmark"></i></button>
              {{/if}}
            </div>
          {{/each}}
        </div>
        <button type="button" class="ncm-cfg-btn-sm" data-action="folderAdd"><i class="fas fa-plus"></i> Add folder</button>
        <div class="ncm-cfg-hint">Sidebar order: Inbox → custom folders → Saved → Trash.</div>
      </div>
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-microchip ncm-cfg-section-icon" style="color:#ff0033"></i><div class="ncm-cfg-section-title">Linked Item</div></div>
        <div class="ncm-cfg-hint">Item: <strong>{{itemName}}</strong> · Journal: <strong>{{journalName}}</strong>. Messages live in the journal, tagged per account.</div>
      </div>
    </div>

    {{!-- ACCOUNTS --}}
    <div class="ncm-cfg-panel {{#if tabs.accounts}}ncm-cfg-panel--active{{/if}}" data-panel="accounts">
      {{#if editing}}
        {{> "modules/cyberpunkred-messenger/templates/terminal/partials/config-account.hbs" editing}}
      {{else}}
        <div class="ncm-cfg-section">
          <div class="ncm-cfg-section-header"><i class="fas fa-users ncm-cfg-section-icon" style="color:#19f3f7"></i><div class="ncm-cfg-section-title">Accounts</div></div>

          {{!-- Summary strip — who lives on this box, at a glance. --}}
          <div class="ncm-acctl-summary">
            <span class="ncm-acctl-stat"><b>{{acctSummary.total}}</b> total</span>
            <span class="ncm-acctl-stat ncm-acctl-stat--adm"><i class="fas fa-user-shield"></i> <b>{{acctSummary.admins}}</b> admin</span>
            <span class="ncm-acctl-stat ncm-acctl-stat--open"><i class="fas fa-lock-open"></i> <b>{{acctSummary.open}}</b> open</span>
            <span class="ncm-acctl-stat ncm-acctl-stat--sec"><i class="fas fa-lock"></i> <b>{{acctSummary.secured}}</b> secured</span>
            {{#if acctSummary.hidden}}<span class="ncm-acctl-stat"><i class="fas fa-eye-slash"></i> <b>{{acctSummary.hidden}}</b> hidden</span>{{/if}}
            {{#if acctSummary.gated}}<span class="ncm-acctl-stat ncm-acctl-stat--net"><i class="fas fa-wifi"></i> <b>{{acctSummary.gated}}</b> net-gated</span>{{/if}}
          </div>

          {{!-- Toolbar — search / sort / add. --}}
          <div class="ncm-acctl-bar">
            <div class="ncm-cfg-icon-search" style="margin:0;flex:1"><i class="fas fa-magnifying-glass"></i><input type="text" name="acctSearch" value="{{acctControls.search}}" placeholder="search name, username, email, role…"></div>
            <select name="acctSort" class="ncm-cfg-select" data-tooltip="Sort">{{#each acctControls.sortOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            <button type="button" class="ncm-cfg-btn-sm" data-action="addAccount"><i class="fas fa-plus"></i> Add</button>
          </div>

          {{#each accounts}}
            <div class="ncm-acctl-row" data-action="editAccount" data-account-id="{{id}}">
              <span class="ncm-acctl-av">{{#if portrait}}<img src="{{portrait}}" alt="">{{else}}{{initials}}{{/if}}
                {{#if isAdmin}}<i class="fas fa-user-shield ncm-acctl-av-adm" data-tooltip="Administrator"></i>{{/if}}
              </span>
              <span class="ncm-acctl-id">
                <span class="ncm-acctl-nm">{{displayName}}
                  {{#if isDefault}}<b class="ncm-term-cfg-tag ncm-term-cfg-tag--default">★ default</b>{{/if}}
                  {{#if hidden}}<b class="ncm-term-cfg-tag"><i class="fas fa-eye-slash"></i> hidden</b>{{/if}}
                  {{#if gated}}<b class="ncm-term-cfg-tag ncm-term-cfg-tag--net"><i class="fas fa-wifi"></i> net-gated</b>{{/if}}
                </span>
                <span class="ncm-acctl-sub">{{username}}{{#if email}} · <i class="ncm-acctl-mail">{{email}}</i>{{/if}}{{#if linkedContact}} · ◉ {{linkedContact}}{{/if}}</span>
                {{#if role}}<span class="ncm-acctl-role">{{role}}</span>{{/if}}
              </span>
              <span class="ncm-acctl-right">
                {{#if clearance}}<b class="ncm-acctl-clr">{{clearance}}</b>{{/if}}
                <span class="ncm-acctl-methods">{{#each methods}}<b class="ncm-term-cfg-m ncm-term-cfg-m--{{cls}}">{{label}}</b>{{/each}}</span>
              </span>
              <span class="ncm-acctl-acts">
                <button type="button" class="ncm-cfg-btn-icon" data-action="editAccount" data-account-id="{{id}}" data-tooltip="Edit"><i class="fas fa-pen"></i></button>
                <button type="button" class="ncm-cfg-btn-icon ncm-cfg-btn-icon--danger" data-action="removeAccount" data-account-id="{{id}}" data-tooltip="Remove"><i class="fas fa-trash-can"></i></button>
              </span>
            </div>
          {{else}}
            <div class="ncm-acctl-empty">{{#if acctControls.isFiltered}}No accounts match "{{acctControls.search}}".{{else}}No accounts yet — Add one, or stage a preset (Theme tab) to seed some.{{/if}}</div>
          {{/each}}

          {{#if acctControls.pager}}
            <div class="ncm-acctl-pager">
              <button type="button" class="ncm-cfg-btn-sm" data-action="acctPage" data-dir="-1" {{#unless acctControls.pager.hasPrev}}disabled{{/unless}}><i class="fas fa-chevron-left"></i></button>
              <span>{{acctControls.pager.page}} / {{acctControls.pager.maxPage}}{{#if acctControls.isFiltered}} · {{acctControls.filteredCount}} match{{/if}}</span>
              <button type="button" class="ncm-cfg-btn-sm" data-action="acctPage" data-dir="1" {{#unless acctControls.pager.hasNext}}disabled{{/unless}}><i class="fas fa-chevron-right"></i></button>
            </div>
          {{/if}}
        </div>
      {{/if}}
    </div>

    {{!-- THEME — mirrors the player ThemeCustomizer: draft state (edits
         survive tab switches, Save persists, close reverts), live preview,
         preset cards, per-key color overrides, sliders, saved themes.
         Reuses the .ncm-tc__ widget classes (theme-customizer.css layout
         rules are .ncm-app-scoped; its root-scoped button/select rules are
         co-scoped to .ncm-term-config). Controls here are UNNAMED/data-keyed
         on purpose — the save contract is _themeDraft, not FormData. --}}
    <div class="ncm-cfg-panel {{#if tabs.theme}}ncm-cfg-panel--active{{/if}}" data-panel="theme">

      <div class="ncm-tc__preview ncm-ttc-live">
        <div class="ncm-tc__preview-label"><i class="fas fa-eye"></i> Live Preview — this terminal only{{#if themeDirty}} · <span style="color:var(--ncm-accent)">unsaved</span>{{/if}}</div>
        <div class="ncm-tc__preview-inbox">
          <div class="ncm-tc__preview-hdr">
            <div class="ncm-tc__preview-av"><i class="fas fa-server" style="font-size:8px"></i></div>
            <div class="ncm-tc__preview-nm">{{previewName}}</div>
            <div class="ncm-tc__preview-nt">UPLINK: CITINET</div>
          </div>
          <div class="ncm-tc__preview-row">
            <div class="ncm-tc__preview-dot"></div>
            <div class="ncm-tc__preview-from">finance</div>
            <div class="ncm-tc__preview-subj">Wire authorization — executive token required</div>
            <div class="ncm-tc__preview-time">04:12</div>
          </div>
          <div class="ncm-tc__preview-row">
            <div class="ncm-tc__preview-dot ncm-tc__preview-dot--read"></div>
            <div class="ncm-tc__preview-from">sysadmin</div>
            <div class="ncm-tc__preview-subj">Scheduled maintenance window</div>
            <div class="ncm-tc__preview-badge">CRITICAL</div>
            <div class="ncm-tc__preview-time">02:48</div>
          </div>
          <div class="ncm-tc__preview-row">
            <div class="ncm-tc__preview-dot ncm-tc__preview-dot--read"></div>
            <div class="ncm-tc__preview-from">logistics</div>
            <div class="ncm-tc__preview-subj">Convoy 4471 cleared customs at NCIA</div>
            <div class="ncm-tc__preview-time">yesterday</div>
          </div>
        </div>
      </div>

      <div class="ncm-tc__slabel">Built-in Presets</div>
      <div class="ncm-tc__preset-grid">
        {{#each presets}}
        <div class="ncm-tc__pcard {{#if active}}ncm-tc__pcard--active{{/if}}" data-action="selectTermPreset" data-preset="{{key}}">
          <div class="ncm-tc__pcard-swatch"><span style="background:{{sw1}};"></span><span style="background:{{sw2}};"></span><span style="background:{{sw3}};"></span></div>
          <div class="ncm-tc__pcard-name">{{label}}</div>
        </div>
        {{/each}}
      </div>
      {{#if presetKitLabel}}
        <div class="ncm-cfg-kitbar">
          <i class="fas fa-boxes-packing"></i>
          <span><strong>{{presetKitLabel}}</strong> staged — palette, fonts, boot screen, login style, MOTD, screensaver, folder names &amp; sound profile all update on <strong>Save</strong> (accounts seed too when this terminal has none).</span>
          <button type="button" class="ncm-tc__paction ncm-cfg-kitbar-btn" data-action="clearPresetKit" data-tooltip="Keep only the colors & fonts from this preset">palette only</button>
        </div>
      {{else}}
        <div class="ncm-cfg-hint" style="margin:0 16px;">A preset card stages the <strong>whole machine</strong> — palette, fonts, boot screen, login style, and (when the terminal has no accounts) seed accounts. Check the Boot &amp; Login tab to see it, then <strong>Save</strong> to commit.</div>
      {{/if}}

      <div class="ncm-tc__divider"></div>
      <div class="ncm-tc__slabel">Terminal Preset Library — full setups (theme · boot · login style · screensaver · folders · account seeds)</div>
      <div class="ncm-tc__clist">
        {{#each fullPresets}}
        <div class="ncm-tc__citem" data-fpreset-index="{{index}}">
          <div class="ncm-tc__citem-swatch"><span style="background:{{sw1}};"></span><span style="background:{{sw2}};"></span><span style="background:{{sw3}};"></span></div>
          <i class="{{styleIcon}}" style="color:var(--ncm-text-muted);font-size:10px"></i>
          <span class="ncm-tc__citem-name">{{name}}</span>
          <div class="ncm-tc__citem-actions">
            <button type="button" data-action="applyFullPreset" data-tooltip="Apply to this terminal (confirms first)"><i class="fas fa-check"></i></button>
            <button type="button" data-action="overwriteFullPreset" data-tooltip="Overwrite with this terminal"><i class="fas fa-save"></i></button>
            <button type="button" data-action="exportFullPreset" data-tooltip="Export JSON"><i class="fas fa-file-export"></i></button>
            <button type="button" class="ncm-tc__citem-del" data-action="deleteFullPreset" data-tooltip="Delete"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        {{/each}}
        {{#unless fullPresets.length}}
        <div class="ncm-tc__cempty">No saved terminal presets — author one terminal fully, then Save it here to stamp out more like it.</div>
        {{/unless}}
      </div>
      <div class="ncm-tc__pactions">
        <button type="button" class="ncm-tc__paction" data-action="saveFullPreset"><i class="fas fa-plus"></i> Save This Terminal</button>
        <button type="button" class="ncm-tc__paction" data-action="importFullPreset"><i class="fas fa-file-import"></i> Import</button>
        <button type="button" class="ncm-tc__paction" data-action="exportFullPreset"><i class="fas fa-file-export"></i> Export Current</button>
      </div>

      <div class="ncm-tc__divider"></div>
      <div class="ncm-tc__slabel">Saved Themes — palette &amp; fonts only</div>
      <div class="ncm-tc__clist">
        {{#each savedThemes}}
        <div class="ncm-tc__citem" data-theme-index="{{index}}">
          <div class="ncm-tc__citem-swatch"><span style="background:{{sw1}};"></span><span style="background:{{sw2}};"></span><span style="background:{{sw3}};"></span></div>
          <span class="ncm-tc__citem-name">{{name}}</span>
          <div class="ncm-tc__citem-actions">
            <button type="button" data-action="applyTermTheme" data-tooltip="Apply"><i class="fas fa-check"></i></button>
            <button type="button" data-action="overwriteTermTheme" data-tooltip="Overwrite with current"><i class="fas fa-save"></i></button>
            <button type="button" class="ncm-tc__citem-del" data-action="deleteTermTheme" data-tooltip="Delete"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        {{/each}}
        {{#unless savedThemes.length}}
        <div class="ncm-tc__cempty">No saved themes yet — Save Current to reuse a look on other terminals.</div>
        {{/unless}}
      </div>
      <div class="ncm-tc__pactions">
        <button type="button" class="ncm-tc__paction" data-action="saveTermTheme"><i class="fas fa-plus"></i> Save Current</button>
        <button type="button" class="ncm-tc__paction" data-action="importTermTheme"><i class="fas fa-file-import"></i> Import</button>
        <button type="button" class="ncm-tc__paction" data-action="exportTermTheme"><i class="fas fa-file-export"></i> Export</button>
      </div>

      <div class="ncm-tc__divider"></div>
      <div class="ncm-tc__slabel">Color Overrides</div>
      <div class="ncm-tc__color-grid">
        {{#each themeColorEntries}}
        <div class="ncm-tc__color-entry" data-color-key="{{key}}">
          <div class="ncm-tc__color-swatch"><input type="color" value="{{value}}" /></div>
          <span class="ncm-tc__color-label">{{label}}</span>
          <span class="ncm-tc__color-hex">{{value}}</span>
          {{#if hasOverride}}<div class="ncm-tc__color-dot"></div>{{/if}}
        </div>
        {{/each}}
      </div>
      <button type="button" class="ncm-tc__color-reset" data-action="resetTermColors"><i class="fas fa-undo"></i> Reset colors to preset defaults</button>

      <div class="ncm-tc__slabel">Wallpaper &amp; Effects</div>
      <div class="ncm-tc__font-section">
        <div class="ncm-tc__srow">
          <span class="ncm-tc__srow-label">Wallpaper</span>
          <input type="text" class="ncm-tc__name-input" data-ttc-wallpaper value="{{themeWallpaper}}" placeholder="image behind the login + mailbox (blank = none)">
          <button type="button" class="ncm-tc__paction" style="flex:0 0 auto" data-action="browseWallpaper" data-tooltip="Browse / upload"><i class="fas fa-folder-open"></i></button>
        </div>
        <div class="ncm-tc__srow">
          <span class="ncm-tc__srow-label">Wallpaper strength</span>
          <input type="range" name="ttcWallStrength" min="5" max="100" step="5" value="{{themeWallStrength}}" class="ncm-tc__slider" />
          <span class="ncm-tc__srow-val ncm-ttc-wall-val">{{themeWallStrength}}%</span>
        </div>
        <div class="ncm-tc__srow">
          <span class="ncm-tc__srow-label">Scanlines</span>
          <div class="ncm-tc__switch{{#if themeScanlines}} ncm-tc__switch--on{{/if}}" data-ttc-toggle="scanlines"></div>
          <span class="ncm-tc__srow-label" style="min-width:0;margin-left:14px">CRT Flicker</span>
          <div class="ncm-tc__switch{{#if themeFlicker}} ncm-tc__switch--on{{/if}}" data-ttc-toggle="flicker"></div>
        </div>
        <div class="ncm-tc__srow">
          <span class="ncm-tc__srow-label">Glitch</span>
          <input type="range" name="ttcGlitch" min="0" max="100" step="5" value="{{themeGlitch}}" class="ncm-tc__slider" />
          <span class="ncm-tc__srow-val ncm-ttc-glitch-val">{{themeGlitch}}%</span>
        </div>
        <div class="ncm-cfg-hint" style="padding:0">Effects preview on an open viewer of this terminal, not in the strip above.</div>
      </div>

      <div class="ncm-tc__slabel">Text</div>
      <div class="ncm-tc__font-section">
        {{#each themeFontSelectors}}
        <div class="ncm-tc__font-row">
          <span class="ncm-tc__font-label">{{label}}</span>
          <select class="ncm-tc__font-select" data-font-slot="{{slot}}">
            {{#each options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{/each}}
        <div class="ncm-tc__font-preview ncm-ttc-live">
          <div class="ncm-tc__fprev-title">{{previewName}}</div>
          <div class="ncm-tc__fprev-body">Authorization required for the transfer to offshore holding.</div>
          <div class="ncm-tc__fprev-mono">SESSION 7F-12 // UPLINK: CITINET // 98% signal</div>
        </div>
        <div class="ncm-tc__srow">
          <span class="ncm-tc__srow-label">Text Size</span>
          <input type="range" name="ttcTextScale" min="80" max="120" step="5" value="{{textScale}}" class="ncm-tc__slider" />
          <span class="ncm-tc__srow-val ncm-ttc-scale-val">{{textScale}}%</span>
        </div>
        <div class="ncm-tc__srow">
          <span class="ncm-tc__srow-label">Contrast</span>
          <input type="range" name="ttcContrast" min="70" max="140" step="5" value="{{contrast}}" class="ncm-tc__slider" />
          <span class="ncm-tc__srow-val ncm-ttc-contrast-val">{{contrast}}%</span>
        </div>
        <div class="ncm-cfg-hint" style="padding:0">Applies only to this terminal's window — the player's own Agent theme is untouched.</div>
      </div>
    </div>

    {{!-- BOOT & LOGIN — live splash preview + visual icon picker + login
         style cards + MOTD/welcome + screensaver. Chips/segments/cards mirror
         into hidden inputs bearing the ORIGINAL field names (the account-
         editor save-contract pattern), so _onSave reads one contract. --}}
    <div class="ncm-cfg-panel {{#if tabs.boot}}ncm-cfg-panel--active{{/if}}" data-panel="boot">

      {{#if presetKitLabel}}
        <div class="ncm-cfg-kitbar" style="margin-top:10px">
          <i class="fas fa-boxes-packing"></i>
          <span>Previewing the <strong>{{presetKitLabel}}</strong> kit — these fields update on <strong>Save</strong> (or pick "palette only" on the Theme tab).</span>
        </div>
      {{/if}}

      {{!-- ncm-ttc-live: this preview (like the Theme tab strips) receives the
           STAGED palette via _applyThemeLive — so a staged preset's colors
           show here, not the brand defaults. --}}
      <div class="ncm-cfg-bootprev ncm-ttc-live">
        <div class="ncm-cfg-bootprev-label"><i class="fas fa-eye"></i> LIVE PREVIEW — BOOT SPLASH
          <button type="button" class="ncm-cfg-bootprev-play" data-boot-replay data-tooltip="Replay the boot animation"><i class="fas fa-play"></i> REPLAY</button>
        </div>
        <div class="ncm-cfg-bootprev-splash">
          <div class="ncm-cfg-bootprev-icon" data-bp="icon"></div>
          <div class="ncm-cfg-bootprev-title" data-bp="title">{{bootTitle}}</div>
          <div class="ncm-cfg-bootprev-sub" data-bp="subtitle">{{bootSubtitle}}</div>
          <div class="ncm-cfg-bootprev-bar"><span></span></div>
          <div class="ncm-cfg-bootprev-log" data-bp="log">{{#each bootLogLines}}<div>{{this}}</div>{{/each}}</div>
        </div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-power-off ncm-cfg-section-icon" style="color:#00ff41"></i><div class="ncm-cfg-section-title">Boot Sequence</div><label class="ncm-cfg-toggle-label"><input type="checkbox" name="bootEnabled" {{#if bootEnabled}}checked{{/if}}></label></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Title</span><input type="text" name="bootTitle" class="ncm-cfg-input ncm-cfg-flex" value="{{bootTitle}}"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Subtitle</span><input type="text" name="bootSubtitle" class="ncm-cfg-input ncm-cfg-flex" value="{{bootSubtitle}}"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Login banner</span><input type="text" name="bootBanner" class="ncm-cfg-input ncm-cfg-flex" value="{{bootBanner}}"></div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-icons ncm-cfg-section-icon" style="color:#19f3f7"></i><div class="ncm-cfg-section-title">Boot Icon</div></div>
        <input type="hidden" name="bootIconMode" value="{{bootIconMode}}">
        <div class="ncm-cfg-bseg" data-boot-seg>
          {{#each bootIconModes}}<button type="button" class="ncm-cfg-bseg-btn{{#if selected}} is-on{{/if}}" data-icon-mode="{{value}}">{{label}}</button>{{/each}}
        </div>
        <div data-boot-icon-row="fa">
          <div class="ncm-cfg-icon-search"><i class="fas fa-magnifying-glass"></i><input type="text" data-icon-search placeholder='search icons… ("skull", "medical", "corp")'></div>
          <div class="ncm-cfg-icon-grid" data-icon-grid>
            {{#each iconLibrary}}<button type="button" class="ncm-cfg-icon-cell{{#if active}} is-on{{/if}}" data-icon-class="{{c}}" data-icon-k="{{k}}" data-tooltip="{{c}}"><i class="{{c}}"></i></button>{{/each}}
          </div>
          <div class="ncm-cfg-row" style="margin-top:6px"><span class="ncm-cfg-label">FA class</span>
            <input type="text" name="bootFaIcon" class="ncm-cfg-input ncm-cfg-flex" value="{{bootFaIcon}}" placeholder="or paste any Font Awesome class — fas fa-skull-crossbones…">
          </div>
        </div>
        <div data-boot-icon-row="image">
          <div class="ncm-cfg-row"><span class="ncm-cfg-label">Image</span>
            <input type="text" name="bootImageUrl" class="ncm-cfg-input ncm-cfg-flex" value="{{bootImageUrl}}" placeholder="Corporate logo, gang tag — any image file">
            <button type="button" data-action="browseBootImage" class="ncm-cfg-btn-icon" data-tooltip="Browse / upload"><i class="fas fa-folder-open"></i></button>
          </div>
          <div class="ncm-cfg-row"><label style="display:inline-flex;align-items:center;gap:6px;font-family:var(--ncm-font-mono);font-size:12px"><input type="checkbox" name="bootImageFree" {{#if bootImageFree}}checked{{/if}}> No frame — show the image at its natural shape (wide logos)</label></div>
          <div class="ncm-cfg-hint">Browse opens Foundry's file picker — upload straight from here. The splash preview above updates live. Framed = the themed icon square; no frame = just your image.</div>
        </div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-wand-magic-sparkles ncm-cfg-section-icon" style="color:#a855f7"></i><div class="ncm-cfg-section-title">Animation &amp; Log</div></div>
        <input type="hidden" name="bootAnimation" value="{{bootAnimation}}">
        <input type="hidden" name="bootSpeed" value="{{bootSpeed}}">
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Animation</span>
          <div class="ncm-cfg-chips" data-chip-group="bootAnimation">{{#each animationOptions}}<button type="button" class="ncm-cfg-chip{{#if selected}} is-on{{/if}}" data-chip="{{value}}" data-tooltip="{{hint}}">{{value}}</button>{{/each}}</div>
        </div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Speed</span>
          <div class="ncm-cfg-chips" data-chip-group="bootSpeed">{{#each speedOptions}}<button type="button" class="ncm-cfg-chip{{#if selected}} is-on{{/if}}" data-chip="{{value}}">{{value}}</button>{{/each}}</div>
        </div>
        <div class="ncm-cfg-row ncm-cfg-row--col"><span class="ncm-cfg-label" style="margin-bottom:4px">Log Lines</span>
          <div class="ncm-cfg-boot-log-list">{{#each bootLogLines}}<div class="ncm-cfg-boot-log-entry"><input type="text" name="bootLogLine" class="ncm-cfg-input" value="{{this}}"><button type="button" class="ncm-cfg-btn-icon ncm-cfg-btn-icon--danger" data-action="removeBootLogLine"><i class="fas fa-times"></i></button></div>{{/each}}</div>
          <div style="display:flex;gap:6px;margin-top:4px">
            <button type="button" data-action="addBootLogLine" class="ncm-cfg-btn-sm"><i class="fas fa-plus"></i> Add</button>
            <button type="button" data-action="generateBootLines" class="ncm-cfg-btn-sm" data-tooltip="Roll 4 random flavor lines"><i class="fas fa-dice"></i> Generate flavor lines</button>
          </div>
        </div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-right-to-bracket ncm-cfg-section-icon" style="color:#f7c948"></i><div class="ncm-cfg-section-title">Login Screen</div></div>
        <input type="hidden" name="loginStyle" value="{{loginStyleKey}}">
        <div class="ncm-cfg-lstyles">
          {{#each loginStyles}}
          <button type="button" class="ncm-cfg-lstyle{{#if active}} is-on{{/if}}" data-login-style="{{key}}" data-tooltip="{{hint}}">
            <i class="{{icon}}"></i><span>{{label}}</span>
          </button>
          {{/each}}
        </div>
        <div class="ncm-cfg-hint">How the login screen presents accounts — same security underneath, different machine personality. Keypad suits numeric passwords (door codes, vaults).</div>
        <div class="ncm-cfg-lprev-wrap">
          <div class="ncm-cfg-bootprev-label" style="margin:8px 0 5px"><i class="fas fa-eye"></i> LOGIN PREVIEW — uses this terminal's accounts</div>
          <div class="ncm-cfg-lprev ncm-ttc-live"></div>
        </div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">MOTD line</span><input type="text" name="loginMotd" class="ncm-cfg-input ncm-cfg-flex" value="{{loginMotd}}" placeholder="UNAUTHORIZED ACCESS WILL BE TRACED"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Welcome text</span><input type="text" name="loginWelcome" class="ncm-cfg-input ncm-cfg-flex" value="{{loginWelcome}}" placeholder="Custom ACCESS GRANTED line (blank = default)"></div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-volume-high ncm-cfg-section-icon" style="color:#c77bff"></i><div class="ncm-cfg-section-title">Sound Profile</div></div>
        <input type="hidden" name="soundSet" value="{{soundSetKey}}">
        <div class="ncm-cfg-lstyles">
          {{#each soundSets}}
          <button type="button" class="ncm-cfg-lstyle{{#if active}} is-on{{/if}}" data-sound-set="{{key}}" data-tooltip="{{hint}}">
            <i class="{{icon}}"></i><span>{{label}}</span>
          </button>
          {{/each}}
        </div>
        <div class="ncm-cfg-row" style="margin-top:6px">
          <button type="button" class="ncm-cfg-btn-sm" data-sound-audition data-tooltip="Play boot → login → denied through the selected profile"><i class="fas fa-play"></i> Audition selected profile</button>
        </div>
        <div class="ncm-cfg-hint">What this machine sounds like — boot, logins, denials, downloads. Same events, different voice: a corp suite chimes, a chopshop CRT growls. Applies on Save.</div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-moon ncm-cfg-section-icon" style="color:#4aa3ff"></i><div class="ncm-cfg-section-title">Idle Screensaver</div><label class="ncm-cfg-toggle-label"><input type="checkbox" name="ssEnabled" {{#if ssEnabled}}checked{{/if}}></label></div>
        <input type="hidden" name="ssIconMode" value="{{ssIconMode}}">
        <input type="hidden" name="ssMotion" value="{{ssMotion}}">
        <div class="ncm-cfg-ssprev ncm-ttc-live" data-ss-motion="{{ssMotion}}"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Idle seconds</span><input type="number" name="ssIdle" class="ncm-cfg-input ncm-cfg-input--short" value="{{ssIdle}}" min="10" max="3600" step="10"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Logo</span>
          <div class="ncm-cfg-bseg" style="margin:0">
            {{#each ssIconModes}}<button type="button" class="ncm-cfg-bseg-btn{{#if selected}} is-on{{/if}}" data-ss-mode="{{value}}">{{label}}</button>{{/each}}
          </div>
        </div>
        <div class="ncm-cfg-row" data-ss-row="fa"><span class="ncm-cfg-label">Icon class</span><input type="text" name="ssFaIcon" class="ncm-cfg-input ncm-cfg-flex" value="{{ssFaIcon}}" placeholder="fas fa-skull, fas fa-building…"></div>
        <div class="ncm-cfg-row" data-ss-row="image"><span class="ncm-cfg-label">Image</span>
          <input type="text" name="ssImageUrl" class="ncm-cfg-input ncm-cfg-flex" value="{{ssImageUrl}}" placeholder="logo / gang tag image file">
          <button type="button" data-action="browseSsImage" class="ncm-cfg-btn-icon" data-tooltip="Browse / upload"><i class="fas fa-folder-open"></i></button>
        </div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Marquee text</span><input type="text" name="ssText" class="ncm-cfg-input ncm-cfg-flex" value="{{ssText}}" placeholder="Blank = terminal name"></div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Motion</span>
          <div class="ncm-cfg-chips" data-chip-group="ssMotion">{{#each ssMotions}}<button type="button" class="ncm-cfg-chip{{#if selected}} is-on{{/if}}" data-chip="{{value}}">{{value}}</button>{{/each}}</div>
        </div>
        <div class="ncm-cfg-hint">After the idle time the mailbox dims to the logo + marquee above. Any click or keypress wakes it.</div>
      </div>
    </div>

    {{!-- NETWORK --}}
    <div class="ncm-cfg-panel {{#if tabs.network}}ncm-cfg-panel--active{{/if}}" data-panel="network">
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-network-wired ncm-cfg-section-icon" style="color:#19f3f7"></i><div class="ncm-cfg-section-title">Network Reachability</div><label class="ncm-cfg-toggle-label"><input type="checkbox" name="networkRequired" {{#if networkRequired}}checked{{/if}}></label></div>
        <div class="ncm-cfg-desc">When ON, this terminal is only reachable while the player is connected to an allowed network (Layer 0 gate). OFF = reachable anywhere.</div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Access mode</span><select name="accessMode" class="ncm-cfg-select ncm-cfg-flex">{{#each accessModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></div>
        <div class="ncm-cfg-row ncm-cfg-row--col"><span class="ncm-cfg-label" style="margin-bottom:4px">Allowed networks</span>
          <div>{{#each allNetworks}}<label style="display:inline-flex;align-items:center;gap:5px;margin:0 12px 6px 0;font-family:var(--ncm-font-mono);font-size:12px"><input type="checkbox" name="netAllowed" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}</div>
        </div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Signal threshold</span><input type="number" name="signalThreshold" class="ncm-cfg-input ncm-cfg-input--short" value="{{signalThreshold}}" min="0" max="100"> %</div>
      </div>

      {{!-- SCENE ACCESS POINT — drag-to-scene pin + proximity gate --}}
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-map-pin ncm-cfg-section-icon" style="color:#f7c948"></i><div class="ncm-cfg-section-title">Scene Access Point</div></div>
        <div class="ncm-cfg-desc">Drag this terminal from the Items directory onto a scene to place a clickable access point (a map pin wearing the item's art). Players double-click the pin to log in. Right-click the item for "Place on Current Scene".</div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Access range</span><input type="number" name="scenePinRange" class="ncm-cfg-input ncm-cfg-input--short" value="{{scenePinRange}}" min="0" max="50"> squares</div>
        <div class="ncm-cfg-hint">0 = no limit. Otherwise a player needs a token within this many grid squares of the pin to log in from the scene (a GM, or opening from the item itself, bypasses). Move or delete placed pins via the Journal Notes layer.</div>
      </div>

      {{!-- NETRUNNING RESOLUTION — per-box override of the world hackResolution --}}
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-dice-d10 ncm-cfg-section-icon" style="color:#b16dff"></i><div class="ncm-cfg-section-title">Netrunning Resolution</div></div>
        <div class="ncm-cfg-desc">HOW gated hacks on THIS box resolve — siphon, crack, decrypt, upload, exfil rolls. Override the table-wide setting (Admin → Security) for the odd machine: a Blackwall relay the table always runs live, a trivial kiosk that should just roll.</div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Resolve</span>
          <select name="hackResolution" class="ncm-cfg-input">
            {{#each hackResolutionModes}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select></div>
        <div class="ncm-cfg-hint">"GM adjudicates" = no auto-roll: the player's console waits while you call pass/fail at the table (you get a verdict prompt).</div>
      </div>

      {{!-- MACHINE UPLINK (Layer 1) — the terminal's OWN connection --}}
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-tower-broadcast ncm-cfg-section-icon" style="color:#4a9eff"></i><div class="ncm-cfg-section-title">Machine Uplink</div></div>
        <div class="ncm-cfg-desc">The terminal's OWN connection — the UPLINK pill in the viewer. Interfaces are the networks this machine's hardware can reach; network-gated accounts and messages only appear while the uplink matches. Independent of the reachability gate above and of the player's Agent network.</div>
        <div class="ncm-cfg-row ncm-cfg-row--col"><span class="ncm-cfg-label" style="margin-bottom:4px">Interfaces</span>
          <div>
            {{#each uplinkInterfaces}}
              <div style="display:flex;align-items:center;gap:14px;margin:0 0 6px;font-family:var(--ncm-font-mono);font-size:12px">
                <label style="display:inline-flex;align-items:center;gap:5px;min-width:150px"><input type="checkbox" name="uplinkIface" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>
                <label style="display:inline-flex;align-items:center;gap:5px;opacity:.8"><input type="checkbox" name="uplinkPre" value="{{id}}" {{#if preAuthorized}}checked{{/if}}> pre-authorized</label>
                <label style="display:inline-flex;align-items:center;gap:5px;opacity:.8"><input type="checkbox" name="uplinkWired" value="{{id}}" {{#if wired}}checked{{/if}}> <i class="fas fa-network-wired"></i> wired</label>
              </div>
            {{/each}}
          </div>
        </div>
        <div class="ncm-cfg-hint">Pre-authorized = the machine is already joined (switching is instant). Otherwise a secured network challenges the operator with that network's own security — and the machine remembers a successful join. Wired = a physical LAN drop: the signal bars always read full (hardline flavor — uplinks already ignore scene jamming).</div>
        <div class="ncm-cfg-row"><span class="ncm-cfg-label">Default uplink</span><select name="uplinkDefault" class="ncm-cfg-select ncm-cfg-flex">{{#each uplinkDefaults}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        <div class="ncm-cfg-hint">The boot-time connection. Must be a ticked interface, or it degrades to Local only.</div>
        <div class="ncm-cfg-row"><label style="display:inline-flex;align-items:center;gap:6px;font-family:var(--ncm-font-mono);font-size:12px"><input type="checkbox" name="uplinkAllowSwitch" {{#if uplinkAllowSwitch}}checked{{/if}}> Players can switch the uplink</label></div>
        <div class="ncm-cfg-row"><label style="display:inline-flex;align-items:center;gap:6px;font-family:var(--ncm-font-mono);font-size:12px"><input type="checkbox" name="uplinkSyncHint" {{#if uplinkSyncHint}}checked{{/if}}> Show a "objects failed to sync" hint when content is off-network</label></div>
      </div>
    </div>

    {{!-- EXFIL --}}
    <div class="ncm-cfg-panel {{#if tabs.exfil}}ncm-cfg-panel--active{{/if}}" data-panel="exfil">
      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-download ncm-cfg-section-icon" style="color:#f7c948"></i><div class="ncm-cfg-section-title">Exfiltration</div><label class="ncm-cfg-toggle-label"><input type="checkbox" name="allowExfil" {{#if allowExfil}}checked{{/if}}></label></div>
        <div class="ncm-cfg-desc">Master switch. OFF = read-only (no exfil at all). ON = the actions ticked below appear in the viewer. Each action can require a security roll — a miss trips a trace.</div>
      </div>

      <div class="ncm-cfg-section">
        <div class="ncm-cfg-section-header"><i class="fas fa-list-check ncm-cfg-section-icon" style="color:#19f3f7"></i><div class="ncm-cfg-section-title">Actions</div></div>
        <div class="ncm-cfg-exfil-rows">
          {{#each exfilRows}}
          <div class="ncm-cfg-exfil-row">
            <label class="ncm-cfg-exfil-on"><input type="checkbox" name="exfil{{cap}}Allow" {{#if allow}}checked{{/if}}> <i class="{{icon}}"></i> <span>{{label}}</span></label>
            <label class="ncm-cfg-exfil-req"><input type="checkbox" name="exfil{{cap}}Require" {{#if require}}checked{{/if}}> roll</label>
            <select name="exfil{{cap}}Skill" class="ncm-cfg-input ncm-cfg-exfil-skill" data-tooltip="Skill for the security roll">
              {{#each skillOptions}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select>
            <span class="ncm-cfg-exfil-dvl">DV</span><input type="number" name="exfil{{cap}}Dv" class="ncm-cfg-input ncm-cfg-exfil-dv" value="{{dv}}" min="1" max="30">
            {{#if isSell}}<span class="ncm-cfg-exfil-dvl">price</span><input type="number" name="exfilSellPrice" class="ncm-cfg-input ncm-cfg-exfil-price" value="{{../exfilSellPrice}}" min="0" step="50" data-tooltip="Eddies the fixer pays">{{/if}}
          </div>
          {{/each}}
        </div>
        <div class="ncm-cfg-hint"><b>To my Agent</b> = download to the player's exfil folder (renameable in Module Settings). <b>Burn to Shard</b> = physical copy. <b>Forward</b> = send to a contact. <b>Leak</b> = public Net dump (chat card). <b>Sell</b> = eddies to the operator. <b>Wipe</b> = delete the original. <b>Save Frame</b> (camera feeds only) = capture what a channel is showing — you can't copy a live stream. Leaving “roll” unticked = the action just needs a confirm.</div>
      </div>
    </div>

  </div>
</div>
