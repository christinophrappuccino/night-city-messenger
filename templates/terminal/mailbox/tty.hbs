{{!-- Mailbox style "tty" (2026-10-25, dev-approved mock, style 2): one monospace column.
      The folder is the working directory, the list is an `ls`, an open message prints
      below after `cat`, and the prompt at the bottom takes a number / m / f / cd <name> /
      n / p / ? (TerminalViewerApp._onTtyCommand). Rows are still data-actions, so the
      mouse works too. The HUD above keeps every mechanic; the detail is the shared partial. --}}
<div class="ncm-tmtty">
  <div class="ncm-tmtty__scroll">
    <div class="ncm-tmtty__ln ncm-tmtty__dim">{{terminalName}} · {{#if isFilesView}}files{{else}}mailbox{{/if}} mounted · logged in as {{account.username}} · type <b>?</b> for help · <span class="ncm-tmtty__lnk" data-action="terminalLogout">logout</span></div>
    <div class="ncm-tmtty__ln"><span class="ncm-tmtty__p">{{ttyPrompt}}</span> <span class="ncm-tmtty__cmd">ls{{#if isFilesView}} -l{{/if}}</span></div>
    {{#if isFilesView}}
      {{#with fs.listing}}
        <div class="ncm-tmtty__hd ncm-tmtty__grid ncm-tmtty__grid--f"><span>#</span><span>NAME</span><span>TYPE</span><span>SIZE</span><span>MODIFIED</span></div>
        {{#if parent}}<div class="ncm-tmtty__row ncm-tmtty__grid ncm-tmtty__grid--f" data-action="terminalFsOpen" data-scope="{{parent.scope}}" data-path="{{parent.path}}"><span>..</span><span>../</span><span class="ncm-tmtty__dim">dir</span><span></span><span></span></div>{{/if}}
        {{#each subdirs}}<div class="ncm-tmtty__row ncm-tmtty__grid ncm-tmtty__grid--f{{#if locked}} is-locked{{/if}}" data-action="terminalFsOpen" data-scope="{{scope}}" data-path="{{path}}"{{#if locked}} data-locked="1" data-lock-label="{{lockLabel}}"{{/if}}><span>d</span><span>{{name}}/</span><span class="ncm-tmtty__dim">{{#if locked}}<span class="ncm-tmtty__lock">{{lockLabel}}</span>{{else}}dir · {{count}}{{/if}}</span><span>{{#unless locked}}{{size}}{{/unless}}</span><span></span></div>{{/each}}
        {{#each files}}<div class="ncm-tmtty__row ncm-tmtty__grid ncm-tmtty__grid--f{{#if isSelected}} is-sel{{/if}}{{#if isNew}} is-new{{/if}}" data-action="terminalSelectMessage" data-message-id="{{messageId}}"><span>{{add @index 1}}</span><span>{{filename}}{{#if encrypted}} <i class="fas fa-lock ncm-tmtty__lock"></i>{{/if}}</span><span class="ncm-tmtty__dim">{{typeLabel}}</span><span>{{#if isStream}}LIVE{{else}}{{fileSize}}{{/if}}</span><span>{{modified}}</span></div>{{/each}}
        {{#if locked}}<div class="ncm-tmtty__ln ncm-tmtty__lock">ls: cannot open directory: ACCESS DENIED — {{lockLabel}}</div>{{/if}}
        {{#if empty}}<div class="ncm-tmtty__ln ncm-tmtty__dim">(empty)</div>{{/if}}
        <div class="ncm-tmtty__ln ncm-tmtty__dim">{{stats.files}} file{{#unless (eq stats.files 1)}}s{{/unless}} · {{stats.size}} · <b>m</b> = mail · <b>cd ..</b> = up</div>
      {{/with}}
    {{else}}
      <div class="ncm-tmtty__hd ncm-tmtty__grid"><span>#</span><span>FROM</span><span>DATE</span><span>SUBJECT</span><span></span></div>
      {{#each messages}}
        <div class="ncm-tmtty__row ncm-tmtty__grid{{#if isSelected}} is-sel{{/if}}{{#if isNew}} is-new{{/if}}" data-action="terminalSelectMessage" data-message-id="{{messageId}}"><span>{{add @index 1}}</span><span>{{#if isFile}}{{filename}}{{else}}{{from}}{{/if}}</span><span>{{time}}</span><span>{{#if isFile}}[{{typeLabel}}]{{else}}{{subject}}{{/if}}{{#if encrypted}} <i class="fas fa-lock ncm-tmtty__lock"></i>{{/if}}</span><span class="ncm-tmtty__dim">{{#if priority}}{{#unless (eq priority 'normal')}}{{priority}}{{/unless}}{{/if}}</span></div>
      {{else}}
        <div class="ncm-tmtty__ln ncm-tmtty__dim">{{emptyLabel}}</div>
      {{/each}}
      <div class="ncm-tmtty__ln ncm-tmtty__dim">{{messages.length}} shown{{#if pagination}} · page {{pagination.page}}/{{pagination.maxPage}} (<b>n</b>/<b>p</b>){{/if}} · folders: {{#each folders}}{{#if active}}<b>{{label}}</b>{{else}}{{label}}{{/if}} {{/each}}· <b>f</b> = files ({{view.files}})</div>
      {{#if syncHint}}<div class="ncm-tmtty__ln ncm-tmtty__lock">{{syncHint.count}} object{{#unless (eq syncHint.count 1)}}s{{/unless}} failed to sync — uplink required</div>{{/if}}
    {{/if}}
    {{#if selectedMessage}}
      <div class="ncm-tmtty__ln" style="margin-top:8px"><span class="ncm-tmtty__p">{{ttyPrompt}}</span> <span class="ncm-tmtty__cmd">cat {{#if selectedMessage.isFile}}{{selectedMessage.file.filename}}{{else}}{{selectedMessage.subject}}{{/if}}</span></div>
      <div class="ncm-term__detail ncm-tmtty__out">
        {{> "modules/night-city-messenger/templates/terminal/mailbox/detail.hbs"}}
      </div>
    {{/if}}
    {{#if isGM}}<div class="ncm-tmtty__ln ncm-tmtty__dim" style="margin-top:8px"><span class="ncm-term__gm-add ncm-tmtty__gm" data-action="terminalNewMessage"><i class="fas fa-plus"></i> {{#if isFilesView}}add a file here (GM){{else}}add message or file (GM)</span>{{/if}}</div>{{/if}}
  </div>
  <div class="ncm-tmtty__in">
    <span class="ncm-tmtty__p">{{ttyPrompt}}</span>
    <input type="text" class="ncm-tmtty__cmd-in" data-tty-prompt autocomplete="off" spellcheck="false" aria-label="command">
    <span class="ncm-tmtty__help">number = open · m = mail · f = files · cd &lt;folder&gt; · n/p = page · logout · ? = help</span>
  </div>
</div>
