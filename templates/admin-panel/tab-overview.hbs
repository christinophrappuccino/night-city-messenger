    {{#if (eq activeTab 'overview')}}{{#if ov}}
    {{!-- ADMIN OVERVIEW — THE NOW LINE (rebuilt 2026-10-28, dev-approved Version B of
          dev/mockups/admin-overview-rethink-mock.html). ONE vertical timeline owns the tab:
          the past above a fixed NOW line, what is waiting ON it (the needs-you queue as chips
          by kind), the future below (every timer by time-to-go), and a dock on the right
          (clock + scene, the players, quick actions, tiles). Context = OverviewTab.prepareContext
          → ov; the layout is utils/overviewModel.js nowLineLayout. A DOM clock
          (OverviewTab._tickRunway) moves the future rows between renders. --}}
    <div class="ncm-ov2">

      <header class="ncm-tabhd"><i class="fas fa-gauge-high"></i><div><h2>Overview</h2><p>What just happened, what is waiting on you, and what is about to land — on one line — with the table beside it.</p></div></header>

      <div class="ncm-ov2-grid">

        {{!-- ═══ THE INSTRUMENT ═══ --}}
        <div class="ncm-ov2-mod ncm-ov2-nl" data-nl-zoom="{{ov.nl.zoom}}" data-nl-now="{{ov.nl.now}}">
          <div class="ncm-ov2-mod__k"><i class="fas fa-timeline"></i>Session line<span class="ncm-ov2-mod__hint">past above · now · future below</span>
            <span class="ncm-ov2-zoom" role="group" aria-label="How far ahead">{{#each ov.nl.zooms}}<button type="button" class="ncm-ov2-zoom__b{{#if on}} is-on{{/if}}" data-action="tabAct" data-owner="overview" data-op="rwZoom" data-zoom="{{min}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}" data-tooltip="The next {{label}}">{{label}}</button>{{/each}}</span>
          </div>
          <div class="ncm-ov2-nl__legend">
            {{#each ov.nl.legend}}<button type="button" class="ncm-ov2-nl__key{{#if off}} is-off{{/if}}{{#unless count}} is-none{{/unless}}" style="--tc:{{tc}}" data-action="tabAct" data-owner="overview" data-op="rwLane" data-kind="{{kind}}" aria-pressed="{{#if off}}false{{else}}true{{/if}}" data-tooltip="Hide or show {{label}}"><i class="fas {{icon}}"></i>{{short}}<b>{{count}}</b></button>{{/each}}
            <span class="ncm-ov2-nl__sum">{{#if ov.nl.counts.bad}}<b class="is-bad">{{ov.nl.counts.bad}}</b> under 10 min · {{/if}}{{#if ov.nl.counts.attn}}<b class="is-attn">{{ov.nl.counts.attn}}</b> this hour · {{/if}}<b>{{ov.nl.counts.total}}</b> timer{{#unless (eq ov.nl.counts.total 1)}}s{{/unless}}</span>
          </div>
          <div class="ncm-ov2-nl__body">
            <div class="ncm-ov2-nl__axis">{{#each ov.nl.axis}}<span class="ncm-ov2-nl__tick{{#if isNow}} is-now{{/if}}{{#if past}} is-past{{/if}}" style="top:{{pct}}%">{{label}}</span>{{/each}}</div>
            <div class="ncm-ov2-nl__track">
              <div class="ncm-ov2-nl__pastzone" style="height:{{ov.nl.nowPct}}%"></div>
              <div class="ncm-ov2-nl__zone is-attn" style="top:{{ov.nl.nowPct}}%;height:{{ov.nl.zoneAttn}}%"></div>
              <div class="ncm-ov2-nl__zone is-bad" style="top:{{ov.nl.nowPct}}%;height:{{ov.nl.zoneBad}}%"></div>

              {{!-- the past: newest nearest the line --}}
              {{#each ov.nl.past}}
              <div class="ncm-ov2-nl__ev is-past{{#if far}} is-far{{/if}}" style="--tc:{{tc}};top:{{top}}%" data-nl-ev="p" data-ts="{{ts}}"{{#if subline}} data-tooltip="{{subline}}"{{/if}}>
                <i class="fas {{icon}}"></i><span class="ncm-ov2-nl__tx">{{{html}}}</span><span class="ncm-ov2-nl__t" data-nl-ago>{{ago}}</span>
              </div>
              {{/each}}
              {{#if ov.nl.pastMore}}<button type="button" class="ncm-ov2-nl__more is-top" data-action="tabAct" data-owner="overview" data-op="nlEarlier" data-tooltip="Older than the line shows — All mail has every message by date; the Security tab keeps the trace log">+{{ov.nl.pastMore}} earlier</button>{{/if}}

              {{!-- NOW --}}
              <div class="ncm-ov2-nl__now" style="top:{{ov.nl.nowPct}}%"><b>NOW · <span data-nl-clock>{{ov.nl.nowClock}}</span></b></div>
              <div class="ncm-ov2-nl__onnow" style="top:{{ov.nl.nowPct}}%">
                {{#each ov.nl.chips}}<button type="button" class="ncm-ov2-nl__wait is-{{tone}}{{#if on}} is-on{{/if}}" data-action="ovNeedFilter" data-filter="{{kind}}" aria-expanded="{{#if on}}true{{else}}false{{/if}}" data-tooltip="{{count}} — click to see them"><i class="fas {{icon}}"></i>{{label}}<span class="ncm-ov2-nl__n">{{count}}</span></button>{{else}}<span class="ncm-ov2-nl__calm"><i class="fas fa-circle-check"></i>nothing is waiting on you</span>{{/each}}
              </div>

              {{!-- the open chip's items, under the line --}}
              {{#if ov.nl.open}}
              <div class="ncm-ov2-nl__open is-{{ov.nl.openTone}}" style="top:{{ov.nl.openTop}}%">
                <div class="ncm-ov2-nl__open-h"><b>{{ov.nl.openLabel}}</b><span>{{ov.nl.openItems.length}} of {{ov.nl.needTotal}} waiting · ranked</span><span class="ncm-ov2-sp"></span><button type="button" class="ncm-ov2-btn ncm-ov2-btn--ghost" data-action="ovClearAlerts" data-tooltip="Dismiss these — they come back if they change">Dismiss all</button><button type="button" class="ncm-ov2-need__x" data-action="ovNeedFilter" data-filter="all" aria-label="Close"><i class="fas fa-xmark"></i></button></div>
                <div class="ncm-ov2-scroll ncm-ov2-scroll--needs">
                  {{#each ov.nl.openItems}}
                  <div class="ncm-ov2-need ncm-ov2-k--{{kind}}{{#if @first}} is-top{{/if}}" data-alert-key="{{dismissKey}}">
                    <span class="ncm-ov2-need__ic"><i class="fas {{icon}}"></i></span>
                    <div class="ncm-ov2-need__b"><div class="ncm-ov2-need__t">{{{html}}}</div>{{#if subline}}<div class="ncm-ov2-need__s">{{{subline}}}</div>{{/if}}</div>
                    <div class="ncm-ov2-need__a">
                      {{#each actions}}<button type="button" class="ncm-ov2-btn{{#if primary}} ncm-ov2-btn--pri{{/if}}{{#if danger}} ncm-ov2-btn--danger{{/if}}" data-action="{{action}}"{{#each dataAttrs}} data-{{k}}="{{v}}"{{/each}}>{{label}}</button>{{/each}}
                    </div>
                    <button type="button" class="ncm-ov2-need__x" data-action="ovDismissAlert" data-tooltip="Dismiss — it comes back if it changes" aria-label="Dismiss"><i class="fas fa-xmark"></i></button>
                  </div>
                  {{/each}}
                </div>
              </div>
              {{/if}}

              {{!-- the future: every timer by time-to-go, each with its own buttons --}}
              {{#each ov.nl.future}}
              <div class="ncm-ov2-nl__ev is-future{{#if urg}} is-{{urg}}{{/if}}{{#if sel}} is-sel{{/if}}" style="--tc:{{tc}};--mc:{{mc}};top:{{top}}%" data-nl-ev="f" data-timer-id="{{id}}" data-at="{{at}}" data-top="{{top}}">
                <i class="fas {{icon}}"></i>
                <button type="button" class="ncm-ov2-nl__tx ncm-ov2-nl__pick" data-action="tabAct" data-owner="overview" data-op="rwPick" aria-expanded="{{#if sel}}true{{else}}false{{/if}}" data-tooltip="{{kindShort}}{{#if subline}} · {{subline}}{{/if}} — click for the facts"><b>{{kindShort}}</b> {{name}}</button>
                <em class="ncm-ov2-nl__t" data-nl-left>{{leftLabel}}</em>
                <span class="ncm-ov2-nl__acts">{{#each actions}}<button type="button" class="ncm-ov2-btn ncm-ov2-btn--sm{{#if (eq tone 'pri')}} ncm-ov2-btn--pri{{/if}}{{#if (eq tone 'bad')}} ncm-ov2-btn--danger{{/if}}" data-action="{{action}}"{{#each dataAttrs}} data-{{k}}="{{v}}"{{/each}} data-tooltip="{{label}}"><i class="fas {{icon}}"></i>{{label}}</button>{{/each}}</span>
                {{#if sel}}<div class="ncm-ov2-nl__facts">{{#if subline}}<span class="ncm-ov2-nl__facts-sub">{{subline}}</span>{{/if}}{{#each lines}}<span class="ncm-ov2-nl__fk">{{k}}</span><span class="ncm-ov2-nl__fv{{#if mono}} is-mono{{/if}}">{{v}}</span>{{/each}}</div>{{/if}}
              </div>
              {{/each}}
              {{#if ov.nl.later}}{{#if ov.nl.laterZoom}}<button type="button" class="ncm-ov2-nl__more is-end" data-action="tabAct" data-owner="overview" data-op="rwZoom" data-zoom="{{ov.nl.laterZoom}}" data-tooltip="Past the edge — zoom out to see them">+{{ov.nl.later}} later</button>{{else}}<span class="ncm-ov2-nl__more is-end is-flat" data-tooltip="More than a day away, or no room on the line">+{{ov.nl.later}} later</span>{{/if}}{{/if}}

              {{#if ov.nl.empty}}<div class="ncm-ov2-nl__empty">Quiet. Mail, hacks and logins show above the line as they happen; timers land below it.</div>{{/if}}
            </div>
          </div>
        </div>

        {{!-- ═══ THE DOCK ═══ --}}
        <div class="ncm-ov2-dock">
          <button type="button" class="ncm-ov2-guide" data-action="tabAct" data-owner="overview" data-op="qGuide" data-tooltip="Open the Getting Started guide (PDF) in a new tab"><i class="fas fa-book-open"></i><span><b>Guide</b><small>How everything works</small></span><i class="fas fa-up-right-from-square ncm-ov2-guide__go"></i></button>

          <div class="ncm-ov2-clockcard" data-tooltip="Game time · {{ov.clock}}">
            <b class="ncm-ov2-clockcard__t">{{ov.time}}</b><small class="ncm-ov2-clockcard__d">{{ov.date}}</small>
            {{#if ov.sceneName}}<div class="ncm-ov2-clockcard__scn{{#if ov.sceneDead}} is-dead{{/if}}" style="--tc:{{ncm-hue ov.sceneName}}"><i class="fas {{#if ov.sceneDead}}fa-ban{{else}}fa-map{{/if}}"></i><span>{{ov.sceneName}}</span>{{#if ov.sceneDead}}<span class="ncm-tagp is-bad">dead zone</span>{{/if}}</div>{{/if}}
          </div>

          {{!-- the players, compact (rules: overviewModel.assessPlayer; click a row → why + fixes) --}}
          <div class="ncm-ov2-mod">
            <div class="ncm-ov2-mod__k"><i class="fas fa-users"></i>At the table{{#if ov.table.hasPlayers}}<span class="ncm-ov2-mod__n{{#if ov.table.need}} is-attn{{/if}}">{{#if ov.table.need}}{{ov.table.need}} need you{{else}}{{ov.table.online}} online{{/if}}</span>{{/if}}</div>
            <div class="ncm-ov2-ppl ncm-ov2-scroll ncm-ov2-scroll--table">
              {{#each ov.table.players}}
              <div class="ncm-ov2-pp is-{{tone}}{{#if isOpen}} is-open{{/if}}" data-action="tabAct" data-owner="overview" data-op="tblToggle" data-user-id="{{userId}}" role="button" tabindex="0" aria-expanded="{{#if isOpen}}true{{else}}false{{/if}}" data-tooltip="{{status}} — click for why">
                <span class="ncm-ov2-pl__face"><span class="ncm-ov2-pl__av" style="--tc:{{hue}}">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initials}}{{/if}}</span><span class="ncm-ov2-av__dot{{#if online}} is-on{{/if}}"></span>{{#if unread}}<span class="ncm-ov2-badge">{{unread}}</span>{{/if}}</span>
                <span class="ncm-ov2-pp__nm">{{name}}<small>{{playerName}}{{#if sceneName}} · {{sceneName}}{{else if online}} · no scene{{/if}}{{#if held}} · <span class="is-warn">{{held}} held</span>{{/if}}{{#unless address}} · <span class="is-bad">no address</span>{{/unless}}</small></span>
                <span class="ncm-ov2-pp__net{{#if dead}} is-nosig{{else if onNet}} is-net{{#if weak}} is-weak{{/if}}{{else if online}} is-none{{else}} is-off{{/if}}" style="--nc:{{netHue}}">{{#if dead}}<i class="fas fa-ban"></i>no signal{{else if onNet}}<span class="ncm-ov2-sig">{{#each bars}}<i{{#if on}} class="is-on"{{/if}}></i>{{/each}}</span>{{network}}{{else if online}}—{{else}}offline{{/if}}</span>
              </div>
              {{#if isOpen}}
              <div class="ncm-ov2-why" data-user-id="{{userId}}" data-actor-id="{{actorId}}">
                <div class="ncm-ov2-why__h">{{name}} — {{#if (eq tone 'ok')}}ready to go{{else}}{{status}}{{/if}}<button type="button" class="ncm-ov2-why__x" data-action="tabAct" data-owner="overview" data-op="tblClose" aria-label="Close"><i class="fas fa-xmark"></i></button></div>
                <ul class="ncm-ov2-why__ul">{{#each facts}}<li class="is-{{tone}}"><i class="fas {{icon}}"></i><span>{{{html}}}</span></li>{{/each}}</ul>
                {{#if actorId}}
                <div class="ncm-ov2-why__go">
                  {{#each fixes}}<button type="button" class="ncm-ov2-btn ncm-ov2-btn--sm{{#if primary}} ncm-ov2-btn--pri{{/if}}" data-action="tabAct" data-owner="overview" data-op="{{op}}"{{#if groupId}} data-group-id="{{groupId}}"{{/if}}>{{label}}</button>{{/each}}
                  <span class="ncm-ov2-sp"></span>
                  <button type="button" class="ncm-ov2-btn ncm-ov2-btn--sm" data-action="tabAct" data-owner="overview" data-op="tblInbox" data-tooltip="Open their inbox" aria-label="Open their inbox"><i class="fas fa-inbox"></i></button>
                  <button type="button" class="ncm-ov2-btn ncm-ov2-btn--sm" data-action="tabAct" data-owner="overview" data-op="tblWrite" data-tooltip="Write to them" aria-label="Write to them"><i class="fas fa-envelope"></i></button>
                  <button type="button" class="ncm-ov2-btn ncm-ov2-btn--sm" data-action="tabAct" data-owner="overview" data-op="tblContacts" data-tooltip="Their contacts" aria-label="Their contacts"><i class="fas fa-address-book"></i></button>
                </div>
                {{/if}}
              </div>
              {{/if}}
              {{else}}
              <div class="ncm-ov2-empty">No players in this world yet.</div>
              {{/each}}
            </div>
          </div>

          {{!-- QUICK --}}
          <div class="ncm-ov2-mod">
            <div class="ncm-ov2-mod__k"><i class="fas fa-bolt"></i>Quick</div>
            <div class="ncm-ov2-quick">
              <button type="button" class="ncm-ov2-btn ncm-ov2-btn--pri" data-action="openComposer"><i class="fas fa-pen"></i>Write</button>
              <button type="button" class="ncm-ov2-btn" data-action="openGMContacts"><i class="fas fa-user-plus"></i>Contact</button>
              <button type="button" class="ncm-ov2-btn" data-action="ovBroadcast" data-tooltip="Network Broadcast lives on the Networks tab"><i class="fas fa-tower-broadcast"></i>Broadcast</button>
              <button type="button" class="ncm-ov2-btn" data-action="tabAct" data-owner="overview" data-op="qInbox" data-tooltip="Open a player character's inbox"><i class="fas fa-inbox"></i>Inbox</button>
              <button type="button" class="ncm-ov2-btn" data-action="tabAct" data-owner="overview" data-op="qPush" data-tooltip="Share a directory contact with a player character"><i class="fas fa-share"></i>Push contact</button>
              <button type="button" class="ncm-ov2-btn" data-action="tabAct" data-owner="overview" data-op="qShard" data-tooltip="A blank shard as a new world item, straight into Configure"><i class="fas fa-microchip"></i>New shard</button>
              <div class="ncm-ov2-quick__row">
                <button type="button" class="ncm-ov2-btn" data-action="openTimeSettings"><i class="fas fa-clock"></i>Set time</button>
                <button type="button" class="ncm-ov2-btn" data-action="tabAct" data-owner="overview" data-op="qClock" data-add="3600" data-tooltip="Advance the game clock one hour">+1 h</button>
                <button type="button" class="ncm-ov2-btn" data-action="tabAct" data-owner="overview" data-op="qClock" data-add="86400" data-tooltip="Advance the game clock one day">+1 day</button>
              </div>
            </div>
          </div>

          {{!-- TILES → their tab --}}
          <div class="ncm-ov2-mod">
            <div class="ncm-ov2-tiles">
              {{#each ov.tiles}}
              <div class="ncm-ov2-tile{{#if bad}} is-bad{{/if}}" style="--c:{{color}}" data-action="switchTab" data-tab="{{tab}}" data-tooltip="{{label}}: {{#each lines}}{{{this}}}{{/each}}{{#if bad}} · {{bad}}{{/if}} — open the tab" role="button" tabindex="0">
                <b class="ncm-ov2-tile__n{{#if bad}} is-bad{{/if}}">{{n}}</b><span class="ncm-ov2-tile__l">{{label}}</span>{{#if bad}}<span class="ncm-ov2-tile__bad">{{bad}}</span>{{/if}}
              </div>
              {{/each}}
            </div>
          </div>

        </div>
      </div>

    </div>
    {{/if}}{{/if}}
