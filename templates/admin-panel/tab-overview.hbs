    {{#if (eq activeTab 'overview')}}{{#if ov}}
    {{!-- ADMIN OVERVIEW (rebuilt 2026-10-26, dev-approved mock
          dev/mockups/admin-overview-redesign-mock.html). "What needs me" + "the
          state of the table". Context = OverviewTab.prepareContext → ov; the rules
          are utils/overviewModel.js. Long lists scroll inside their own box. --}}
    <div class="ncm-ov2">

      {{!-- §0 quick actions + the clock --}}
      <div class="ncm-ov2-top">
        <button type="button" class="ncm-ov2-btn ncm-ov2-btn--pri" data-action="openComposer"><i class="fas fa-pen-to-square"></i> Compose</button>
        <button type="button" class="ncm-ov2-btn" data-action="ovBroadcast"><i class="fas fa-tower-broadcast"></i> Broadcast</button>
        <button type="button" class="ncm-ov2-btn" data-action="openGMContacts"><i class="fas fa-address-book"></i> Contacts</button>
        <button type="button" class="ncm-ov2-btn" data-action="openNetworkManager"><i class="fas fa-network-wired"></i> Networks</button>
        <button type="button" class="ncm-ov2-btn" data-action="ovNewShard"><i class="fas fa-microchip"></i> New shard</button>
        <span class="ncm-ov2-sp"></span>
        <span class="ncm-ov2-clock"><i class="fa-regular fa-clock"></i> <b>{{ov.clock}}</b>{{#if ov.sceneName}} · Scene: <b{{#if ov.sceneDead}} class="is-dead"{{/if}}>{{ov.sceneName}}</b>{{#if ov.sceneDead}} <span class="is-dead">(dead zone)</span>{{/if}}{{/if}}</span>
      </div>

      {{!-- §1 NEEDS YOU — one ranked, actionable queue --}}
      <section>
        <div class="ncm-ov2-h"><i class="fas fa-bell"></i> Needs you <small>ranked — the top one is the most urgent</small><span class="ncm-ov2-sp"></span>{{#if ov.hasNeeds}}<button type="button" class="ncm-ov2-btn ncm-ov2-btn--ghost" data-action="ovClearAlerts">Dismiss all</button>{{/if}}</div>
        <div class="ncm-ov2-card">
          {{#if ov.hasNeeds}}
            <div class="ncm-ov2-bar">
              <span class="ncm-ov2-chip{{#if (eq ov.needFilter 'all')}} is-on{{/if}}" data-action="ovNeedFilter" data-filter="all">All <b>{{ov.needCounts.all}}</b></span>
              <span class="ncm-ov2-chip{{#if (eq ov.needFilter 'mail')}} is-on{{/if}}" data-action="ovNeedFilter" data-filter="mail"><i class="fas fa-envelope"></i> Mail <b>{{ov.needCounts.mail}}</b></span>
              <span class="ncm-ov2-chip{{#if (eq ov.needFilter 'sec')}} is-on{{/if}}" data-action="ovNeedFilter" data-filter="sec"><i class="fas fa-shield-halved"></i> Security <b>{{ov.needCounts.sec}}</b></span>
              <span class="ncm-ov2-chip{{#if (eq ov.needFilter 'money')}} is-on{{/if}}" data-action="ovNeedFilter" data-filter="money"><i class="fas fa-microchip"></i> Shards <b>{{ov.needCounts.money}}</b></span>
              <span class="ncm-ov2-chip{{#if (eq ov.needFilter 'setup')}} is-on{{/if}}" data-action="ovNeedFilter" data-filter="setup"><i class="fas fa-screwdriver-wrench"></i> Setup &amp; timers <b>{{ov.needCounts.setup}}</b></span>
            </div>
            <div class="ncm-ov2-scroll ncm-ov2-scroll--needs">
              {{#each ov.needs}}
                <div class="ncm-ov2-need ncm-ov2-k--{{kind}}" data-alert-key="{{dismissKey}}">
                  <span class="ncm-ov2-need__ic"><i class="fas {{icon}}"></i></span>
                  <div class="ncm-ov2-need__b"><div class="ncm-ov2-need__t">{{{html}}}</div>{{#if subline}}<div class="ncm-ov2-need__s">{{{subline}}}</div>{{/if}}</div>
                  <div class="ncm-ov2-need__a">
                    {{#each actions}}<button type="button" class="ncm-ov2-btn{{#if primary}} ncm-ov2-btn--pri{{/if}}{{#if danger}} ncm-ov2-btn--danger{{/if}}" data-action="{{action}}"{{#each dataAttrs}} data-{{k}}="{{v}}"{{/each}}>{{label}}</button>{{/each}}
                  </div>
                  <button type="button" class="ncm-ov2-need__x" data-action="ovDismissAlert" data-tooltip="Dismiss — it comes back if it changes" aria-label="Dismiss"><i class="fas fa-xmark"></i></button>
                </div>
              {{else}}
                <div class="ncm-ov2-empty">Nothing under this filter.</div>
              {{/each}}
            </div>
          {{else}}
            <div class="ncm-ov2-empty"><i class="fas fa-circle-check"></i> Nothing needs you right now.</div>
          {{/if}}
        </div>
      </section>

      {{!-- §2 AT THE TABLE --}}
      <section>
        <div class="ncm-ov2-h"><i class="fas fa-users"></i> At the table <small>who is here, as whom, on which network</small></div>
        <div class="ncm-ov2-card ncm-ov2-table">
          {{#each ov.table}}
            <div class="ncm-ov2-who{{#unless online}} is-off{{/unless}}">
              <span class="ncm-ov2-av" style="color:{{color}}">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initials}}{{/if}}<span class="ncm-ov2-av__dot{{#if online}} is-on{{/if}}"></span></span>
              <div class="ncm-ov2-who__t"><div class="ncm-ov2-who__n">{{name}}</div><div class="ncm-ov2-who__s">{{userName}}{{#if network}} · <span class="ncm-ov2-mono">{{network}}</span>{{/if}}{{#unless online}} · offline{{/unless}}</div></div>
              <span class="ncm-ov2-badge{{#unless unread}} is-zero{{/unless}}" data-tooltip="Unread in their Agent">{{unread}}</span>
            </div>
          {{else}}
            <div class="ncm-ov2-empty">No players in this world yet.</div>
          {{/each}}
        </div>
      </section>

      {{!-- §3 THE STATE OF THINGS --}}
      <section>
        <div class="ncm-ov2-h"><i class="fas fa-gauge"></i> The state of things <small>click a tile to open its tab</small></div>
        <div class="ncm-ov2-tiles">
          {{#each ov.tiles}}
            <div class="ncm-ov2-card ncm-ov2-tile" style="--c:{{color}}" data-action="switchTab" data-tab="{{tab}}" data-tooltip="Open {{label}}">
              <div class="ncm-ov2-tile__h"><i class="fas {{icon}}"></i> {{label}}</div>
              <div class="ncm-ov2-tile__n">{{n}}</div>
              <div class="ncm-ov2-tile__f">{{#each lines}}{{{this}}}{{/each}}{{#if bad}}<br><span class="is-bad">{{bad}}</span>{{/if}}</div>
            </div>
          {{/each}}
        </div>
      </section>

      {{!-- §4 RECENT ACTIVITY (durable) + COMING UP --}}
      <section class="ncm-ov2-cols">
        <div>
          <div class="ncm-ov2-h"><i class="fas fa-stream"></i> Recent activity <small>saved mail + the Security log</small></div>
          <div class="ncm-ov2-card">
            {{#if ov.hasFeed}}
              <div class="ncm-ov2-bar">
                <span class="ncm-ov2-chip{{#if (eq ov.feedFilter 'all')}} is-on{{/if}}" data-action="ovFeedFilter" data-filter="all">All</span>
                <span class="ncm-ov2-chip{{#if (eq ov.feedFilter 'mail')}} is-on{{/if}}" data-action="ovFeedFilter" data-filter="mail">Mail</span>
                <span class="ncm-ov2-chip{{#if (eq ov.feedFilter 'hack')}} is-on{{/if}}" data-action="ovFeedFilter" data-filter="hack">Terminals &amp; hacks</span>
                <span class="ncm-ov2-chip{{#if (eq ov.feedFilter 'shard')}} is-on{{/if}}" data-action="ovFeedFilter" data-filter="shard">Shards</span>
              </div>
              <div class="ncm-ov2-scroll ncm-ov2-scroll--feed">
                {{#each ov.feed}}
                  <div class="ncm-ov2-ev ncm-ov2-k--{{kind}}">
                    <span class="ncm-ov2-ev__ic"><i class="fas {{icon}}"></i></span>
                    <div class="ncm-ov2-ev__t">{{{html}}}{{#if tag}}<span class="ncm-ov2-tag">{{tag}}</span>{{/if}}{{#if subline}}<span class="ncm-ov2-ev__sub">{{{subline}}}</span>{{/if}}</div>
                    <span class="ncm-ov2-ev__time">{{ago}}</span>
                  </div>
                {{else}}
                  <div class="ncm-ov2-empty">Nothing under this filter.</div>
                {{/each}}
              </div>
              <div class="ncm-ov2-more"><span data-action="switchTab" data-tab="messages">All mail → Messages</span> · <span data-action="switchTab" data-tab="security">All events → Security</span></div>
            {{else}}
              <div class="ncm-ov2-empty">Nothing yet — mail, hacks and terminal logins show here as they happen.</div>
            {{/if}}
          </div>
        </div>
        <div>
          <div class="ncm-ov2-h"><i class="fas fa-hourglass-half"></i> Coming up <small>every timer in one place</small></div>
          <div class="ncm-ov2-card ncm-ov2-scroll ncm-ov2-scroll--soon">
            {{#each ov.soon}}
              <div class="ncm-ov2-soon">
                <span class="ncm-ov2-soon__when{{#if hot}} is-hot{{/if}}">{{when}}</span>
                <div class="ncm-ov2-soon__b">{{title}}<span class="ncm-ov2-soon__sub">{{subline}}</span></div>
                {{#if cancel}}<button type="button" class="ncm-ov2-btn ncm-ov2-btn--ghost" data-action="{{cancel.action}}" data-{{cancel.key}}="{{cancel.id}}" data-tooltip="Cancel" aria-label="Cancel"><i class="fas fa-xmark"></i></button>{{/if}}
              </div>
            {{else}}
              <div class="ncm-ov2-empty">No timers running.</div>
            {{/each}}
          </div>
        </div>
      </section>

      {{!-- §5 PLAYERS' CHARACTERS --}}
      <section>
        <div class="ncm-ov2-h"><i class="fas fa-user-group"></i> Players' characters<span class="ncm-ov2-sp"></span><button type="button" class="ncm-ov2-btn ncm-ov2-btn--ghost" data-action="openAllInboxes">Open their inboxes</button></div>
        <div class="ncm-ov2-scroll ncm-ov2-scroll--pcs">
          <div class="ncm-ov2-pcs">
            {{#each ov.pcs}}
              <div class="ncm-ov2-card ncm-ov2-pc">
                <span class="ncm-ov2-av ncm-ov2-av--lg" style="color:{{color}}">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initials}}{{/if}}<span class="ncm-ov2-av__dot{{#if online}} is-on{{/if}}"></span></span>
                <div class="ncm-ov2-pc__b">
                  <div class="ncm-ov2-pc__n">{{name}} <span class="ncm-ov2-badge{{#unless unread}} is-zero{{/unless}}">{{unread}}</span></div>
                  <div class="ncm-ov2-pc__p">{{#if playerName}}played by {{playerName}}{{/if}}{{#unless online}} · offline{{/unless}}</div>
                  <div class="ncm-ov2-pc__last">{{#if last}}Last: <b>{{last.from}}</b> · "{{last.subject}}" · {{last.ago}}{{else if hasEmail}}No mail yet{{else}}No email address yet{{/if}}</div>
                  <div class="ncm-ov2-pc__a">
                    <button type="button" class="ncm-ov2-btn" data-action="openInbox" data-actor-id="{{actorId}}"><i class="fas fa-envelope-open"></i> Inbox</button>
                    <button type="button" class="ncm-ov2-btn" data-action="ovWriteTo" data-actor-id="{{actorId}}"><i class="fas fa-paper-plane"></i> Write to</button>
                    <button type="button" class="ncm-ov2-btn" data-action="viewPlayerContacts" data-actor-id="{{actorId}}"><i class="fas fa-address-book"></i> Contacts</button>
                  </div>
                </div>
              </div>
            {{else}}
              <div class="ncm-ov2-empty">No player characters yet.</div>
            {{/each}}
          </div>
        </div>
      </section>

      {{!-- §6 NPCs PLAYERS ARE TALKING TO --}}
      <section>
        <div class="ncm-ov2-h"><i class="fas fa-user-tie"></i> NPCs players are talking to <small>sorted by mail waiting on you</small></div>
        <div class="ncm-ov2-card ncm-ov2-scroll ncm-ov2-scroll--npcs">
          {{#each ov.npcs}}
            <div class="ncm-ov2-npc">
              <span class="ncm-ov2-av ncm-ov2-av--sm" style="color:{{color}}">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initials}}{{/if}}</span>
              <div class="ncm-ov2-npc__n">{{name}}{{#if aliases}}<small>+{{aliases}} alias{{#unless (eq aliases 1)}}es{{/unless}}</small>{{/if}}</div>
              <div class="ncm-ov2-npc__w{{#if waiting}} is-bad{{/if}}">{{#if waiting}}{{waiting}} waiting{{else}}nothing waiting{{/if}}</div>
              <div class="ncm-ov2-npc__l">last {{last}}</div>
              <div class="ncm-ov2-npc__a">
                <button type="button" class="ncm-ov2-btn{{#if waiting}} ncm-ov2-btn--pri{{/if}}" data-action="ovReplyAs" data-message-id="{{latestId}}" data-inbox-id="{{ownerId}}"><i class="fas fa-reply"></i> Reply as</button>
                <button type="button" class="ncm-ov2-btn" data-action="ovOpenInboxOf" data-inbox-id="{{ownerId}}" data-tooltip="Open their inbox" aria-label="Open their inbox"><i class="fas fa-inbox"></i></button>
              </div>
            </div>
          {{else}}
            <div class="ncm-ov2-empty">No player has written to an NPC yet.</div>
          {{/each}}
        </div>
        <div class="ncm-ov2-note">Every other NPC lives in Admin → Contacts.</div>
      </section>

    </div>
    {{/if}}{{/if}}
