                <span class="k">Trust</span><span class="v"><span class="trust">{{#each trust}}<i{{#if on}} class="on" style="--trc:{{color}}"{{/if}}></i>{{/each}}</span> <span class="tl">{{trustLabel}}</span></span>
                <span class="k">Last mail</span><span class="v">{{#if lastSubject}}{{#if lastSent}}<i class="fas fa-arrow-up-right dir out"></i>{{else}}<i class="fas fa-arrow-down-left dir in"></i>{{/if}} {{lastSubject}}{{else}}<i class="dim">never written</i>{{/if}}</span></div>
              <div class="acts">{{#if waiting}}<button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="replyAs" data-id="{{id}}"><i class="fas fa-reply"></i> Reply as {{name}}</button>{{else}}{{#if canSendAs}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="sendAs" data-id="{{id}}"><i class="fas fa-pen"></i> Write as {{name}}</button>{{/if}}{{/if}}
                <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="pOpenContact" data-id="{{id}}"><i class="fas fa-address-card"></i> Open</button>
                <button type="button" class="ncm-ct2-btn ncm-ct2-btn--danger" data-action="tabAct" data-op="knTake" data-id="{{id}}" data-actor="{{@root.ct2.players.sel.actorId}}"><i class="fas fa-xmark"></i> Take back</button></div>
            </div>
          </div>
          {{/with}}{{/if}}
          {{#if kn.filtered}}<div class="ncm-ct2-km__chips"><span class="lab">Showing</span>{{#each kn.chips}}<span class="ncm-tagp" style="--tc:{{#if hue}}{{ncm-hue hue}}{{else}}var(--ncm-act){{/if}}">{{label}}<button type="button" class="x" data-action="tabAct" data-op="knClear" data-what="{{what}}" data-key="{{key}}" aria-label="Remove {{label}}"><i class="fas fa-xmark"></i></button></span>{{/each}}<a class="clr" data-action="tabAct" data-op="knClear" data-what="all">clear</a><span class="n">{{kn.shown}} of {{knownN}}</span></div>{{/if}}
        </div>
        {{/if}}
        {{/with}}
      </div>
    </div>
    {{/if}}
  {{/if}}

  {{!-- ═══════════════════ GROUPS ═══════════════════ --}}
  {{#if ct2.isGroups}}
    <header class="ncm-tabhd"><i class="fas fa-users"></i><div><h2>Groups</h2><p>Named lists of people you can message in one go and push to players.</p></div></header>
    {{#unless ct2.groups.empty}}
    {{!-- The Directory's ONE toolbar row (2026-10-28): search (group or member) · Show · out-of-date count · Sort. --}}
    <div class="ncm-ct2-tb ncm-ct2-tb--one">
      <span class="srch"><i class="fas fa-magnifying-glass"></i><input type="text" data-ct2-q="groups" value="{{ct2.groups.search}}" placeholder="Search a group, or a member's name or address…"></span>
      <select class="ncm-ct2-show {{#if ct2.groups.showOn}}is-on{{/if}}" data-ct2-select="gShow" data-tooltip="Which groups to list">{{#each ct2.groups.chips}}<option value="{{key}}" {{#if on}}selected{{/if}}>Show: {{label}} ({{n}})</option>{{/each}}</select>
      {{#each ct2.groups.alerts}}<button type="button" class="ncm-ct2-tbalert is-{{tone}} {{#if on}}on{{/if}}" data-action="tabAct" data-op="gFilter" data-filter="{{key}}" data-tooltip="{{n}} {{label}} — {{#if on}}click to show all again{{else}}click to show only these{{/if}}" aria-label="{{label}}: {{n}}"><i class="fas {{icon}}"></i>{{n}}</button>{{/each}}
      <select data-ct2-select="gSort">{{#each ct2.groups.sortOpts}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
    </div>
    {{#if ct2.groups.narrowed}}<div class="ncm-ct2-facets"><span class="lab">Showing</span><span class="n">{{ct2.groups.shown}} of {{ct2.groups.total}}</span></div>{{/if}}
    {{/unless}}
    <div class="ncm-ct2-split">
      <div class="ncm-ct2-list" data-ct2-scroll="glist">
        {{#if ct2.groups.nothing}}<div class="ncm-ct2-empty"><p>Nothing matches.</p></div>{{/if}}
        {{#each ct2.groups.rows}}
          <div class="ncm-ct2-r {{#if sel}}sel{{/if}}{{#if stale}} is-stale{{/if}}" data-action="tabAct" data-op="gSel" data-id="{{id}}">
            {{#if img}}<img class="ncm-ct2-gimg" src="{{img}}" alt="" style="--g:{{color}}">{{else}}<span class="ncm-ct2-gdot" style="--g:{{color}}"></span>{{/if}}
            <div class="ncm-ct2-r__txt"><div class="nm">{{name}}</div><div class="sub{{#unless pushed}} unpushed{{/unless}}">{{subline}}</div></div><div class="st">{{#if stale}}<span class="mail" data-tooltip="A pushed copy is out of date"><i class="fas fa-rotate"></i></span>{{/if}}{{#if pushed}}<span class="pushed" data-tooltip="Pushed to {{pushed}} character{{#unless (eq pushed 1)}}s{{/unless}}"><i class="fas fa-share-nodes"></i> {{pushed}}</span>{{/if}}</div>
          </div>
        {{/each}}
        {{#if ct2.groups.hidden}}<div class="ncm-ct2-r ncm-ct2-r--more" data-action="tabAct" data-op="gMore" data-tooltip="Show every group"><span></span><span><i class="fas fa-ellipsis"></i> +{{ct2.groups.hidden}} more</span><span></span></div>{{/if}}
        {{#if ct2.groups.more}}<div class="ncm-ct2-r ncm-ct2-r--more" data-action="tabAct" data-op="gMore" data-tooltip="Fold the rail back"><span></span><span><i class="fas fa-chevron-up"></i> Show fewer</span><span></span></div>{{/if}}
        <div class="ncm-ct2-r ncm-ct2-r--new" data-action="tabAct" data-op="gNew"><span></span><span><i class="fas fa-plus"></i> New group</span><span></span></div>
      </div>
      <div class="ncm-ct2-det" data-ct2-scroll="gdet">
        {{#with ct2.groups.sel}}
        <div class="ncm-ct2-dhead ncm-ct2-dhead--grp">
          {{#if img}}<img class="ncm-ct2-gimg ncm-ct2-gimg--lg" src="{{img}}" alt="" style="--g:{{color}}">{{else}}<span class="ncm-ct2-gdot ncm-ct2-gdot--lg" style="--g:{{color}}"></span>{{/if}}
          <div class="ncm-ct2-r__txt"><div class="nm">{{name}}</div><div class="meta"><span class="ncm-tagp" style="--tc:{{color}}"><i class="fas fa-users"></i>{{n}} member{{#unless (eq n 1)}}s{{/unless}}</span>{{#if note}}<span class="ncm-tagp is-plain"><i class="fas fa-note-sticky"></i>{{note}}</span>{{/if}}</div></div>
          <div class="ncm-ct2-acts">
            <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="gPush" data-group-id="{{id}}"><i class="fas fa-share-nodes"></i> Push to players</button>
            <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="gMessage" data-group-id="{{id}}"><i class="fas fa-envelope"></i> Message the group</button>
            <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="gEdit" data-group-id="{{id}}"><i class="fas fa-pen"></i> Edit</button>
            <button type="button" class="ncm-ct2-btn ncm-ct2-btn--danger" data-action="tabAct" data-op="gDelete" data-group-id="{{id}}"><i class="fas fa-trash"></i> Delete</button>
          </div>
        </div>
        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-users"></i>Members<span class="r">{{n}}</span></div>
          <div class="ncm-ct2-mini">
            {{#each members}}<span {{#if contactId}}data-action="tabAct" data-op="pOpenContact" data-id="{{contactId}}"{{/if}} class="{{#if gone}}gone{{/if}}">{{#if img}}<img class="ncm-ct2-av" src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}{{name}}</span>{{/each}}
            <span class="add" data-action="tabAct" data-op="gEdit" data-group-id="{{id}}"><i class="fas fa-plus"></i>Add members…</span>
          </div>
        </div>
        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-share-nodes"></i>Pushed to<span class="r">click to push or take back</span></div>
          {{#if hasPcs}}
            <div class="ncm-ct2-who">{{#each to}}<span class="ncm-ct2-pc {{#if on}}on{{/if}}" data-action="tabAct" data-op="gToggle" data-group-id="{{../id}}" data-actor="{{actorId}}" data-tooltip="{{#if on}}Take the group back from {{name}}{{else}}Push to {{name}}{{/if}}">{{#if img}}<img src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av ncm-ct2-av--xs" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}{{name}}{{#if on}}<span class="s">✓</span>{{/if}}</span>{{/each}}</div>
          {{else}}<div class="ncm-ct2-quiet">No player characters yet.</div>{{/if}}
        </div>
        {{else}}
          <div class="ncm-ct2-empty"><i class="fas fa-users"></i><p>No groups yet. A group is a named list of people you can message — and push to players — in one go.</p>
            <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="gNew"><i class="fas fa-plus"></i> New group</button></div>
        {{/with}}
      </div>
    </div>
  {{/if}}

  {{!-- ═══════════════════ WHO KNOWS WHOM ═══════════════════ --}}
  {{#if ct2.isMatrix}}
    <header class="ncm-tabhd"><i class="fas fa-diagram-project"></i><div><h2>Who knows whom</h2><p>Which characters have which contacts — share or take back a contact in one click.</p></div></header>
    {{> "modules/night-city-messenger/templates/admin-panel/partials/contacts-map.hbs" map=ct2.mxMap}}
    {{#unless ct2.mxMap.on}}
    <div class="ncm-ct2-tb">
      <span class="srch"><i class="fas fa-magnifying-glass"></i><input type="text" data-ct2-q="mx" value="{{ct2.mx.search}}" placeholder="Find a contact — name, address, role, organization…"></span>
      {{{ct2.mx.colsHtml}}}
      <select data-ct2-select="mxGroupBy">{{#each ct2.mx.groupOpts}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
    </div>
    <div class="ncm-ct2-chips">
      {{#each ct2.mx.chips}}<span class="ncm-ct2-chip {{#if on}}on{{/if}}{{#if tone}} is-{{tone}}{{/if}}" data-action="tabAct" data-op="mxFilter" data-filter="{{key}}">{{label}}<span class="n">{{n}}</span></span>{{/each}}
      <span class="grow"></span>
      <span class="ncm-ct2-chip" data-action="tabAct" data-op="mxAll"><i class="fas {{#if ct2.mx.anyOpen}}fa-compress{{else}}fa-expand{{/if}}"></i>{{#if ct2.mx.anyOpen}}Collapse all{{else}}Expand all{{/if}}</span>
    </div>
    <div class="ncm-ct2-mx" data-ct2-scroll="mx">
      {{#if ct2.mx.noPcs}}
        <div class="ncm-ct2-mxempty">No player characters yet — there is nobody to share with.</div>
      {{else if ct2.mx.empty}}
        <div class="ncm-ct2-mxempty">{{#if ct2.mx.noContacts}}No contacts in the directory yet.{{else}}No contact matches. <a data-action="tabAct" data-op="mxReset">Show everyone</a>{{/if}}</div>
      {{else}}
        <table class="ncm-ct2-mxt">
          <thead><tr><th>{{ct2.mx.totalLabel}}</th>{{#each ct2.mx.cols}}<th>{{#if img}}<img src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av ncm-ct2-av--hd" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}{{name}}<small>knows {{knows}}</small></th>{{/each}}</tr></thead>
          <tbody>
            {{#each ct2.mx.groups}}
              <tr class="grp"><th data-action="tabAct" data-op="mxGrp" data-grp="{{label}}"><i class="fas {{#if open}}fa-chevron-down{{else}}fa-chevron-right{{/if}} chev"></i>{{label}}<span class="n">{{n}}</span></th>
                {{#each tallies}}<td><span class="ncm-ct2-tally {{#if cls}}{{cls}}{{else}}none{{/if}}" data-action="tabAct" data-op="mxTally" data-grp="{{../label}}" data-actor="{{actorId}}" data-tooltip="{{title}}">{{k}}/{{n}}</span></td>{{/each}}</tr>
              {{#each rows}}
                <tr{{#if nobody}} class="nobody"{{/if}}><th>{{#if alias}}<span class="ncm-ct2-mxalias">└</span>{{/if}}{{name}}<small>{{addr}}</small></th>
                  {{#each cells}}<td><span class="ncm-ct2-cell {{#if on}}on{{/if}} {{#if chg}}chg{{/if}}" data-action="tabAct" data-op="mxCell" data-cid="{{../id}}" data-actor="{{actorId}}" data-mx-grp="{{../../label}}"><i class="fas fa-check"></i></span></td>{{/each}}</tr>
              {{/each}}
            {{/each}}
          </tbody>
        </table>
      {{/if}}
    </div>
    <div class="ncm-ct2-mxbar">
      {{#if ct2.mx.nchg}}<span class="chg"><i class="fas fa-pen"></i> {{ct2.mx.chgLabel}}</span><a data-action="tabAct" data-op="mxUndo">Undo last</a>{{else}}<span>Changes save as you click.</span>{{/if}}
      <span class="grow"></span><span><kbd>Shift</kbd>-click fills a column range · a group’s <b>n/m</b> shares or takes back the whole group</span>
    </div>
    {{/unless}}
  {{/if}}

  </div>
</div>
{{else}}
  <div class="ncm-ct2-empty"><p>Contacts could not load.</p></div>
{{/if}}
{{/if}}
