{{!--
  Admin → Contacts (redesign 2026-10-27; mock dev/mockups/admin-contacts-redesign-mock.html).
  The GM Contact Manager window is folded in: Directory · Players · Groups · Who knows whom.
  Context: ct2 (ContactsTab._buildContext). Buttons: data-action="tabAct" data-op="…"
  (the root carries data-owner="contacts"). Styles: tab-contacts.css (ncm-ct2-*).
--}}
{{#if (eq activeTab 'contacts')}}
{{#if ct2}}
<div class="ncm-ct2 {{#if ct2.isPopout}}ncm-ct2--pop{{/if}}" data-owner="contacts">

  {{!-- ═══ SUB-TABS + New / Pop out ═══ --}}
  <div class="ncm-ct2-nav">
    {{#each ct2.nav}}
      <button type="button" class="ncm-ct2-navbtn {{#if on}}on{{/if}}" data-action="tabAct" data-op="view" data-view="{{key}}">
        <i class="fas {{icon}}"></i>{{label}}{{#if count}}<span class="ncm-ct2-navct">{{count}}</span>{{/if}}
      </button>
    {{/each}}
    <span class="grow"></span>
    {{#if ct2.sendAsPicker}}<span class="ncm-ct2-navsend" data-tooltip="Write a message as one of your NPCs — the five you used last are at the top">{{{ct2.sendAsPicker}}}</span>{{/if}}
    <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="newMenu"><i class="fas fa-plus"></i> New</button>
    {{#unless ct2.isPopout}}
      <button type="button" class="ncm-ct2-btn" data-action="popOutTab" data-tab="contacts" {{#if ct2.dir.sel}}data-select="{{ct2.dir.sel.id}}"{{/if}} data-tooltip="Open Contacts in its own larger window — handy beside a scene or on a second screen"><i class="fas fa-up-right-from-square"></i> Pop out</button>
    {{/unless}}
    {{#if ct2.newOpen}}
      <div class="ncm-ct2-menu">
        <div class="it" data-action="tabAct" data-op="new"><i class="fas fa-user-plus"></i>New contact</div>
        <div class="it" data-action="tabAct" data-op="newFromActor"><i class="fas fa-person-circle-plus"></i>From an actor…<small>name, portrait, role</small></div>
        <div class="it" data-action="tabAct" data-op="newGroup"><i class="fas fa-users"></i>New group</div>
        <hr>
        <div class="it" data-action="tabAct" data-op="importJson"><i class="fas fa-file-import"></i>Import from JSON…</div>
        <div class="it" data-action="tabAct" data-op="exportAll"><i class="fas fa-file-export"></i>Export all<small>contacts + groups</small></div>
        <div class="it" data-action="tabAct" data-op="syncActors"><i class="fas fa-users-between-lines"></i>Sync from actors<small>every actor with an address</small></div>
      </div>
    {{/if}}
  </div>

  <div class="ncm-ct2-view">

  {{!-- ═══════════════════ DIRECTORY ═══════════════════ --}}
  {{#if ct2.isDirectory}}
    <header class="ncm-tabhd"><i class="fas fa-address-book"></i><div><h2>Directory</h2><p>Every NPC and address you have set up — pick one to see who knows them, who writes to them, and to edit them.</p></div></header>

    {{!-- ONE toolbar row (2026-10-28): search · Show (the quick filters, one at a time) · the two
         "needs you" counts as amber buttons · Filter (roles/orgs/trust) · Group · Sort · fold. --}}
    <div class="ncm-ct2-tb ncm-ct2-tb--one">
      <span class="srch"><i class="fas fa-magnifying-glass"></i><input type="text" data-ct2-q="dir" data-field="contactSearch" value="{{ct2.dir.search}}" placeholder="Search name, address, org, tag…"></span>
      <select class="ncm-ct2-show {{#if ct2.dir.showOn}}is-on{{/if}}" data-ct2-select="show" data-tooltip="Which contacts to list">{{#each ct2.dir.chips}}<option value="{{key}}" {{#if on}}selected{{/if}}>Show: {{label}} ({{n}})</option>{{/each}}</select>
      {{#each ct2.dir.alerts}}<button type="button" class="ncm-ct2-tbalert {{#if on}}on{{/if}}" data-action="tabAct" data-op="filter" data-filter="{{key}}" data-tooltip="{{n}} {{label}} — {{#if on}}click to show all again{{else}}click to show only these{{/if}}" aria-label="{{label}}: {{n}}"><i class="fas {{icon}}"></i>{{n}}</button>{{/each}}
      {{{ct2.dir.facetPicker}}}
      <select data-ct2-select="groupBy">{{#each ct2.dir.groupOpts}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
      <select data-ct2-select="sort">{{#each ct2.dir.sortOpts}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
      {{#if ct2.dir.canFold}}<button type="button" class="ncm-ct2-tbfold" data-action="tabAct" data-op="dirFoldAll" data-fold="{{#if ct2.dir.allShut}}open{{else}}close{{/if}}" data-tooltip="{{#if ct2.dir.allShut}}Expand every group{{else}}Collapse every group{{/if}}" aria-label="{{#if ct2.dir.allShut}}Expand all{{else}}Collapse all{{/if}}"><i class="fas fa-{{#if ct2.dir.allShut}}expand{{else}}compress{{/if}}"></i></button>{{/if}}
    </div>

    {{#if ct2.dir.activeFacets.length}}<div class="ncm-ct2-facets"><span class="lab">Showing</span>{{#each ct2.dir.activeFacets}}<span class="ncm-tagp" style="--tc:{{color}}"><i class="fas {{icon}}"></i>{{label}}<button type="button" class="ncm-ct2-facets__x" data-action="tabAct" data-op="facetOff" data-k="{{key}}" aria-label="Remove {{label}}"><i class="fas fa-xmark"></i></button></span>{{/each}}<a class="clr" data-action="tabAct" data-op="facetClear">clear</a><span class="n">{{ct2.dir.facetShown}} of {{ct2.dir.facetTotal}}</span></div>{{/if}}

    {{#if ct2.dir.guard}}
      <div class="ncm-ct2-guard">
        <i class="fas fa-circle-exclamation"></i>
        <span>You have unsaved changes to <b>{{ct2.dir.guard.name}}</b>.</span>
        <span class="grow"></span>
        <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="guard" data-choice="stay">Keep editing</button>
        <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="guard" data-choice="discard">Discard</button>
        <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="guard" data-choice="save"><i class="fas fa-check"></i> Save and open</button>
      </div>
    {{/if}}

    <div class="ncm-ct2-split">
      <div class="ncm-ct2-list" data-ct2-scroll="dirlist">
        {{#each ct2.dir.groups}}
          <div class="ncm-ct2-grp {{#if shut}}is-shut{{/if}}"{{#if hue}} style="--gc:{{ncm-hue hue}}"{{else if tc}} style="--gc:{{tc}}"{{/if}} data-action="tabAct" data-op="dirFold" data-key="{{key}}" data-shut="{{#if shut}}1{{/if}}" role="button" tabindex="0" aria-expanded="{{#if shut}}false{{else}}true{{/if}}" data-tooltip="{{#if shut}}Show{{else}}Hide{{/if}} {{label}}"><i class="fas fa-chevron-{{#if shut}}right{{else}}down{{/if}} ncm-ct2-grp__chev"></i><i class="{{icon}}"></i>{{label}}
            {{#if folder}}<i class="fas fa-pen ncm-ct2-grp__edit" data-action="tabAct" data-op="renameFolder" data-folder="{{folder}}" data-tooltip="Rename this folder"></i>{{/if}}
            {{#if shut}}{{#if waiting}}<span class="ncm-ct2-grp__w" data-tooltip="{{waiting}} message{{#unless (eq waiting 1)}}s{{/unless}} waiting in {{label}}"><i class="fas fa-envelope"></i>{{waiting}} waiting</span>{{/if}}{{#if checks}}<span class="ncm-ct2-grp__p" data-tooltip="{{checks}} contact{{#unless (eq checks 1)}}s{{/unless}} need a look"><i class="fas fa-triangle-exclamation"></i>{{checks}}</span>{{/if}}{{/if}}
            <span class="n">{{n}}</span></div>
          {{#unless shut}}
          {{#each rows}}
            <div class="ncm-ct2-r {{#if alias}}alias{{/if}} {{#if sel}}sel{{/if}}{{#if mail}} is-mail{{else if check}} is-check{{/if}}" data-action="tabAct" data-op="sel" data-id="{{id}}">
              {{#if img}}<img class="ncm-ct2-av {{#if ice}}ice{{/if}}" src="{{img}}" alt="">{{else if sys}}<span class="ncm-ct2-av sys"><i class="fas fa-tower-broadcast"></i></span>{{else}}<span class="ncm-ct2-av {{#if ice}}ice{{/if}}" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}
              <div class="ncm-ct2-r__txt"><div class="nm">{{name}}</div><div class="sub">{{#if alias}}<span class="ncm-ct2-sub__alias"><i class="fas fa-masks-theater"></i>alias</span> · {{#if email}}{{email}}{{else}}no address{{/if}}{{else}}{{#if role}}<i class="{{role.icon}} ncm-ct2-sub__role" style="--tc:{{ncm-hue role.hue}}" data-tooltip="{{role.label}}"></i>{{/if}}{{#if org}}<span class="ncm-ct2-sub__org" style="--tc:{{ncm-hue org}}">{{org}}</span>{{#if email}} · {{/if}}{{/if}}{{email}}{{#unless org}}{{#unless email}}{{subline}}{{/unless}}{{/unless}}{{/if}}</div></div>
              <div class="st">
                {{#if mail}}<span class="mail" data-tooltip="{{mail}} waiting"><i class="fas fa-envelope"></i>{{mail}}</span>{{/if}}
                {{#if ice}}<span class="ice" data-tooltip="Encrypted"><i class="fas fa-lock"></i></span>{{/if}}
                {{#if check}}<span class="warn" data-tooltip="Needs a look"><i class="fas fa-triangle-exclamation"></i></span>{{/if}}
                {{#if knows.length}}<span class="ncm-ct2-knows" data-tooltip="{{knowsTitle}}">{{#each knows}}<span style="background:{{color}}"></span>{{/each}}</span>{{else}}<span class="nobody" data-tooltip="{{knowsTitle}}">—</span>{{/if}}
              </div>
            </div>
          {{/each}}
          {{/unless}}
        {{else}}
          <div class="ncm-ct2-empty">
            {{#if ct2.dir.emptyAll}}<i class="fas fa-address-book"></i><p>No contacts yet.</p><button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="new"><i class="fas fa-user-plus"></i> New contact</button>
            {{else}}<p>Nothing matches.</p>{{/if}}
          </div>
        {{/each}}
      </div>

      <div class="ncm-ct2-det {{#if ct2.dir.editing}}editing{{/if}}" {{#unless ct2.dir.editing}}data-ct2-scroll="dirdet"{{/unless}}>
      {{#if ct2.dir.edit}}
        {{!-- ─── EDIT IN PLACE ─── --}}
        <div class="ncm-ct2-edhd">
          {{#if ct2.dir.edit.img}}<img class="ncm-ct2-av" src="{{ct2.dir.edit.img}}" alt="">{{else}}<span class="ncm-ct2-av">{{ct2.dir.edit.initials}}</span>{{/if}}
          <div class="t">{{ct2.dir.edit.title}}<small>{{ct2.dir.edit.subtitle}}</small></div>
          <span class="grow"></span>
          {{#unless ct2.isPopout}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="edPop" data-tooltip="Keep editing in a larger window — unsaved changes come with you"><i class="fas fa-up-right-from-square"></i> Pop out</button>{{/unless}}
        </div>
        <div class="ncm-ct2-edtabs">
          {{#each ct2.dir.edit.secs}}<span class="ncm-ct2-edtab {{#if on}}on{{/if}} {{#if dirty}}dirty{{/if}}" data-sec-tab="{{key}}" data-action="tabAct" data-op="edTab" data-sec="{{key}}">{{label}}<span class="d"></span></span>{{/each}}
        </div>
        <div class="ncm-ct2-edbody">
          {{#with ct2.dir.edit}}
          {{!-- Identity --}}
          <section class="ncm-ct2-esec wide" data-esec="identity">
            <h3><i class="fas fa-id-card"></i>Identity</h3>
            <div class="ncm-ct2-idrow">
              <div class="ncm-ct2-ptile" data-action="tabAct" data-op="edPortrait" data-tooltip="Pick a picture">
                {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="ini">{{initials}}</span>{{/if}}<span class="lab">Change</span>
              </div>
              <input type="hidden" name="portrait" value="{{f.portrait}}">
              <div class="ncm-ct2-fg">
                <label class="ncm-ct2-f w"><span>Name<small>what players see</small></span><input type="text" name="name" value="{{f.name}}"></label>
                <label class="ncm-ct2-f w"><span>Subtitle<small>shown under the name</small></span><input type="text" name="alias" value="{{f.alias}}" placeholder="e.g. Queen of the Afterlife"></label>
              </div>
            </div>
            <div class="ncm-ct2-fg">
              <div class="ncm-ct2-f w"><span>Role</span>
                <div class="ncm-ct2-roles">
                  {{#each roles}}<span class="ncm-ct2-role {{#if on}}on{{/if}}" data-action="tabAct" data-op="edRole" data-role="{{id}}"><i class="{{icon}}"></i>{{label}}</span>{{/each}}
                  <span class="ncm-ct2-role ghost" data-action="tabAct" data-op="manageRoles"><i class="fas fa-sliders"></i>Manage roles…</span>
                </div>
                <input type="hidden" name="role" value="{{f.role}}">
              </div>
              <label class="ncm-ct2-f"><span>Organization</span><input type="text" name="organization" value="{{f.organization}}"></label>
              <label class="ncm-ct2-f"><span>Location</span><input type="text" name="location" value="{{f.location}}"></label>
              <div class="ncm-ct2-f w"><span>Tags<small>Enter or comma adds one</small></span>
                <div class="ncm-ct2-tags" data-ct2-tags>
                  {{#each tags}}<span>{{this}}<i class="fas fa-xmark" data-action="tabAct" data-op="edTagDel" data-tag="{{this}}"></i></span>{{/each}}
                  <input type="text" data-ct2-tagin list="ncm-ct2-tagsuggest" placeholder="Add a tag…">
                </div>
                <datalist id="ncm-ct2-tagsuggest">{{#each tagSuggest}}<option value="{{this}}"></option>{{/each}}</datalist>
                <input type="hidden" name="tags" value="{{tagsJoined}}">
              </div>
              <div class="ncm-ct2-f"><span>Linked character<small>mail lands in its inbox</small></span>
                <div class="ncm-ct2-pick">
                  {{#if linkedImg}}<img src="{{linkedImg}}" alt="">{{else}}<i class="fas fa-user"></i>{{/if}}
                  <span data-ct2-linked>{{#if linkedName}}{{linkedName}}{{else}}None{{/if}}</span><span class="grow"></span>
                  <a data-action="tabAct" data-op="edLink">{{#if linkedName}}Change{{else}}Pick an actor…{{/if}}</a>
                  {{#if linkedName}}<a data-action="tabAct" data-op="edUnlink">Unlink</a>{{/if}}
                </div>
                <input type="hidden" name="actorId" value="{{f.actorId}}">
              </div>
              <div class="ncm-ct2-f"><span>Folder<small><a data-action="tabAct" data-op="edFolderNew">New folder…</a></small></span>
                <input type="text" name="folder" value="{{f.folder}}" list="ncm-ct2-folders" placeholder="None">
                <datalist id="ncm-ct2-folders">{{#each folders}}<option value="{{this}}"></option>{{/each}}</datalist>
              </div>
            </div>
          </section>

          {{!-- Addresses & aliases --}}
          <section class="ncm-ct2-esec wide" data-esec="addr">
            <h3><i class="fas fa-at"></i>Addresses &amp; aliases</h3>
            <div class="ncm-ct2-fg">
              <label class="ncm-ct2-f"><span>Address</span><input type="text" name="email" value="{{f.email}}" placeholder="blank = made from the name"></label>
              <label class="ncm-ct2-f"><span>Phone</span><input type="text" name="phone" value="{{f.phone}}" placeholder="555-…"></label>
              <div class="ncm-ct2-f w"><span>Messages</span>
                <div class="ncm-ct2-seg">{{#each routeSegs}}<span class="{{#if on}}on{{/if}}" data-action="tabAct" data-op="edSeg" data-key="sendOnly" data-v="{{v}}">{{l}}</span>{{/each}}</div>
                <input type="hidden" name="sendOnly" value="{{f.sendOnly}}">
              </div>
            </div>
            <div class="ncm-ct2-hint" data-ct2-routehint>{{#if sendOnly}}A system address: you can send from it; players can’t reply, write to it or add it.{{else}}Players can write to it and reply.{{/if}}</div>
            {{#if idsCan}}
              <div class="ncm-ct2-f w ncm-ct2-f--gap"><span>Identities<small>mail to any of them reaches {{mainName}}</small></span>
                <div class="ncm-ct2-ids">
                  {{#each ids}}
                    <div class="ncm-ct2-id">
                      {{#if img}}<img class="ncm-ct2-av" src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}
                      <div><div>{{name}}</div><div class="a">{{email}}</div></div>
                      {{#if main}}<i class="fas fa-star star" data-tooltip="Main identity"></i>{{else}}<i class="fas fa-star star off" data-action="tabAct" data-op="star" data-id="{{id}}" data-tooltip="Make this the main identity"></i>{{/if}}
                    </div>
                  {{/each}}
                </div>
                <span class="ncm-ct2-add" data-action="tabAct" data-op="aliasAdd" data-id="{{contactId}}"><i class="fas fa-plus"></i>Add an alias</span>
              </div>
            {{/if}}
          </section>

          {{!-- Security & ICE --}}
          <section class="ncm-ct2-esec" data-esec="security">
            <h3><i class="fas fa-lock"></i>Security &amp; ICE</h3>
            <div class="ncm-ct2-sw {{#if encOn}}on{{/if}}" data-action="tabAct" data-op="edSeg" data-key="encrypted"><div><b>Encrypted contact</b><small>Players see a locked card until they breach it</small></div><span class="k"></span></div>
            <input type="hidden" name="encrypted" value="{{f.encrypted}}">
            {{#if encOn}}
              <div class="ncm-ct2-sub">
                <div class="ncm-ct2-fg">
                  <label class="ncm-ct2-f"><span>Breach skill</span><select name="encryptionSkill">{{#each skills}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{v}}</option>{{/each}}</select></label>
                  <label class="ncm-ct2-f"><span>DV</span><input type="number" name="encryptionDV" value="{{f.encryptionDV}}" min="1" max="40"></label>
                  <label class="ncm-ct2-f"><span>Tries before lockout<small>then a 10 min lockout</small></span><input type="number" name="maxBreachAttempts" value="{{f.maxBreachAttempts}}" min="1" max="10"></label>
                  <span></span>
                  <div class="ncm-ct2-f w"><span>Black ICE on a failed breach</span>
                    <div class="ncm-ct2-seg">{{#each iceSegs}}<span class="{{#if on}}on{{/if}}" data-action="tabAct" data-op="edSeg" data-key="ice" data-v="{{v}}">{{l}}</span>{{/each}}</div>
                    <input type="hidden" name="blackIce" value="{{f.blackIce}}"><input type="hidden" name="iceSource" value="{{f.iceSource}}">
                  </div>
                  {{#if iceIsDefault}}<label class="ncm-ct2-f"><span>Damage</span><input type="text" name="blackIceDamage" value="{{f.blackIceDamage}}" placeholder="3d6"></label>{{/if}}
                  {{#if iceIsCustom}}
                    <label class="ncm-ct2-f"><span>Name</span><input type="text" name="iceCustomName" value="{{f.iceCustomName}}" placeholder="e.g. Hellhound"></label>
                    <label class="ncm-ct2-f"><span>Damage</span><input type="text" name="iceCustomDamage" value="{{f.iceCustomDamage}}" placeholder="3d6"></label>
                    <div class="ncm-ct2-f w"><span>Picture<small>shown on the breach overlay</small></span>
                      <div class="ncm-ct2-pick">{{#if f.iceCustomPortrait}}<img src="{{f.iceCustomPortrait}}" alt="">{{else}}<i class="fas fa-skull"></i>{{/if}}<span>{{#if f.iceCustomPortrait}}{{f.iceCustomPortrait}}{{else}}None{{/if}}</span><span class="grow"></span><a data-action="tabAct" data-op="edIcePortrait">Browse…</a></div>
                      <input type="hidden" name="iceCustomPortrait" value="{{f.iceCustomPortrait}}">
                    </div>
                  {{/if}}
                  {{#if iceIsActor}}
                    <div class="ncm-ct2-f w"><span>ICE<small>damage from its ATK</small></span>
                      <div class="ncm-ct2-pick">{{#if iceActorImg}}<img src="{{iceActorImg}}" alt="">{{else}}<i class="fas fa-skull ncm-ct2-danger"></i>{{/if}}<span>{{#if iceActorName}}{{iceActorName}}{{else}}None picked{{/if}}</span><span class="grow"></span><a data-action="tabAct" data-op="edIceActor">{{#if iceActorName}}Change{{else}}Pick ICE…{{/if}}</a></div>
                      <input type="hidden" name="iceActorId" value="{{f.iceActorId}}">
                    </div>
                  {{/if}}
                </div>
              </div>
            {{/if}}
          </section>

          {{!-- Trust --}}
          <section class="ncm-ct2-esec" data-esec="trust">
            <h3><i class="fas fa-handshake"></i>Trust</h3>
            <p>How they see the players — shown on a player’s contact card when you allow it.</p>
            <div class="ncm-ct2-f w"><span>Default</span>
              <div class="ncm-ct2-seg trust">{{#each trustSegs}}<span class="{{#if on}}on{{/if}}" style="--tc:{{color}}" data-action="tabAct" data-op="edSeg" data-key="trust" data-v="{{v}}">{{l}}</span>{{/each}}</div>
              <input type="hidden" name="trust" value="{{f.trust}}">
            </div>
            <label class="ncm-ct2-check"><input type="checkbox" name="revealTrust" {{#if revealTrust}}checked{{/if}}> Players see their trust and relationship</label>
            {{#if players.length}}<div class="ncm-ct2-hint">Per player <span class="mute">— overrides the default</span></div>{{/if}}
            {{#each players}}
              <div class="ncm-ct2-ptrust">
                {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av ncm-ct2-av--xs" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}
                <span class="pn">{{name}}</span>
                <div class="ncm-ct2-seg trust">{{#each segs}}<span class="{{#if on}}on{{/if}}" style="--tc:{{color}}" data-tooltip="{{title}}" data-action="tabAct" data-op="edSeg" data-key="rel:{{../actorId}}:trust" data-v="{{v}}">{{l}}</span>{{/each}}</div>
                <input type="hidden" name="rel:{{actorId}}:trust" value="{{trustValue}}">
                <select name="rel:{{actorId}}:type">{{#each types}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
                <input type="text" name="rel:{{actorId}}:note" value="{{note}}" placeholder="Note (GM only)">
              </div>
            {{/each}}
          </section>

          {{!-- Notes --}}
          <section class="ncm-ct2-esec wide" data-esec="notes">
            <h3><i class="fas fa-note-sticky"></i>Notes</h3>
            <div class="ncm-ct2-fg">
              <label class="ncm-ct2-f"><span>GM notes<small>players never see these</small></span><textarea name="notes">{{f.notes}}</textarea></label>
              <label class="ncm-ct2-f {{#if @root.ct2.dir.edit.voice.inherited}}is-inherited{{/if}}"><span>Voice<small>{{#if @root.ct2.dir.edit.voice.inherited}}from {{@root.ct2.dir.edit.voice.from}} — type to override{{else}}how they talk — players never see this{{/if}}</small></span><textarea name="voice" placeholder="{{@root.ct2.dir.edit.voice.placeholder}}">{{f.voice}}</textarea></label>
            </div>
          </section>
          {{/with}}
        </div>
        <div class="ncm-ct2-edft">
          <span class="st {{#if ct2.dir.edit.dirtyN}}dirty{{/if}}" data-ct2-edst>{{ct2.dir.edit.dirtyLabel}}</span>
          <span class="grow"></span>
          <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="edCancel">Cancel</button>
          <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="edSave"><i class="fas fa-check"></i> {{#if ct2.dir.edit.isNew}}Create{{else}}Save{{/if}}</button>
        </div>

      {{else if ct2.dir.sel}}
        {{!-- ─── DETAIL ─── --}}
        {{#with ct2.dir.sel}}
        <div class="ncm-ct2-dhead">
          <span class="ncm-ct2-dav" data-action="tabAct" data-op="detailPortrait" data-id="{{id}}" data-tooltip="Change picture">
            {{#if img}}<img class="ncm-ct2-av {{#if ice}}ice{{/if}}" src="{{img}}" alt="">{{else if sys}}<span class="ncm-ct2-av sys"><i class="fas fa-tower-broadcast"></i></span>{{else}}<span class="ncm-ct2-av {{#if ice}}ice{{/if}}" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}
          </span>
          <div class="ncm-ct2-r__txt">
            <div class="nm">{{name}}{{#each tags}}<span class="ncm-ct2-tag ncm-tagp {{cls}}">{{#if icon}}<i class="fas {{icon}}"></i>{{/if}}{{label}}</span>{{/each}}</div>
            <div class="addr">{{address}}</div>
            <div class="meta">{{#each meta}}<span class="ncm-tagp {{cls}}"{{#if hue}} style="--tc:{{ncm-hue hue}}"{{/if}}><i class="{{icon}}"></i>{{text}}</span>{{/each}}</div>
          </div>
          <div class="ncm-ct2-acts">
            <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="sendAs" data-id="{{id}}"><i class="fas fa-paper-plane"></i> Send as</button>
            {{#unless sys}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="message" data-id="{{id}}"><i class="fas fa-envelope"></i> Message</button>{{/unless}}
            <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="inbox" data-id="{{id}}"><i class="fas fa-inbox"></i> Inbox</button>
            <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="edit" data-id="{{id}}"><i class="fas fa-pen"></i> Edit</button>
            <span class="ncm-ct2-morewrap">
              <button type="button" class="ncm-ct2-btn ncm-ct2-btn--icon" data-action="tabAct" data-op="more" data-tooltip="Add alias · Share · Duplicate · Export · Delete"><i class="fas fa-ellipsis"></i></button>
              {{#if moreOpen}}
                <div class="ncm-ct2-menu ncm-ct2-menu--more">
                  <div class="it" data-action="tabAct" data-op="aliasAdd" data-id="{{id}}"><i class="fas fa-masks-theater"></i>Add an alias</div>
                  <div class="it" data-action="tabAct" data-op="shareMany" data-id="{{id}}"><i class="fas fa-share-nodes"></i>Share with…</div>
                  <div class="it" data-action="tabAct" data-op="duplicate" data-id="{{id}}"><i class="fas fa-copy"></i>Duplicate</div>
                  <div class="it" data-action="tabAct" data-op="exportOne" data-id="{{id}}"><i class="fas fa-file-export"></i>Export this contact</div>
                  <hr>
                  <div class="it danger" data-action="tabAct" data-op="delete" data-id="{{id}}"><i class="fas fa-trash"></i>Delete</div>
                </div>
              {{/if}}
            </span>
          </div>
        </div>

        {{#if dtabs}}<div class="ncm-ct2-itabs" role="tablist" aria-label="{{name}}">{{#each dtabs}}<button type="button" role="tab" aria-selected="{{#if on}}true{{else}}false{{/if}}" class="ncm-ct2-itab{{#if on}} on{{/if}}" data-action="tabAct" data-op="dTab" data-tab="{{key}}"{{#if tip}} data-tooltip="{{tip}}"{{/if}}><i class="fas {{icon}}"></i>{{label}}{{#if count}}<span class="ncm-ct2-itab__n{{#if attn}} is-attn{{/if}}">{{count}}</span>{{/if}}</button>{{/each}}</div>{{/if}}

        {{#if onMain}}
        {{#each needs}}
          <div class="ncm-ct2-sec"><div class="ncm-ct2-mail ncm-ct2-mail--warn">
            <i class="fas {{#if isAuto}}fa-wand-magic-sparkles{{else}}fa-triangle-exclamation{{/if}}"></i><span>{{text}}</span><span class="grow"></span>
            {{#if isAuto}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="looksRight" data-id="{{../id}}">Looks right</button>{{/if}}
            {{#if isDup}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="edit" data-id="{{../id}}" data-sec="addr">Change</button>{{/if}}
          </div></div>
        {{/each}}

        {{#if mail}}
          <div class="ncm-ct2-sec"><div class="ncm-ct2-mail">
            <i class="fas fa-envelope"></i><span><b>{{mail.label}}</b></span><span class="grow"></span>
            <button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="replyAs" data-id="{{id}}"><i class="fas fa-reply"></i> Reply as</button>
          </div></div>
        {{/if}}
        {{/if}}

        {{!-- sb:start — the Correspondents tab: the switchboard (mock dev/mockups/admin-npc-orbit-mock.html, version C) + the correspondent card --}}
        {{#if sb}}{{#with sb}}
        <div class="ncm-ct2-sec ncm-ct2-sb"><div class="k"><i class="fas fa-tower-broadcast"></i>Who's writing to them<span class="r">{{people.length}} correspondent{{#if plural}}s{{/if}}{{#if waitingTotal}} · <b class="ncm-ct2-sb__w">{{waitingTotal}} waiting</b>{{/if}}</span></div>
          <div class="ncm-ct2-km__mod">
            <div class="ncm-ct2-km__k"><i class="fas fa-tower-broadcast"></i>Switchboard<span class="h">closer to the middle = owed a reply</span></div>
              {{#if many}}<div class="ncm-ct2-sb__chips"><span class="lab">Reached</span>{{#each chips}}<span class="ncm-ct2-sb__chip{{#if on}} is-on{{/if}}{{#if isAlias}} is-alias{{/if}}" data-action="tabAct" data-op="sbIdent" data-ident="{{id}}">{{#if isAlias}}<i class="fas fa-mask"></i>{{/if}}{{label}}<b>{{n}}</b></span>{{/each}}</div>{{/if}}
              <div class="ncm-ct2-sb__dial">
                <svg width="{{size}}" height="{{size}}" viewBox="{{vb}}" role="img" aria-label="Who is writing to {{npcShort}}">
                  <circle class="zone" cx="0" cy="0" r="{{oweR}}"/>
                  <circle class="guide" cx="0" cy="0" r="{{neverR}}"/>
                  <circle class="guide owe" cx="0" cy="0" r="{{oweR}}"/>
                  {{#each guides}}<text class="glbl{{#if owe}} owe{{/if}}" x="{{x}}" y="{{y}}">{{text}}</text>{{/each}}
                  {{#each people}}{{#each links}}<path class="link {{tone}}{{#if dim}} dim{{/if}}" d="{{d}}" stroke-width="{{w}}"/>{{/each}}{{/each}}
                  {{#each wedges}}<path class="wedge {{#if isAlias}}alias{{else}}main{{/if}}{{#if on}} on{{/if}}{{#if dim}} dim{{/if}}" d="{{d}}" data-action="tabAct" data-op="sbIdent" data-ident="{{id}}" data-tooltip="{{name}} — {{count}} message(s) · click to see only this identity"/>{{/each}}
                  <circle class="core" cx="0" cy="0" r="{{coreR}}"/>
                  {{#each wedges}}{{#if labelFits}}<text class="wlbl" x="{{lx}}" y="{{ly}}" transform="rotate({{rot}} {{lx}} {{ly}})">{{short}}</text>{{/if}}{{/each}}
                  {{#each people}}<g class="pp{{#if dim}} dim{{/if}}">{{#if sel}}<circle class="selr" cx="{{x}}" cy="{{y}}" r="{{selR}}"/>{{/if}}{{#if waiting}}<circle class="halo" cx="{{x}}" cy="{{y}}" r="{{haloR}}"/>{{/if}}<circle class="dot {{#if never}}never{{else if isPc}}pc{{else}}npc{{/if}}{{#if sel}} sel{{/if}}" cx="{{x}}" cy="{{y}}" r="{{r}}" style="{{dotStyle}}" data-action="tabAct" data-op="sbPick" data-key="{{key}}" data-tooltip="{{tip}}"/></g>{{/each}}
                  {{#each people}}{{#if arrow}}<path class="dir {{#if arrow.theirs}}theirs{{else}}yours{{/if}}{{#if dim}} dim{{/if}}" d="M 4.5 0 L -3.5 -4 L -3.5 4 Z" transform="{{arrow.tf}}" data-tooltip="{{arrow.tip}}"/>{{/if}}{{/each}}
                  {{#each people}}{{#if label}}<text class="nm{{#unless isPc}} is-npc{{/unless}}{{#if dim}} dim{{/if}}" x="{{label.x}}" y="{{label.y}}" text-anchor="{{label.anchor}}">{{name}}{{#if waiting}}<tspan class="w" dx="4">{{waiting}}</tspan>{{/if}}</text>{{/if}}{{/each}}
                </svg>
              </div>
              <div class="ncm-ct2-sb__legend"><span><i class="k pc"></i>player</span><span><i class="k npc"></i>NPC</span><span><i class="k owe"></i>waiting on {{npcShort}}</span><span><i class="fas fa-play theirs"></i>they wrote last</span><span><i class="fas fa-play yours"></i>answered</span></div>
          </div>
          {{#with card}}
          <div class="ncm-ct2-km__mod ncm-ct2-sb__card">
            <div class="ncm-ct2-km__k"><i class="fas fa-id-card"></i>Correspondent<span class="h">{{#if isPc}}player character{{#if player}} · {{player}}{{/if}}{{else}}NPC{{/if}}</span></div>
            <div class="ncm-ct2-sb__cd">
              {{#if img}}<img class="ph" src="{{img}}" alt="">{{else}}<span class="ph">{{initials}}</span>{{/if}}
              <div class="hd">
                <div class="nm">{{name}}</div>
                <div class="tags">{{#each idents}}<span class="ncm-tagp {{#if isAlias}}is-secret{{else}}is-plain{{/if}}">{{#if isAlias}}<i class="fas fa-mask"></i>{{/if}}{{name}} ×{{n}}</span>{{/each}}</div>
                <div class="meta">{{#if waiting}}<b>{{waiting}} waiting · {{waitLabel}}</b> · {{/if}}{{#if count}}<span class="num">{{count}}</span> {{msgWord}} · last {{lastLabel}}{{else}}holds the contact · never written{{/if}}</div>
              </div>
              {{#if waitMsgs.length}}<div class="blk"><div class="bk is-attn"><i class="fas fa-bell"></i>Waiting on a reply</div>
                {{#each waitMsgs}}<div class="wr"><span class="led"></span><span class="s">{{subject}}</span><span class="t">{{when}}</span></div>{{/each}}</div>{{/if}}
              {{#if recent.length}}<div class="blk"><div class="bk"><i class="fas fa-clock-rotate-left"></i>Last messages</div>
                {{#each recent}}<div class="ncm-ct2-recent" data-action="tabAct" data-op="recentOpen" data-inbox="{{inboxId}}" data-message="{{messageId}}"><span class="ncm-ct2-dir {{#if sent}}is-out{{else}}is-in{{/if}}" data-tooltip="{{#if sent}}Sent to them{{else}}They sent this{{/if}}"><i class="fas {{#if sent}}fa-arrow-up-right{{else}}fa-arrow-down-left{{/if}}"></i></span><span class="s">{{subject}}</span><span class="w{{#if isAlias}} is-alias{{/if}}">{{#if isAlias}}{{identName}}{{/if}}</span><span class="t">{{when}}</span></div>{{/each}}</div>{{/if}}
              {{#if trust}}<div class="blk"><div class="bk"><i class="fas fa-handshake"></i>How {{name}} rates {{npcShort}}</div>
                <div class="ncm-ct2-trust" style="--tc:{{trust.color}}"><span class="tb">{{#each trust.segs}}<span class="{{#if on}}on{{/if}}" data-action="tabAct" data-op="trustPlayer" data-id="{{cid}}" data-actor="{{actorId}}" data-v="{{v}}"></span>{{/each}}</span><span class="lv">{{trust.label}}</span></div></div>{{/if}}
              {{#if asOpts.length}}<div class="blk"><div class="bk"><i class="fas fa-pen"></i>Write as{{#if lastUsed}}<span class="r">they last wrote to {{lastUsed}}</span>{{/if}}</div>
                <span class="ncm-ct2-sb__as">{{#each asOpts}}<span class="{{#if on}}is-on{{/if}}{{#if isAlias}} is-alias{{/if}}" data-action="tabAct" data-op="sbAs" data-ident="{{id}}">{{#if isAlias}}<i class="fas fa-mask"></i>{{/if}}{{name}}</span>{{/each}}</span></div>{{/if}}
              <div class="acts">
                {{#if reply}}<button type="button" class="ncm-ct2-btn ncm-ct2-btn--primary" data-action="tabAct" data-op="sbReply" data-journal="{{reply.journalId}}" data-page="{{reply.pageId}}" data-as="{{reply.as}}"><i class="fas fa-reply"></i> Reply as {{reply.short}}</button>{{/if}}
                <button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="sbWrite" data-as="{{asId}}" data-actor="{{actorId}}" data-email="{{email}}"><i class="fas fa-pen"></i> Write as {{asShort}}</button>
                {{#if convMessage}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="recentOpen" data-inbox="{{convInbox}}" data-message="{{convMessage}}"><i class="fas fa-comments"></i> Conversation</button>{{/if}}
                {{#if isPc}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="pInbox" data-actor="{{actorId}}"><i class="fas fa-inbox"></i> {{name}}'s inbox</button>{{/if}}
                {{#unless knows}}<button type="button" class="ncm-ct2-btn" data-action="tabAct" data-op="whoToggle" data-id="{{cid}}" data-actor="{{actorId}}"><i class="fas fa-share-nodes"></i> Share {{npcShort}} with {{name}}</button>{{/unless}}
              </div>
            </div>
          </div>
          {{/with}}
        </div>
        {{/with}}{{/if}}
        {{!-- sb:end --}}

        {{#if onMain}}

        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-users"></i>Who knows {{whoLabel}}<span class="r">click to share or take back</span></div>
          {{#if hasPcs}}
            <div class="ncm-ct2-who">
              {{#each who}}<span class="ncm-ct2-pc {{#if on}}on{{/if}}" data-action="tabAct" data-op="whoToggle" data-id="{{../id}}" data-actor="{{actorId}}" data-tooltip="{{#if on}}{{name}} has {{#if held}}{{held}}{{else}}this contact{{/if}} — click to take it back{{else}}Share with {{name}}{{/if}}">{{#if img}}<img src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av ncm-ct2-av--xs" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}{{name}}{{#if on}}<span class="s">✓</span>{{/if}}</span>{{/each}}
            </div>
          {{else}}<div class="ncm-ct2-quiet">No player characters yet.</div>{{/if}}
        </div>

        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-handshake"></i>Trust<span class="r">how {{name}} sees each of them</span></div>
          <div class="ncm-ct2-trust" style="--tc:{{trust.color}}"><span class="ncm-ct2-trust__lead"><i class="fas fa-users"></i></span><span>Default</span>
            <span class="tb">{{#each trust.segs}}<span class="{{#if on}}on{{/if}}" data-action="tabAct" data-op="trustDefault" data-id="{{../id}}" data-v="{{v}}"></span>{{/each}}</span><span class="lv">{{trust.label}}</span></div>
          {{#each trust.rows}}
            <div class="ncm-ct2-trust" style="--tc:{{color}}">
              {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av ncm-ct2-av--xs" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}<span>{{name}}{{#if override}}<sup>*</sup>{{/if}}</span>
              <span class="tb">{{#each segs}}<span class="{{#if on}}on{{/if}}" data-action="tabAct" data-op="trustPlayer" data-id="{{../../id}}" data-actor="{{../actorId}}" data-v="{{v}}"></span>{{/each}}</span>
              <span class="lv">{{label}}</span>
            </div>
            {{#if rel}}<div class="ncm-ct2-trust__note"><span class="ncm-ct2-tag">{{rel}}</span>{{note}}</div>{{else if note}}<div class="ncm-ct2-trust__note">{{note}}</div>{{/if}}
          {{/each}}
        </div>

        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-masks-theater"></i>Identities<span class="r">{{#if ids.many}}mail to any of them reaches {{ids.mainName}}{{else}}just this one{{/if}}</span></div>
          <div class="ncm-ct2-ids">
            {{#each ids.rows}}
              <div class="ncm-ct2-id {{#if cur}}cur{{/if}}" {{#unless cur}}data-action="tabAct" data-op="identOpen" data-id="{{id}}"{{/unless}}>
                {{#if img}}<img class="ncm-ct2-av" src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}
                <div><div>{{name}}</div><div class="a">{{email}}{{#if uses}} · {{uses}} mail{{/if}}</div></div>
                {{#if main}}<i class="fas fa-star star" data-tooltip="Main identity"></i>{{else}}<i class="fas fa-star star off" data-action="tabAct" data-op="star" data-id="{{id}}" data-tooltip="Make this the main identity"></i>{{/if}}
              </div>
            {{/each}}
          </div>
          {{#if ids.registered}}<div class="ncm-ct2-hint">The character’s registered address is <b>{{ids.registered}}</b>.</div>{{/if}}
          <span class="ncm-ct2-add" data-action="tabAct" data-op="aliasAdd" data-id="{{id}}"><i class="fas fa-plus"></i>Add an alias</span>
        </div>

        {{#if recent.length}}
          <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-clock-rotate-left"></i>Recent mail</div>
            {{#each recent}}<div class="ncm-ct2-recent" data-action="tabAct" data-op="recentOpen" data-inbox="{{inboxId}}" data-message="{{messageId}}"><span class="ncm-ct2-dir {{#if sent}}is-out{{else}}is-in{{/if}}" data-tooltip="{{#if sent}}They sent this{{else}}Sent to them{{/if}}"><i class="fas {{#if sent}}fa-arrow-up-right{{else}}fa-arrow-down-left{{/if}}"></i></span><span class="s">{{subject}}</span><span class="w">{{who}}</span><span class="t">{{when}}</span></div>{{/each}}
          </div>
        {{/if}}

        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-id-card"></i>Details<a data-action="tabAct" data-op="edit" data-id="{{id}}">Edit</a></div>
          <div class="ncm-ct2-kv">{{#each kv}}<div><span class="l">{{l}}</span>{{#if tags.length}}<span class="ncm-kvtags">{{#each tags}}<span class="ncm-tagp" style="--tc:{{ncm-hue this}}"><i class="fas fa-tag"></i>{{this}}</span>{{/each}}</span>{{else}}<span class="ncm-kvv {{cls}}"{{#if hue}} style="--tc:{{ncm-hue hue}}"{{/if}}>{{v}}</span>{{/if}}</div>{{/each}}</div>
        </div>
        <div class="ncm-ct2-sec"><div class="k"><i class="fas fa-note-sticky"></i>GM notes<span class="r">saves when you click away</span></div>
          <div class="ncm-ct2-gmnotes">
            <div class="ncm-ct2-gmnote">
              <span class="l">Notes</span>
              <textarea class="ncm-ct2-notes" data-ct2-notes="{{id}}" placeholder="Private notes — players never see these">{{notes}}</textarea>
            </div>
            <div class="ncm-ct2-gmnote {{#if voice.inherited}}is-inherited{{/if}}">
              <span class="l"><i class="fas fa-comment-dots"></i>Voice{{#if voice.inherited}}<em class="from">from {{voice.from}}</em>{{/if}}</span>
              <textarea class="ncm-ct2-notes ncm-ct2-voice" data-ct2-voice="{{id}}" placeholder="{{voice.placeholder}}">{{voice.own}}</textarea>
              <span class="h">Players never see this; an alias uses the main identity’s voice unless it has its own.</span>
            </div>
          </div>
        </div>
        {{/if}}
        {{/with}}
      {{else}}
        <div class="ncm-ct2-empty"><i class="fas fa-address-card"></i><p>Pick a contact on the left.</p></div>
      {{/if}}
      </div>
    </div>
  {{/if}}

  {{!-- ═══════════════════ PLAYERS ═══════════════════ --}}
  {{#if ct2.isPlayers}}
    <header class="ncm-tabhd"><i class="fas fa-user"></i><div><h2>Players</h2><p>Each player character — their address, who they know, the groups they hold and their aliases.</p></div></header>
    {{#if ct2.players.empty}}
      <div class="ncm-ct2-empty"><i class="fas fa-user"></i><p>No player characters yet. Assign characters to players, or give a player ownership of an actor.</p></div>
    {{else}}
    {{!-- The Directory's ONE toolbar row (2026-10-28): search · Show · needs-you counts · Group · Sort · fold. --}}
    <div class="ncm-ct2-tb ncm-ct2-tb--one">
      <span class="srch"><i class="fas fa-magnifying-glass"></i><input type="text" data-ct2-q="players" value="{{ct2.players.search}}" placeholder="Search character, player, address, scene…"></span>
      <select class="ncm-ct2-show {{#if ct2.players.showOn}}is-on{{/if}}" data-ct2-select="pShow" data-tooltip="Which characters to list">{{#each ct2.players.chips}}<option value="{{key}}" {{#if on}}selected{{/if}}>Show: {{label}} ({{n}})</option>{{/each}}</select>
      {{#each ct2.players.alerts}}<button type="button" class="ncm-ct2-tbalert is-{{tone}} {{#if on}}on{{/if}}" data-action="tabAct" data-op="pFilter" data-filter="{{key}}" data-tooltip="{{n}} {{label}} — {{#if on}}click to show all again{{else}}click to show only these{{/if}}" aria-label="{{label}}: {{n}}"><i class="fas {{icon}}"></i>{{n}}</button>{{/each}}
      <select data-ct2-select="pGroup">{{#each ct2.players.groupOpts}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
      <select data-ct2-select="pSort">{{#each ct2.players.sortOpts}}<option value="{{v}}" {{#if on}}selected{{/if}}>{{l}}</option>{{/each}}</select>
      {{#if ct2.players.canFold}}<button type="button" class="ncm-ct2-tbfold" data-action="tabAct" data-op="pFoldAll" data-fold="{{#if ct2.players.allShut}}open{{else}}close{{/if}}" data-tooltip="{{#if ct2.players.allShut}}Expand every group{{else}}Collapse every group{{/if}}" aria-label="{{#if ct2.players.allShut}}Expand all{{else}}Collapse all{{/if}}"><i class="fas fa-{{#if ct2.players.allShut}}expand{{else}}compress{{/if}}"></i></button>{{/if}}
    </div>
    {{#if ct2.players.narrowed}}<div class="ncm-ct2-facets"><span class="lab">Showing</span><span class="n">{{ct2.players.shown}} of {{ct2.players.total}}</span></div>{{/if}}
    <div class="ncm-ct2-split">
      <div class="ncm-ct2-list" data-ct2-scroll="plist">
        {{#if ct2.players.nothing}}<div class="ncm-ct2-empty"><p>Nothing matches.</p></div>{{/if}}
        {{#each ct2.players.groups}}
          <div class="ncm-ct2-grp {{#if shut}}is-shut{{/if}}"{{#if hue}} style="--gc:{{ncm-hue hue}}"{{/if}} data-action="tabAct" data-op="pFold" data-key="{{key}}" data-shut="{{#if shut}}1{{/if}}" role="button" tabindex="0" aria-expanded="{{#if shut}}false{{else}}true{{/if}}" data-tooltip="{{#if shut}}Show{{else}}Hide{{/if}} {{label}}"><i class="fas fa-chevron-{{#if shut}}right{{else}}down{{/if}} ncm-ct2-grp__chev"></i><i class="{{icon}}"></i>{{label}}
            {{#if shut}}{{#if unread}}<span class="ncm-ct2-grp__w" data-tooltip="{{unread}} unread in {{label}}"><i class="fas fa-envelope"></i>{{unread}} unread</span>{{/if}}{{#if noaddr}}<span class="ncm-ct2-grp__p" data-tooltip="{{noaddr}} with no address"><i class="fas fa-at"></i>{{noaddr}}</span>{{/if}}{{/if}}
            <span class="n">{{n}}</span></div>
          {{#unless shut}}
          {{#each rows}}
            {{> ncmCt2PlayerRow}}
          {{/each}}
          {{/unless}}
        {{/each}}
        {{#each ct2.players.rows}}
          {{> ncmCt2PlayerRow}}
        {{/each}}
        {{#*inline "ncmCt2PlayerRow"}}
          <div class="ncm-ct2-r {{#if sel}}sel{{/if}}{{#if noEmail}} is-check{{/if}}" data-action="tabAct" data-op="pSel" data-actor="{{actorId}}">
            {{#if img}}<img class="ncm-ct2-av" src="{{img}}" alt="">{{else}}<span class="ncm-ct2-av" style="--tc:{{ncm-hue name}}">{{initials}}</span>{{/if}}
