{{!-- Admin → Phone (COMMS) — the GM's side of calls. Mock: dev/mockups/admin-phone-mock.html, design dev/design/CALLS.md §10.
      Context: phone2 (PhoneTab.js + phoneModel.js). Buttons: data-action="tabAct" data-owner="phone" data-op=… --}}
{{#if (eq activeTab 'phone')}}
{{#with phone2}}
<div class="ncm-ph2{{#if isPopout}} ncm-ph2--pop{{/if}}" data-owner="phone">
{{#if missing}}
  <div class="ncm-ph2-none"><i class="fas fa-phone-slash"></i> Calls did not load. Reload the world.</div>
{{else}}
  <nav class="ncm-ph2-nav" role="tablist">
    {{#each nav}}<button type="button" role="tab" aria-selected="{{#if on}}true{{else}}false{{/if}}" class="ncm-ph2-navbtn{{#if on}} on{{/if}}" data-action="tabAct" data-owner="phone" data-op="view" data-view="{{key}}" data-tooltip="{{ncm-tip label}}" aria-label="{{label}}"><i class="fas {{icon}}"></i><span class="lb">{{label}}</span>{{#if count}}<span class="ncm-ph2-navct{{#if hot}} hot{{/if}}">{{count}}</span>{{/if}}</button>{{/each}}
    <span class="grow"></span>
    {{#unless enabled}}<span class="ncm-tagp is-bad"><i class="fas fa-power-off"></i> Calls are off</span>{{/unless}}
    {{#each partsOff}}<span class="ncm-tagp"><i class="fas fa-power-off"></i> {{this}} off</span>{{/each}}
    {{#unless isPopout}}<button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="popOutTab" data-tab="phone" aria-label="Pop out" data-tooltip="Pop out — a bigger window"><i class="fas fa-up-right-from-square"></i></button>{{/unless}}
  </nav>
  {{#if error}}<div class="ncm-ph2-err"><i class="fas fa-triangle-exclamation"></i> {{error}}</div>{{/if}}
  {{#if viewOff}}<div class="ncm-ph2-err"><i class="fas fa-power-off"></i> {{viewOff}}</div>{{/if}}

{{!-- ═══ LIVE ═══ --}}
{{#if (eq view 'live')}}
  <header class="ncm-tabhd"><i class="fas fa-tower-broadcast"></i><div><h2>Live</h2><p>Every call happening now, and the NPC lines ringing for you.</p></div>
    <div class="ncm-tabhd__end"><button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="callAs"><i class="fas fa-phone"></i> Call a player as…</button></div></header>

  {{#if live.emergencies.length}}<section class="ncm-ph2-mod ncm-ph2-mod--em">
    <div class="ncm-ph2-mh"><i class="fas fa-truck-medical"></i><b>Emergencies</b><small>they never wait in the queue</small></div>
    {{#each live.emergencies}}
    <div class="ncm-ph2-em">
      <span class="ncm-ph2-emic"><i class="fas {{#if isTrauma}}fa-truck-medical{{else}}fa-shield-halved{{/if}}"></i></span>
      <div class="t"><b>{{who}}</b> <span class="ncm-tagp is-{{#if isTrauma}}bad{{else}}act{{/if}}">{{word}}</span>{{#if auto}} <span class="ncm-tagp is-attn">Biomonitor</span>{{/if}}
        <div class="sub">{{detail}}</div></div>
      <span class="ncm-ph2-tm">{{#if arrived}}on scene{{else}}{{left}} of {{rounds}} rounds{{#if held}} · held{{/if}}{{/if}}</span>
      <span class="acts">
        {{#unless arrived}}<button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="emHold" data-id="{{id}}" data-tooltip="{{#if held}}Start counting down again{{else}}Stop the countdown. They stay on the way until you start it or they arrive{{/if}}"><i class="fas {{#if held}}fa-play{{else}}fa-pause{{/if}}"></i> {{#if held}}Resume{{else}}Hold{{/if}}</button>
        <button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="emMinus" data-id="{{id}}" data-tooltip="A round passed"><i class="fas fa-forward-step"></i> -1 round</button>
        <button type="button" class="ncm-ph2-btn ncm-ph2-btn--go" data-action="tabAct" data-owner="phone" data-op="emArrive" data-id="{{id}}" data-tooltip="Everyone looking at that scene sees them arrive"><i class="fas fa-location-dot"></i> They arrive</button>{{/unless}}
        <button type="button" class="ncm-ph2-btn ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="emOff" data-id="{{id}}" data-tooltip="{{#if arrived}}The job is over: the plan can be used again{{else}}Call them off{{/if}}"><i class="fas fa-xmark"></i> {{#if arrived}}Job over{{else}}Call off{{/if}}</button>
      </span>
    </div>
    {{/each}}
  </section>{{/if}}

  <section class="ncm-ph2-mod ncm-ph2-mod--ring">
    <div class="ncm-ph2-mh"><i class="fas fa-phone-volume"></i><b>Call queue</b><small>{{queue.count}} waiting, longest first</small></div>
    {{#if active}}<div class="ncm-r5-active"><i class="fas fa-phone"></i><span class="grow">You are <b>{{active.to.name}}</b>, talking to <b>{{active.from.name}}</b>.<small>Answering another call puts this one on hold.</small></span>
      <button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="qPass" data-id="{{active.id}}" data-tooltip="Put them through to someone else. They hear: One moment"><i class="fas fa-right-left"></i> Pass to…</button>
      <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="hangup" data-id="{{active.id}}" aria-label="Hang up" data-tooltip="Hang up"><i class="fas fa-phone-slash"></i></button></div>{{/if}}
    {{#if queue.count}}<div class="ncm-ph2-tb"><label class="ncm-ph2-sel" data-tooltip="Show one kind of call"><span>Show</span><select data-ph-qfilt>{{#each queueShow}}<option value="{{k}}"{{#if on}} selected{{/if}}>{{l}}</option>{{/each}}</select></label><span class="grow"></span>
      <button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="qHoldAll" data-tooltip="A breather. Nobody goes to voicemail while you catch up"><i class="fas fa-pause"></i> Hold everyone</button>
      <button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="qVmAll" data-tooltip="Clears the queue. Each caller hears that person's greeting"><i class="fas fa-voicemail"></i> Voicemail for all</button></div>{{/if}}
    <div class="ncm-r5-qlist">
    {{#each queue.rows}}
    <div class="ncm-r5-q{{#if open}} is-open{{/if}}{{#if held}} is-held{{/if}}">
      <button type="button" class="hd" data-action="tabAct" data-owner="phone" data-op="qOpen" data-id="{{id}}" aria-expanded="{{#if open}}true{{else}}false{{/if}}" data-tooltip="{{#if open}}Fold{{else}}Open{{/if}} this call"><span class="pos">{{pos}}</span><span class="grow"><b>{{from.name}}</b> calling <b>{{asks}}</b></span><span class="ncm-tagp {{#if isSpecial}}is-secret{{else}}is-plain{{/if}}"><i class="fas {{icon}}"></i> {{word}}</span>{{#if held}}<span class="ncm-tagp is-attn" data-tooltip="Their clock has stopped. They see: On hold"><i class="fas fa-pause"></i> On hold</span>{{else}}<span class="ncm-ph2-tm" data-ph-since="{{startedAt}}" data-tooltip="How long they have waited">{{waitS}}</span>{{/if}}</button>
      {{#if open}}<div class="bd">
        {{#if voice}}<div class="voice"><i class="fas fa-comment-dots"></i> {{voice}}</div>{{/if}}
        <small>{{from.number}}{{#if net}} · {{net}}{{/if}}</small>
        <div class="acts">
          <button type="button" class="ncm-ph2-btn ncm-ph2-btn--go" data-action="tabAct" data-owner="phone" data-op="answer" data-id="{{id}}"><i class="fas fa-phone"></i> Answer as {{asks}}</button>
          <button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="qAsWho" data-id="{{id}}" data-tooltip="Anyone at this company, or any NPC. Search and filter"><i class="fas fa-magnifying-glass"></i> Answer as…</button>
          {{#if held}}<button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="qHold" data-id="{{id}}" data-on="0" data-tooltip="Starts their clock again"><i class="fas fa-phone-volume"></i> Back to ringing</button>
          {{else}}<button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="qHold" data-id="{{id}}" data-tooltip="They see On hold, and it stops their clock so it will not go to voicemail"><i class="fas fa-pause"></i> Hold</button>{{/if}}
          <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="tabAct" data-owner="phone" data-op="decline" data-id="{{id}}" aria-label="Send to voicemail" data-tooltip="Send to voicemail"><i class="fas fa-voicemail"></i></button>
          <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="qRingOut" data-id="{{id}}" aria-label="Decline" data-tooltip="Decline. They hear it ring out"><i class="fas fa-phone-slash"></i></button>
        </div></div>{{/if}}
    </div>
    {{else}}<div class="ncm-ph2-none">Nobody is waiting.</div>{{/each}}
    </div>
  </section>

  {{#if overheard.length}}<section class="ncm-ph2-mod"><div class="ncm-ph2-mh"><i class="fas fa-ear-listen"></i><b>Overheard calls running</b><small>Two NPCs, and who is listening</small></div>
    {{#each overheard}}<div class="ncm-r5-over"><i class="fas fa-tower-broadcast"></i><div class="grow"><b>{{name}}</b><small>{{a}} and {{b}} · line {{line}} of {{of}} · {{listening}} listening</small></div>{{#each faces}}<span class="ncm-ph2-face" data-tooltip="{{ncm-tip name}}">{{ini}}</span>{{/each}}<button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="ovOpenRun" data-id="{{id}}" data-tooltip="The running screen"><i class="fas fa-up-right-from-square"></i> Open</button></div>{{/each}}</section>{{/if}}

  <section class="ncm-ph2-mod">
    <div class="ncm-ph2-mh"><i class="fas fa-shuffle"></i><b>Switchboard</b><small>every call in the world right now</small><span class="grow"></span>
      {{#if live.modes.loud}}<span class="ncm-tagp is-plain">Out loud {{live.modes.loud}}</span>{{/if}}{{#if live.modes.type}}<span class="ncm-tagp is-act">Typed {{live.modes.type}}</span>{{/if}}{{#if live.modes.dictate}}<span class="ncm-tagp is-plain">Dictated {{live.modes.dictate}}</span>{{/if}}</div>
    {{#each live.lines}}
    <div class="ncm-ph2-line is-{{state}}">
      <span class="end"><span class="ncm-ph2-face"{{#if from.img}} style="background-image:url('{{ncm-css-url from.img}}')"{{/if}}>{{#unless from.img}}{{from.initials}}{{/unless}}</span><span class="t"><span class="nm">{{from.name}}{{#if anon}} <span class="ncm-tagp is-secret" data-tooltip="The other end sees Unknown caller"><i class="fas fa-user-secret"></i> withheld</span>{{/if}}</span><span class="ncm-ph2-num">{{from.number}}</span></span></span>
      <span class="cord"><span class="w"></span><span class="mid"><span class="ncm-tagp is-{{#if (eq state 'live')}}good{{else if (eq state 'held')}}attn{{else}}plain{{/if}}">{{stateWord}}</span>{{#if timer}}<span class="ncm-ph2-tm" data-ph-since="{{answeredAt}}">{{timer}}</span>{{/if}}{{#if net}}<span class="net">{{net}}</span>{{/if}}</span></span>
      <span class="end r"><span class="t"><span class="nm">{{to.name}}{{#if mine}} <span class="ncm-tagp is-secret">you</span>{{/if}}</span><span class="ncm-ph2-num">{{to.number}}</span></span><span class="ncm-ph2-face"{{#if to.img}} style="background-image:url('{{ncm-css-url to.img}}')"{{/if}}>{{#unless to.img}}{{to.initials}}{{/unless}}</span></span>
      <span class="acts">
        {{#unless mine}}<button type="button" class="ncm-ph2-btn{{#if listening}} ncm-ph2-btn--on{{/if}}" data-action="tabAct" data-owner="phone" data-op="listen" data-id="{{id}}" aria-pressed="{{#if listening}}true{{else}}false{{/if}}" data-tooltip="Follow what they type on this call"><i class="fas fa-ear-listen"></i> {{#if listening}}Listening{{else}}Listen{{/if}}{{#if lineCount}} <span class="ncm-ph2-c">{{lineCount}}</span>{{/if}}</button>{{/unless}}
        {{#if (or (eq state 'live') (eq state 'held'))}}<button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="glitch" data-id="{{id}}" data-tooltip="Make the line stutter for a few seconds on both ends"><i class="fas fa-wave-square"></i> Glitch</button>{{/if}}
        {{#if mine}}<button type="button" class="ncm-ph2-btn ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="hangup" data-id="{{id}}"><i class="fas fa-phone-slash"></i> Hang up</button>
        {{else}}<button type="button" class="ncm-ph2-btn ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="drop" data-id="{{id}}" data-tooltip="Cut it off — both sides see Call dropped, and why"><i class="fas fa-plug-circle-xmark"></i> Drop</button>{{/if}}
      </span>
      {{#if listening}}<div class="ncm-ph2-listen"><div class="k"><i class="fas fa-ear-listen"></i> What they type — only you see this</div>
        {{#each heard}}<div class="l"><b class="is-{{side}}">{{name}}:</b> {{text}}</div>{{else}}<div class="l none">Nothing typed yet — they may be talking out loud.</div>{{/each}}</div>{{/if}}
    </div>
    {{else}}<div class="ncm-ph2-none">No calls on the line.</div>{{/each}}
  </section>

  <section class="ncm-ph2-mod">
    <div class="ncm-ph2-mh"><i class="fas fa-tower-cell"></i><b>Network load</b><small>calls on each network — now, and today on the game clock</small><span class="grow"></span>
      <span class="ncm-tagp is-plain">{{load.now}} now</span><span class="ncm-tagp is-plain">{{load.today}} today</span></div>
    {{#each load.rows}}
    <div class="ncm-ph2-load"{{#if color}} style="--nc:{{color}}"{{/if}}>
      <span class="nm">{{name}}</span>
      <span class="bar"><i style="width:{{pct}}%"></i></span>
      <span class="n">{{#if now}}<b>{{now}}</b> now · {{/if}}{{today}} today</span>
      {{#if cut}}<span class="ncm-tagp is-bad" data-tooltip="A node is {{ncm-tip cut}} on the scene you are viewing — calls over it there drop">{{cut}} here</span>{{/if}}
    </div>
    {{else}}<div class="ncm-ph2-none">No calls today.</div>{{/each}}
  </section>
{{/if}}

{{!-- ═══ NUMBERS + NUMBER SETUP ═══ (phoneNumbersView.js) --}}
{{#if numbersHtml}}{{{numbersHtml}}}{{/if}}

{{!-- ═══ PAYPHONES ═══ (payphonesView.js) --}}
{{#if payphonesHtml}}{{{payphonesHtml}}}{{/if}}

{{!-- ═══ CALL LOG ═══ --}}
{{#if (eq view 'log')}}
  <header class="ncm-tabhd"><i class="fas fa-list"></i><div><h2>Call log</h2><p>Every call in the world, newest first.</p></div>
    <div class="ncm-tabhd__end"><button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="logEdit" data-tooltip="Write history for a person or a machine: a missed call, a voicemail, a trail for players to find"><i class="fas fa-pen"></i> Edit a log</button></div></header>
  <div class="ncm-ph2-subt" role="tablist">{{#each logTabs}}<button type="button" role="tab" aria-selected="{{#if on}}true{{else}}false{{/if}}" class="{{#if on}}on{{/if}}" data-action="tabAct" data-owner="phone" data-op="logTab" data-view="{{key}}"><i class="fas {{icon}}"></i> {{label}}{{#if count}}<span class="ncm-ph2-navct hot">{{count}}</span>{{/if}}</button>{{/each}}</div>
  <div class="ncm-ph2-tb">
    <span class="ncm-ph2-srch"><i class="fas fa-magnifying-glass"></i><input type="text" data-ph-q="log" placeholder="Name, number, network, scene, words said…" value="{{log.q}}">{{#if log.q}}<button type="button" data-action="tabAct" data-owner="phone" data-op="clearQ" data-which="log" aria-label="Clear search"><i class="fas fa-xmark"></i></button>{{/if}}</span>
    <label class="ncm-ph2-sel"><span>Result</span><select data-ph-logresult>{{#each log.resultOptions}}<option value="{{k}}"{{#if on}} selected{{/if}}>{{l}}</option>{{/each}}</select></label>
    <label class="ncm-ph2-sel"><span>Group</span><select data-ph-loggroup>{{#each log.groupOptions}}<option value="{{k}}"{{#if on}} selected{{/if}}>{{l}}</option>{{/each}}</select></label>
    <details class="ncm-ph2-dd" data-ph-logmenu{{#if log.menu}} open{{/if}}><summary class="ncm-ph2-btn" data-tooltip="Narrow by who, network or dates"><i class="fas fa-filter"></i> Filter{{#if log.filterCount}} <span class="ncm-ph2-c">{{log.filterCount}}</span>{{/if}}</summary>
      <div class="ncm-ph2-ddp">
        <div class="ncm-ph2-ddr"><span>Who</span>{{{log.whoPicker}}}</div>
        <div class="ncm-ph2-ddr"><span>Network</span>{{{log.netPicker}}}</div>
        <div class="ncm-ph2-ddr"><span>Dates</span><button type="button" class="ncm-ph2-btn" data-action="tabAct" data-owner="phone" data-op="logDates"><i class="fas fa-calendar"></i> Pick a range</button></div>
      </div></details>
    <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="tabAct" data-owner="phone" data-op="foldToggle" aria-label="Open or close every group" data-tooltip="Open or close every group"><i class="fas fa-up-down"></i></button>
  </div>
  {{#if log.forced}}<div class="ncm-ph2-count"><span>{{log.found}}</span>{{#each log.pills}}<button type="button" class="ncm-ph2-pill" data-action="tabAct" data-owner="phone" data-op="logUnfilter" data-k="{{k}}" data-tooltip="Remove this filter">{{text}} <i class="fas fa-xmark"></i></button>{{/each}}<button type="button" class="ncm-ph2-lnk" data-action="tabAct" data-owner="phone" data-op="logClear">Clear all</button></div>{{/if}}
  <div class="ncm-ph2-bands">
    {{#each log.bands}}
    <section class="ncm-ph2-grp{{#if shut}} is-shut{{/if}}" data-ph-group="{{key}}">
      <div class="ncm-ph2-gh" data-ph-fold role="button" tabindex="0" aria-expanded="{{#if shut}}false{{else}}true{{/if}}"><i class="fas fa-chevron-down ch"></i><b>{{label}}</b>{{#if dateText}}<span class="ncm-ph2-tm">{{dateText}}</span>{{/if}}<span class="ncm-ph2-c">{{total}}</span>{{#if hot}}<span class="ncm-tagp is-bad">{{hot}} missed or dropped</span>{{/if}}</div>
      <div class="ncm-ph2-gb"><div>
      {{#each days}}{{#if divider}}<div class="ncm-ph2-day">{{label}}<span class="ncm-ph2-c">{{rows.length}}</span></div>{{/if}}
      {{#each rows}}
      <div class="ncm-ph2-lrow" style="--dc:var(--ncm-{{info.tone}}, var(--ncm-text-label))">
        <span class="d"><i class="fas {{info.icon}}"></i></span>
        <span class="t"><span class="pair">{{{fromHtml}}}<i class="fas fa-arrow-right"></i>{{{toHtml}}}</span>
          <span class="meta"><span class="ncm-tagp is-{{info.tone}}">{{info.word}}</span>{{#if detail}}<span class="ncm-ph2-tm">{{detail}}</span>{{/if}}{{#if net}}<span class="net">{{net}}</span>{{/if}}{{#if scene}}<span class="sub">{{scene}}</span>{{/if}}{{#if anon}}<span class="ncm-tagp is-secret"><i class="fas fa-user-secret"></i> withheld</span>{{/if}}{{#if heardBy.length}}<span class="ncm-tagp is-secret" data-tooltip="Caught by a tap or sniffer: {{ncm-tip (join heardBy ', ')}}"><i class="fas fa-ear-listen"></i> heard by {{heardBy.length}}</span>{{/if}}</span>
          {{#if why}}<span class="why"><i class="fas fa-tower-broadcast"></i> {{why}}</span>{{/if}}
          {{#if hitHtml}}<span class="ncm-ph2-hit"><i class="fas fa-closed-captioning"></i> {{{hitHtml}}}</span>{{/if}}
          {{#if transcript.length}}<details class="ncm-ph2-tr"><summary><i class="fas fa-closed-captioning"></i> Transcript · {{transcript.length}} {{#if (eq transcript.length 1)}}line{{else}}lines{{/if}}</summary>
            {{#each transcript}}<div class="l"><b class="is-{{side}}">{{name}}:</b> {{text}}</div>{{/each}}</details>{{/if}}</span>
        <span class="ncm-ph2-tm">{{time}}</span>
      </div>
      {{/each}}{{/each}}
      {{#if hidden}}<div class="ncm-ph2-more" data-action="tabAct" data-owner="phone" data-op="more" data-band="{{key}}" role="button" tabindex="0">Show more · {{hidden}} left</div>{{/if}}
      </div></div>
    </section>
    {{else}}<div class="ncm-ph2-none">{{#if @root.phone2.log.forced}}Nothing matches.{{else}}No calls yet.{{/if}}</div>{{/each}}
  </div>
{{/if}}

{{!-- ═══ VOICEMAIL ═══ --}}
{{#if (eq view 'vm')}}
  <header class="ncm-tabhd"><i class="fas fa-voicemail"></i><div><h2>Voicemail</h2><p>What players left for your NPCs: play it, answer it as them, or call back. Players' own boxes are below.</p></div></header>
  <div class="ncm-ph2-subt" role="tablist">{{#each logTabs}}<button type="button" role="tab" aria-selected="{{#if on}}true{{else}}false{{/if}}" class="{{#if on}}on{{/if}}" data-action="tabAct" data-owner="phone" data-op="logTab" data-view="{{key}}"><i class="fas {{icon}}"></i> {{label}}{{#if count}}<span class="ncm-ph2-navct hot">{{count}}</span>{{/if}}</button>{{/each}}</div>
  <div class="ncm-ph2-tb">
    <span class="ncm-ph2-srch"><i class="fas fa-magnifying-glass"></i><input type="text" data-ph-q="vm" placeholder="Name, number, mailbox, words left…" value="{{vm.q}}">{{#if vm.q}}<button type="button" data-action="tabAct" data-owner="phone" data-op="clearQ" data-which="vm" aria-label="Clear search"><i class="fas fa-xmark"></i></button>{{/if}}</span>
    <label class="ncm-ph2-sel"><span>Show</span><select data-ph-vmshow>{{#each vm.showOptions}}<option value="{{k}}"{{#if on}} selected{{/if}}>{{l}}</option>{{/each}}</select></label>
    <label class="ncm-ph2-sel"><span>Group</span><select data-ph-vmgroup>{{#each vm.groupOptions}}<option value="{{k}}"{{#if on}} selected{{/if}}>{{l}}</option>{{/each}}</select></label>
    <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="tabAct" data-owner="phone" data-op="foldToggle" aria-label="Open or close every group" data-tooltip="Open or close every group"><i class="fas fa-up-down"></i></button>
  </div>
  {{#if vm.forced}}<div class="ncm-ph2-count"><span>{{vm.found}}</span><button type="button" class="ncm-ph2-lnk" data-action="tabAct" data-owner="phone" data-op="vmClear">Clear all</button></div>{{/if}}
  <div class="ncm-ph2-bands">
  {{#each vm.groups}}
  <section class="ncm-ph2-grp{{#if shut}} is-shut{{/if}}" data-ph-group="{{key}}" style="--sk:{{#if npc}}var(--ncm-attn){{else}}var(--ncm-hue-3){{/if}}">
    <div class="ncm-ph2-gh" data-ph-fold role="button" tabindex="0" aria-expanded="{{#if shut}}false{{else}}true{{/if}}"><i class="fas fa-chevron-down ch"></i><i class="fas {{#if npc}}fa-inbox{{else}}fa-user{{/if}}"></i><b>{{label}}</b>{{#if dateText}}<span class="ncm-ph2-tm">{{dateText}}</span>{{/if}}<span class="ncm-ph2-c">{{total}}</span>{{#if hot}}<span class="ncm-tagp is-attn">{{hot}} new</span>{{/if}}{{#if player}}<span class="ncm-tagp is-plain">player</span>{{/if}}</div>
    <div class="ncm-ph2-gb"><div>
      {{#each days}}{{#if divider}}<div class="ncm-ph2-day">{{label}}<span class="ncm-ph2-c">{{rows.length}}</span></div>{{/if}}
      {{#each rows}}
      <div class="ncm-ph2-vm{{#unless heard}} is-new{{/unless}}">
        <span class="d"><i class="fas fa-voicemail"></i></span>
        <span class="t"><span class="pair">{{{fromHtml}}}<i class="fas fa-arrow-right"></i>{{{toHtml}}}{{#unless heard}} <span class="ncm-tagp is-attn">new</span>{{/unless}}{{#if tts}} <span class="ncm-tagp is-plain">read out</span>{{/if}}</span>
          {{#if isAudio}}{{#if audio}}<audio class="ncm-ph2-audio" controls preload="none" src="{{audio}}"></audio>{{else}}<span class="msg dim">Recording cleared.</span>{{/if}}{{/if}}
          {{#if text}}<span class="msg">{{{textHtml}}}</span>{{/if}}
          <span class="meta"><span class="ncm-ph2-num">{{from.number}}</span><span class="ncm-ph2-tm">{{when}}</span>{{#if length}}<span class="ncm-ph2-tm">♪ {{length}}</span>{{/if}}</span></span>
        <span class="acts">
          {{#if tts}}<button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="tabAct" data-owner="phone" data-op="vmPlay" data-vm="{{vmId}}" data-owner-id="{{ownerId}}" data-text="{{text}}" data-voice="{{voice}}" data-heard="{{#if heard}}1{{else}}0{{/if}}" data-tooltip="Play"><i class="fas fa-play"></i></button>{{/if}}
          {{#if from.number}}<button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic ncm-ph2-btn--go" data-action="tabAct" data-owner="phone" data-op="vmCallBack" data-number="{{from.number}}" data-to-contact="{{toContactId}}" data-to-actor="{{toActorId}}" data-tooltip="Call back as {{ncm-tip toName}}"><i class="fas fa-phone"></i></button>{{/if}}
          <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="tabAct" data-owner="phone" data-op="vmReply" data-to-contact="{{toContactId}}" data-to-actor="{{toActorId}}" data-from-actor="{{from.actorId}}" data-from-contact="{{from.contactId}}" data-tooltip="Reply by mail as {{ncm-tip toName}}"><i class="fas fa-envelope"></i></button>
          <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic" data-action="tabAct" data-owner="phone" data-op="vmHeard" data-vm="{{vmId}}" data-owner-id="{{ownerId}}" data-heard="{{#if heard}}0{{else}}1{{/if}}" data-tooltip="{{#if heard}}Mark as new{{else}}Mark heard{{/if}}"><i class="fas {{#if heard}}fa-rotate-left{{else}}fa-check{{/if}}"></i></button>
          <button type="button" class="ncm-ph2-btn ncm-ph2-btn--ic ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="vmDel" data-vm="{{vmId}}" data-owner-id="{{ownerId}}" data-tooltip="Delete"><i class="fas fa-trash"></i></button>
        </span>
      </div>
      {{/each}}{{/each}}
      {{#if hidden}}<div class="ncm-ph2-more" data-action="tabAct" data-owner="phone" data-op="more" data-band="{{key}}" role="button" tabindex="0">Show more · {{hidden}} left</div>{{/if}}
    </div></div>
  </section>
  {{else}}<div class="ncm-ph2-none">{{#if @root.phone2.vm.forced}}Nothing matches.{{else}}No voicemail yet. Messages left on any line show up here.{{/if}}</div>{{/each}}
  </div>
{{/if}}

{{!-- ═══ SETTINGS ═══ --}}
{{#if (eq view 'settings')}}
  <header class="ncm-tabhd"><i class="fas fa-sliders"></i><div><h2>Settings</h2><p>How calls work at this table. Changes save as you make them.</p></div></header>
  <section class="ncm-ph2-mod ncm-ph2-set">
    <label class="ncm-ph2-srow"><span><b>Calls on</b><small>Players can call each other and your NPCs.</small></span><input type="checkbox" class="ncm-ph2-check" data-ph-set="callsEnabled"{{#if settings.enabled}} checked{{/if}}></label>
    {{#each settings.parts}}<label class="ncm-ph2-srow"><span><b>{{label}}</b><small>{{hint}} Needs Calls.</small></span><input type="checkbox" class="ncm-ph2-check" data-ph-set="{{key}}"{{#if on}} checked{{/if}}></label>{{/each}}
    <p class="ncm-ph2-srow"><span><small>Turning Calls or one of its parts on or off reloads the world for everyone. Nothing is deleted.</small></span></p>
    <div class="ncm-ph2-srow"><span><b>Ways to talk</b><small>A way switched off disappears from the call screen.</small></span>
      <span class="ncm-ph2-opts">{{#each settings.modes}}<label><input type="checkbox" class="ncm-ph2-check" data-ph-set="callModes" value="{{key}}"{{#if on}} checked{{/if}}> {{label}}</label>{{/each}}</span></div>
    <label class="ncm-ph2-srow"><span><b>A call starts in</b><small>The way a call opens; players can switch.</small></span>
      <select data-ph-set="callDefaultMode">{{#each settings.startModes}}<option value="{{key}}"{{#if on}} selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="ncm-ph2-srow"><span><b>Rings before it gives up</b><small>Seconds a call rings before it counts as missed.</small></span><input type="number" class="mono" min="5" max="120" data-ph-set="callRingSeconds" value="{{settings.ringSeconds}}"></label>
    <label class="ncm-ph2-srow"><span><b>A number nobody owns</b><small>What happens when a player dials a number no one has.</small></span>
      <select data-ph-set="callUnknownNumbers">{{#each settings.unknown}}<option value="{{key}}"{{#if on}} selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="ncm-ph2-srow"><span><b>Recorded voicemail</b><small>Voice messages and recorded greetings (needs a microphone and a secure connection). Off: typed and read-out only.</small></span><input type="checkbox" class="ncm-ph2-check" data-ph-set="voicemailRecording"{{#if settings.recording}} checked{{/if}}></label>
    <label class="ncm-ph2-srow"><span><b>Longest voice message</b><small>Seconds. A recording stops at this length.</small></span><input type="number" class="mono" min="10" max="180" data-ph-set="voicemailMaxSeconds" value="{{settings.maxSeconds}}"></label>
    <label class="ncm-ph2-srow"><span><b>Keep recordings for</b><small>Days. Older recordings are cleared from voicemails (their words stay). 0 = forever.</small></span><input type="number" class="mono" min="0" max="3650" data-ph-set="voicemailKeepDays" value="{{settings.keepDays}}"></label>
    <div class="ncm-ph2-srow"><span><b>Recordings stored</b><small>{{settings.recordings}} voice message{{#unless (eq settings.recordings 1)}}s{{/unless}}{{#if settings.recordingsInline}} · {{settings.recordingsInline}} kept inside the message (uploads were not possible){{/if}}. Files live in the world's ncm-voicemail folder.</small></span><button type="button" class="ncm-ph2-btn ncm-ph2-btn--bad" data-action="tabAct" data-owner="phone" data-op="purge"><i class="fas fa-broom"></i> Purge old…</button></div>
    <label class="ncm-ph2-srow"><span><b>Tell players you can read typed calls</b><small>A line under the type bar: what is typed on a call is kept in the call log and you can listen in.</small></span><input type="checkbox" class="ncm-ph2-check" data-ph-set="callTranscriptNotice"{{#if settings.notice}} checked{{/if}}></label>
  </section>
  <p class="ncm-ph2-hint"><i class="fas fa-circle-info"></i> Each player picks their own ring colours and silent mode in their Theme Customizer.</p>
{{/if}}
{{/if}}
</div>
{{/with}}
{{/if}}
