{{!-- Admin Panel — GM Dashboard --}}
{{!-- @file templates/admin-panel/admin-panel.hbs --}}
{{!-- @module night-city-messenger --}}
{{!--
  Structure:
    admin-panel.hbs         — Shell (tab bar only since 2026-10-27; header/HUD/footer removed)
    tab-overview.hbs        — Tab 1: Overview
    tab-messages.hbs        — Tab 2: Messages
    tab-contacts.hbs        — Tab 3: Contacts
    tab-networks.hbs        — Tab 4: Networks (War Room + Logs)
    tab-shards.hbs          — Tab 5: Data Shards
    tab-spam.hbs            — Tab 6: Spam Generator
    tab-tools.hbs           — Tab 7: Tools
--}}

{{#if isGM}}
<div class="ncm-admin-panel {{#if isPopout}}ncm-admin-panel--pop{{/if}}">

  {{#if isPopout}}
  {{!-- Popped-out single-tab window (AdminTabWindow): no panel chrome, one way back. --}}
  <div class="ncm-admin-popbar">
    <span class="ncm-admin-popbar__t"><i class="fas fa-up-right-from-square"></i> Popped out from the admin panel</span>
    <button type="button" class="ncm-admin-popbar__dock" data-action="dockTab"><i class="fas fa-down-left-and-up-right-to-center"></i> Back to the admin panel</button>
  </div>
  {{else}}

  {{!-- ═══ TAB NAVIGATION ═══ --}}
  {{!-- The GM Dashboard header, HUD strip and footer were removed 2026-10-27 (dev: they 'don't play a role in anything' and cost the tabs their room). Counts live on the tabs themselves. --}}
  {{!-- Grouped tab bar (2026-10-29, dev-picked "clustered tab bar", dev/mockups/admin-nav-groups-mock.html):
        ONE row, one click per tab, the tabs in labelled clusters. When the row runs out of room the labels
        fold (AdminPanelApp._wireTabFold): other groups' tabs first, then the rest of the open group — the open
        tab always keeps its label. A switch slides the labels to their new state instead of snapping. Every tab names itself on hover (data-tooltip). --}}
  <nav class="ncm-admin-tabs ncm-admin-tabs--grouped">
    <div class="ncm-admin-tabgrp" data-tab-group="home">
      <span class="ncm-admin-tabgrp__cap">&nbsp;</span>
      <div class="ncm-admin-tabgrp__tabs">
      <button class="ncm-admin-tab {{#if (eq activeTab 'overview')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="overview" data-tooltip="Overview · what is happening right now and what needs you" aria-label="Overview">
        <i class="fas fa-chart-bar"></i><span class="ncm-admin-tab__lb">Overview</span>
      </button>
      </div>
    </div>
    <div class="ncm-admin-tabgrp" data-tab-group="comms">
      <span class="ncm-admin-tabgrp__cap">Comms</span>
      <div class="ncm-admin-tabgrp__tabs">
      <button class="ncm-admin-tab {{#if (eq activeTab 'messages')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="messages" data-tooltip="Messages · the reply desk, all mail, the outbox and every inbox" aria-label="Messages">
        <i class="fas fa-envelope"></i><span class="ncm-admin-tab__lb">Messages</span>{{#if stats.unreadMessages}}<span class="ncm-admin-tab__count">{{stats.unreadMessages}}</span>{{/if}}
      </button>
      <button class="ncm-admin-tab {{#if (eq activeTab 'contacts')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="contacts" data-tooltip="Contacts · the NPC directory, players, groups and who knows whom" aria-label="Contacts">
        <i class="fas fa-address-book"></i><span class="ncm-admin-tab__lb">Contacts</span>
      </button>
      <button class="ncm-admin-tab {{#if (eq activeTab 'spam')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="spam" data-tooltip="Spam · junk-mail templates, blasts and auto-spam by network" aria-label="Spam">
        <i class="fas fa-envelopes-bulk"></i><span class="ncm-admin-tab__lb">Spam</span>
      </button>
      </div>
    </div>
    <div class="ncm-admin-tabgrp" data-tab-group="net">
      <span class="ncm-admin-tabgrp__cap">Net</span>
      <div class="ncm-admin-tabgrp__tabs">
      <button class="ncm-admin-tab {{#if (eq activeTab 'networks')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="networks" data-tooltip="Networks · what reaches each scene, every network, scenes and the activity log" aria-label="Networks">
        <i class="fas fa-network-wired"></i><span class="ncm-admin-tab__lb">Networks</span>
      </button>
      <button class="ncm-admin-tab {{#if (eq activeTab 'security')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="security" data-tooltip="Security · live traces, heat, planted programs and the hacking rules" aria-label="Security">
        <i class="fas fa-shield-halved"></i><span class="ncm-admin-tab__lb">Security</span>
      </button>
      </div>
    </div>
    <div class="ncm-admin-tabgrp" data-tab-group="world">
      <span class="ncm-admin-tabgrp__cap">World</span>
      <div class="ncm-admin-tabgrp__tabs">
      <button class="ncm-admin-tab {{#if (eq activeTab 'terminals')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="terminals" data-tooltip="Terminals · every computer players can log into" aria-label="Terminals">
        <i class="fas fa-terminal"></i><span class="ncm-admin-tab__lb">Terminals</span>
      </button>
      <button class="ncm-admin-tab {{#if (eq activeTab 'shards')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="shards" data-tooltip="Shards · every data shard and who holds it" aria-label="Shards">
        <i class="fas fa-database"></i><span class="ncm-admin-tab__lb">Shards</span>
      </button>
      <button class="ncm-admin-tab {{#if (eq activeTab 'access')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="access" data-tooltip="Access points · every way players can open a terminal or shard — map pins, hotbar, chat cards, journal links" aria-label="Access points">
        <i class="fas fa-location-crosshairs"></i><span class="ncm-admin-tab__lb">Access</span>
      </button>
      </div>
    </div>
    <div class="ncm-admin-tabgrp" data-tab-group="tools">
      <span class="ncm-admin-tabgrp__cap">&nbsp;</span>
      <div class="ncm-admin-tabgrp__tabs">
      <button class="ncm-admin-tab {{#if (eq activeTab 'tools')}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="tools" data-tooltip="Tools · settings, imports, health checks and clean-up" aria-label="Tools">
        <i class="fas fa-wrench"></i><span class="ncm-admin-tab__lb">Tools</span>
      </button>
      </div>
    </div>
    <span class="ncm-admin-tabs__keys" data-tooltip="Keys: 1–9 and 0 switch tabs (in the order shown) · / search · N new" aria-label="Keyboard shortcuts"><i class="fas fa-keyboard"></i></span>
  </nav>

  {{/if}}{{!-- /isPopout chrome --}}

  {{!-- ═══ TAB CONTENT ═══ --}}
  <div class="ncm-admin-content">

    {{> "modules/night-city-messenger/templates/admin-panel/tab-overview.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-messages.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-contacts.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-networks.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-shards.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-terminals.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-access.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-security.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-spam.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-tools.hbs"}}

  </div>{{!-- /ncm-admin-content --}}


</div>{{!-- /ncm-admin-panel --}}

{{else}}
<div class="ncm-admin-panel">
  <div class="ncm-admin-empty">
    <i class="fas fa-lock"></i>
    Access denied — GM clearance required.
  </div>
</div>
{{/if}}
