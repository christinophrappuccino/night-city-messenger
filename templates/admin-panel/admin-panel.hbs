{{!-- Admin Panel — GM Dashboard --}}
{{!-- @file templates/admin-panel/admin-panel.hbs --}}
{{!-- @module night-city-messenger --}}
{{!--
  Structure:
    admin-panel.hbs         — Shell (tab bar only since 2026-10-27; header/HUD/footer removed)
    tab-overview.hbs        — Tab 1: Overview
    tab-messages.hbs        — Tab 2: Messages
    tab-contacts.hbs        — Tab 3: Contacts
    tab-networks.hbs        — Tab 4: Networks (War Room + Logs)
    tab-shards.hbs          — Tab 5: Data Shards
    tab-spam.hbs            — Tab 6: Spam Generator
    tab-tools.hbs           — Tab 7: Tools
--}}

{{#if isGM}}
<div class="ncm-admin-panel {{#if isPopout}}ncm-admin-panel--pop{{/if}}">

  {{#if isPopout}}
  {{!-- Popped-out single-tab window (AdminTabWindow): no panel chrome, one way back. --}}
  <div class="ncm-admin-popbar">
    <span class="ncm-admin-popbar__t"><i class="fas fa-up-right-from-square"></i> Popped out from the admin panel</span>
    <button type="button" class="ncm-admin-popbar__dock" data-action="dockTab"><i class="fas fa-down-left-and-up-right-to-center"></i> Back to the admin panel</button>
  </div>
  {{else}}

  {{!-- ═══ TAB NAVIGATION ═══ --}}
  {{!-- The GM Dashboard header, HUD strip and footer were removed 2026-10-27 (dev: they 'don't play a role in anything' and cost the tabs their room). Counts live on the tabs themselves. --}}
  {{!-- Grouped tab bar (2026-10-29, dev-picked "clustered tab bar", dev/mockups/admin-nav-groups-mock.html):
        ONE row, one click per tab, the tabs in labelled clusters. When the row runs out of room the labels
        fold (AdminPanelApp._wireTabFold): other groups' tabs first, then the rest of the open group — the open
        tab always keeps its label. A switch slides the labels to their new state instead of snapping. Every tab names itself on hover (data-tooltip). --}}
  <nav class="ncm-admin-tabs ncm-admin-tabs--grouped">
    {{!-- the buttons come from AdminPanelApp.TAB_GROUPS (tabNav) --}}
    {{#each tabNav}}
    <div class="ncm-admin-tabgrp" data-tab-group="{{this.key}}">
      <span class="ncm-admin-tabgrp__cap">{{#if this.cap}}{{this.cap}}{{else}}&nbsp;{{/if}}</span>
      <div class="ncm-admin-tabgrp__tabs">
      {{#each this.tabs}}
      <button class="ncm-admin-tab {{#if this.active}}ncm-admin-tab--active{{/if}}" data-action="switchTab" data-tab="{{this.key}}" data-tooltip="{{ncm-tip this.tip}}" aria-label="{{this.aria}}">
        <i class="fas {{this.icon}}"></i><span class="ncm-admin-tab__lb">{{this.label}}</span>{{#if this.count}}<span class="ncm-admin-tab__count{{#if this.hot}} ncm-admin-tab__count--hot{{/if}}">{{this.count}}</span>{{/if}}
      </button>
      {{/each}}
      </div>
    </div>
    {{/each}}
    <span class="ncm-admin-tabs__keys" data-tooltip="{{ncm-tip tabKeysTip}}" aria-label="Keyboard shortcuts"><i class="fas fa-keyboard"></i></span>
  </nav>

  {{/if}}{{!-- /isPopout chrome --}}

  {{!-- ═══ TAB CONTENT ═══ --}}
  <div class="ncm-admin-content">

    {{> "modules/night-city-messenger/templates/admin-panel/tab-overview.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-messages.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-contacts.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-networks.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-shards.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-terminals.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-access.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-phone.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-security.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-spam.hbs"}}

    {{> "modules/night-city-messenger/templates/admin-panel/tab-tools.hbs"}}

  </div>{{!-- /ncm-admin-content --}}


</div>{{!-- /ncm-admin-panel --}}

{{else}}
<div class="ncm-admin-panel">
  <div class="ncm-admin-empty">
    <i class="fas fa-lock"></i>
    Access denied — GM clearance required.
  </div>
</div>
{{/if}}
