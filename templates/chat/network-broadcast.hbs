{{!-- Chat Card: Network Notice (GM broadcast — the Esper readout) --}}
<div class="ncm-cc">
  <div class="ncm-cc__rec">
    <span class="ncm-cc__kind">Network notice</span>
    <span class="ncm-cc__time">{{when}}</span>
    <span class="ncm-cc__sub"><span>{{networkName}}</span></span>
  </div>
  <div class="ncm-cc__hero"><i class="ncm-cc__tr"></i><i class="ncm-cc__bl"></i>
    <div class="ncm-cc__text" style="margin:0;font-size:14px">{{message}}</div>
  </div>
</div>
