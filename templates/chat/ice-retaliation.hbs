{{!-- Chat Card: BLACK ICE Retaliation (the Esper readout) --}}
<div class="ncm-cc ncm-cc--ice">
  <div class="ncm-cc__rec">
    <span class="ncm-cc__kind">Black ICE</span>
    <span class="ncm-cc__time">{{when}}</span>
    <span class="ncm-cc__sub"><span>{{contextLabel}}</span><span>{{networkDisplay}}</span></span>
  </div>
  <div class="ncm-cc__ice">
    {{#if iceImg}}<img src="{{iceImg}}" alt="">{{else}}<span class="ncm-cc__iceimg"><i class="fas fa-skull"></i></span>{{/if}}
    <div><div class="ncm-cc__n">{{iceName}}</div><div class="ncm-cc__cls">{{iceClassDisplay}}</div></div>
  </div>
  <div class="ncm-cc__hero"><i class="ncm-cc__tr"></i><i class="ncm-cc__bl"></i>
    <div class="ncm-cc__numrow">
      <div class="ncm-cc__num">{{damage}}</div>
      <div class="ncm-cc__verdict">damage to {{actorName}}<span>{{rollLine}}</span></div>
    </div>
  </div>
  <div class="ncm-cc__ro">
    <div><div class="ncm-cc__k">HP before</div><div class="ncm-cc__v">{{hpBefore}}</div></div>
    <div><div class="ncm-cc__k">HP after</div><div class="ncm-cc__v ncm-cc__v--c">{{hpAfter}}</div></div>
  </div>
</div>
