{{!-- Chat Card: Skill Check / Hack Result (the Esper readout) --}}
<div class="ncm-cc {{#if success}}ncm-cc--ok{{else}}ncm-cc--fail{{/if}}">
  <div class="ncm-cc__rec">
    <span class="ncm-cc__kind">Skill check</span>
    <span class="ncm-cc__time">{{when}}</span>
    <span class="ncm-cc__sub"><span>{{actorName}}</span><span>{{networkDisplay}}</span></span>
  </div>
  <div class="ncm-cc__hero"><i class="ncm-cc__tr"></i><i class="ncm-cc__bl"></i>
    <div class="ncm-cc__numrow">
      <div class="ncm-cc__num">{{total}}<small>/ {{dc}}</small></div>
      <div class="ncm-cc__verdict">{{#if success}}Passed{{else}}Failed{{/if}} by {{marginAbs}}<span>{{skillName}}{{#if contextLine}}, {{contextLine}}{{/if}}</span></div>
    </div>
  </div>
  <div class="ncm-cc__ro">
    <div><div class="ncm-cc__k">{{statName}}</div><div class="ncm-cc__v">{{statValue}}</div></div>
    <div><div class="ncm-cc__k">{{skillName}}</div><div class="ncm-cc__v">{{skillLevel}}</div></div>
    <div><div class="ncm-cc__k">1d10</div><div class="ncm-cc__v ncm-cc__v--c">{{rollValue}}{{#if rollChanged}} <small>→ {{processedRoll}}</small>{{/if}}</div></div>
    {{#if luckSpent}}<div><div class="ncm-cc__k">Luck</div><div class="ncm-cc__v">+{{luckSpent}}</div></div>{{/if}}
  </div>
  {{#if isCritical}}<div class="ncm-cc__flag">critical, exploding 10</div>{{/if}}
  {{#if isFumble}}<div class="ncm-cc__flag">fumble, subtractive 1</div>{{/if}}
</div>
