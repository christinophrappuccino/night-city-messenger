{{!--
  Network Selector — Player Dropdown Popup
  @file templates/message-viewer/partials/network-selector.hbs
  @module night-city-messenger
  @description Compact popup for switching networks from the inbox header.
    Mockup reference: ncm-network-dialogs-mockup.html — Section 2.

    Three states:
      A) Normal — lists only reachable networks (active / available / locked)
      B) No networks in range — empty state (scene has none reachable)
      C) Dead zone — empty state with queued message count

    Data contract — supplied by MessageViewerApp._prepareContext():
      selectorDead         boolean — a dead-zone scene (a node-made one still lists the networks, as jammed rows)
      selectorNetworks     [{ id, name, type, typeLabel, icon, color,
                              signalStrength, state: 'active'|'available'|'locked'|'jammed',
                              blockLabel (jammed: "Jammed · 18m" / "Node down" — a network node cuts it here),
                              requiresAuth, isAuthenticated }]
      currentNetwork       { id, name }
      signalStrength       number (0-100)
      queuedMessageCount   number
      currentSceneName     string
      availableCount       number
--}}

<div class="ncm-net-selector {{#if selectorDead}}ncm-net-selector--deadzone{{/if}}">

  {{!-- ── Accent stripe at top (CSS handles color) ── --}}

  {{!-- ── Header ── --}}
  <div class="ncm-net-selector__header {{#if selectorDead}}ncm-net-selector__header--deadzone{{/if}}">
    {{#if selectorDead}}
      <span class="ncm-net-selector__header-label ncm-net-selector__header-label--danger">No Signal</span>
    {{else}}
      <span class="ncm-net-selector__header-label">Available Networks</span>
    {{/if}}
    <div class="ncm-net-selector__signal">
      <div class="ncm-net-selector__signal-bar {{#if (gte signalStrength 20)}}ncm-net-selector__signal-bar--active{{/if}} {{#if selectorDead}}ncm-net-selector__signal-bar--dead{{/if}}" style="height:3px"></div>
      <div class="ncm-net-selector__signal-bar {{#if (gte signalStrength 40)}}ncm-net-selector__signal-bar--active{{/if}}" style="height:6px"></div>
      <div class="ncm-net-selector__signal-bar {{#if (gte signalStrength 60)}}ncm-net-selector__signal-bar--active{{/if}}" style="height:9px"></div>
      <div class="ncm-net-selector__signal-bar {{#if (gte signalStrength 80)}}ncm-net-selector__signal-bar--active{{/if}}" style="height:12px"></div>
    </div>
  </div>

  {{!-- ── Dead Zone Empty State ── --}}
  {{#if selectorDead}}
    <div class="ncm-net-selector__deadzone-body">
      <div class="ncm-net-selector__deadzone-icon"><i class="fas fa-ban"></i></div>
      <div class="ncm-net-selector__deadzone-title">Dead Zone</div>
      <div class="ncm-net-selector__deadzone-msg">All signals jammed in this area.</div>
      {{#if queuedMessageCount}}
        <div class="ncm-net-selector__deadzone-queue">
          <i class="fas fa-clock"></i> {{queuedMessageCount}} message{{#if (gt queuedMessageCount 1)}}s{{/if}} queued for delivery
        </div>
      {{/if}}
    </div>

  {{else if selectorNetworks.length}}
    {{!-- ── Network List ── --}}
    <div class="ncm-net-selector__list">
      {{#each selectorNetworks}}
        <div class="ncm-net-option ncm-net-option--{{this.state}}"
             data-action="selectNetwork"
             data-network-id="{{this.id}}"
             style="--net-c: {{this.color}};"
             title="{{this.name}} — {{this.typeLabel}}">

          {{!-- Left color accent (network color) handled by CSS via --net-c --}}

          {{!-- Icon Badge --}}
          <div class="ncm-net-option__icon"
               style="background: {{this.color}}14; color: {{this.color}}; border: 1px solid {{this.color}}26;">
            {{{ncm-net-icon this.theme}}}
          </div>

          {{!-- Info --}}
          <div class="ncm-net-option__info">
            <div class="ncm-net-option__name">{{this.name}}</div>
            <div class="ncm-net-option__type">
              {{this.typeLabel}} · {{this.signalStrength}}%
            </div>
          </div>

          {{!-- Right column: status chip + signal bars --}}
          <div class="ncm-net-option__right">
            {{#if (eq this.state 'active')}}
              <span class="ncm-net-option__chip ncm-net-option__chip--on">Connected</span>
            {{else if (eq this.state 'jammed')}}
              <span class="ncm-net-option__chip ncm-net-option__chip--jammed"><i class="fas {{this.blockIcon}}"></i> {{this.blockLabel}}</span>
            {{else if (eq this.state 'locked')}}
              <span class="ncm-net-option__chip ncm-net-option__chip--locked"><i class="fas fa-lock"></i> Locked</span>
            {{else}}
              <span class="ncm-net-option__chip ncm-net-option__chip--go">Connect</span>
            {{/if}}
            <div class="ncm-net-option__sig">
              <span class="ncm-net-option__sig-bar {{#if (gt this.signalStrength 0)}}ncm-net-option__sig-bar--on{{/if}}" style="height:4px"></span>
              <span class="ncm-net-option__sig-bar {{#if (gte this.signalStrength 25)}}ncm-net-option__sig-bar--on{{/if}}" style="height:6px"></span>
              <span class="ncm-net-option__sig-bar {{#if (gte this.signalStrength 50)}}ncm-net-option__sig-bar--on{{/if}}" style="height:8px"></span>
              <span class="ncm-net-option__sig-bar {{#if (gte this.signalStrength 80)}}ncm-net-option__sig-bar--on{{/if}}" style="height:11px"></span>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    {{!-- ── No reachable networks (in range = none; not jammed) ── --}}
    <div class="ncm-net-selector__deadzone-body">
      <div class="ncm-net-selector__deadzone-icon"><i class="fas fa-wifi"></i></div>
      <div class="ncm-net-selector__deadzone-title">No Networks in Range</div>
      <div class="ncm-net-selector__deadzone-msg">No reachable networks at this location.</div>
    </div>
  {{/if}}

  {{!-- ── Footer: Scene Context ── --}}
  <div class="ncm-net-selector__footer {{#if selectorDead}}ncm-net-selector__footer--deadzone{{/if}}">
    <i class="fas fa-map-marker-alt {{#if selectorDead}}ncm-net-selector__footer-icon--danger{{/if}}"></i>
    {{#if selectorDead}}
      <span class="ncm-net-selector__footer-text--danger">{{currentSceneName}} — DEAD ZONE</span>
    {{else}}
      {{currentSceneName}} — {{availableCount}} network{{#unless (eq availableCount 1)}}s{{/unless}} available
    {{/if}}
  </div>

</div>
